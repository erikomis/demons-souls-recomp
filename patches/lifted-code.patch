+            ctx->gpr[3] = out; ctx->gpr[4] = chr;
+            ctx->ctr = vm_read32(d); ctx->gpr[2] = vm_read32(d + 4);
+            ctx->lr = 0x0001B8D0; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);
+            for (int i = 0; i < 3; i++) { const uint32_t w = vm_read32(out + 4 * i); memcpy(&xyz[i], &w, 4); }
+            ok = 1;
+        }
