+/* Where the player is (PORT DEBUG, NOTES fix 57): the lookups the event scripts' bindings use.
+ * The character: func_004142A8(obj, 10000) as in god mode; the map (area << 8 | block): the lookup
+ * lua_GetBlockId's func_00419610 makes -- X = *(TOC[-0x788C] - 0x7E70), func_0033BBB8(out, X[+4],
+ * X[+0x30]) writes the map id bytes (area, block, ..) at out; the position: lua_SaveChrPos's virtual call chr->vtable[+0x70](out, chr),
+ * which writes x, y, z (big-endian floats) to out. Calls run on a frame below the live stack with
+ * the context saved and restored. Returns 0 when there is no player (title, loading). */
+static int des_player_where(ppu_context* ctx, uint32_t* chr_out, int* block, float xyz[3])
+{
+    PPU_MM_SNAP
+    const uint32_t toc = vm_read32((uint32_t)ctx->gpr[2] - 0x7884);
+    const uint32_t pp = toc ? vm_read32(toc - 0x7F0C) : 0;
+    const uint32_t obj = pp ? vm_read32(pp) : 0;
+    if (!obj) return 0;
+    ppu_context save = *ctx;
+    ctx->gpr[1] = (save.gpr[1] - 0x400) & ~0xFull;
+    const uint32_t out = (uint32_t)ctx->gpr[1] + 0x200;   /* between the callees' frames and ours */
+    ctx->gpr[3] = obj; ctx->gpr[4] = 10000; ctx->gpr[5] = 0; ctx->gpr[6] = 0;
+    ctx->lr = 0x0001B8D0; func_004142A8(ctx); DRAIN_TRAMPOLINE(ctx);
+    const uint32_t chr = (uint32_t)ctx->gpr[3];
+    int ok = 0;
+    if (chr) {
+        *block = -1;
+        const uint32_t t2 = vm_read32((uint32_t)save.gpr[2] - 0x788C);
+        const uint32_t xp = t2 ? vm_read32(t2 - 0x7E70) : 0, x = xp ? vm_read32(xp) : 0;
