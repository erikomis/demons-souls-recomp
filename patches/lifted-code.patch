+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("DES_CUT_BLEND");
+        on = !(e && e[0] == '0');
+        const char* l = getenv("DES_CUT_LOG");
+        des_cut_log = l && l[0] == '1';
+        fprintf(stderr, "[des] cutscene camera: %s\n", on ? "keys blended (DES_CUT_BLEND=0: nearest key)" :
+                "nearest key (DES_CUT_BLEND=0)");
