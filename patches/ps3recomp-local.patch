+            var6 = ef_r16(q + 0x32 + 2u * (u32)var11);        /* m_hs1[var11]: waiting task */
+        }
+        ef_w16(q + 0x08, (u16)var3);                           /* push3.m_h5 */
+        ef_w16(q + 0x0A, (u16)var5);                           /* push3.m_h6 */
+        { static int dbg = -1; if (dbg < 0) dbg = getenv("LFQ_DBG") ? 1 : 0;
