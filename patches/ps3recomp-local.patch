+ * lock-line lock, which is what the SPU's GETLLAR/PUTLLC on this line
+ * serialise against. Offsets (big-endian):
+ *   +0x00 pop1 {h1,h2,h3,h4}  +0x08 push1 {h5,h6,h7,h8} (push3 = {h5,h6})
+ *   +0x10 size  +0x14 depth  +0x18 buffer (u64)  +0x24 direction
+ *   +0x30 push2.pack  +0x32 m_hs1[15]  +0x70 eaSignal (u64) */
+static inline u32 lfq_r32(uint32_t a) { const uint8_t* p = vm_base + a; return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
