-{
-    D3D12_CPU_DESCRIPTOR_HANDLE h;
-    g.smp_cpu_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.smp_cpu_heap, &h);
-    h.ptr += (size_t)slot * g.smp_step;
