+/* ---- Taskset shutdown ------------------------------------------------------
+ * cellSpursShutdownTaskset used to be a no-op, so a taskset's tasks outlived it:
+ * each one keeps a host thread running its lifted loop, and when the title frees
+ * the taskset and reuses the memory -- Demon's Souls recycles a destroyed Edge
+ * zlib taskset as its file read buffer -- those zombies keep writing taskset
+ * bookkeeping into whatever lives there now (single 0x03 bytes in compressed
+ * data, one inflate in a few hundred failing, the loader waiting forever).
+ *
+ * A shut-down taskset's tasks are stopped at their next lock-line atomic (every
+ * SPURS task loop polls one) by halting back to spu_run_with_halt, and released
+ * from WAIT_SIGNAL so they reach one. Creating a taskset at the same address
+ * clears the mark. g_spu_cur_taskset is the taskset of the task on this thread. */
+SPU_THREAD_LOCAL uint32_t g_spu_cur_taskset = 0;
+volatile int g_spu_tasksets_down = 0;           /* count, for the cheap fast path */
