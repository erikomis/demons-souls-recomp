+/* ---------------------------------------------------------------------------
+ * device / resource setup
+ * -----------------------------------------------------------------------*/
+static int make_root_signature(void)
+{
+    D3D12_DESCRIPTOR_RANGE xrange = {0};
+    xrange.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    xrange.NumDescriptors = SRV_TABLE_SIZE;
+    D3D12_DESCRIPTOR_RANGE srange = {0};
+    srange.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER;
+    srange.NumDescriptors = SMP_TABLE_SIZE;
+    D3D12_DESCRIPTOR_RANGE vrange = {0};
+    vrange.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    vrange.NumDescriptors = RSX_DSP_NUM_VERTEX_TEXTURES;
+    vrange.BaseShaderRegister = 16;
+    D3D12_ROOT_PARAMETER xp[5] = {0};
+    xp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    xp[0].Descriptor.ShaderRegister = 0;
+    xp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    xp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    xp[1].DescriptorTable.NumDescriptorRanges = 1;
+    xp[1].DescriptorTable.pDescriptorRanges = &xrange;
+    xp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    xp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    xp[2].DescriptorTable.NumDescriptorRanges = 1;
+    xp[2].DescriptorTable.pDescriptorRanges = &srange;
+    xp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    xp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    xp[3].DescriptorTable.NumDescriptorRanges = 1;
+    xp[3].DescriptorTable.pDescriptorRanges = &vrange;
+    xp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    xp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    xp[4].Descriptor.ShaderRegister = 1;
+    xp[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC vsmp[RSX_DSP_NUM_VERTEX_TEXTURES] = {0};
+    for (u32 i = 0; i < RSX_DSP_NUM_VERTEX_TEXTURES; i++) {
+        vsmp[i].Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;
+        vsmp[i].AddressU = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        vsmp[i].AddressV = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        vsmp[i].AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        vsmp[i].MaxLOD = D3D12_FLOAT32_MAX;
+        vsmp[i].ShaderRegister = i;
+        vsmp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    }
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+    rsd.NumParameters = 5; rsd.pParameters = xp;
+    rsd.NumStaticSamplers = RSX_DSP_NUM_VERTEX_TEXTURES;
+    rsd.pStaticSamplers = vsmp;
+    rsd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err))) {
+        if (err) err->lpVtbl->Release(err); return -1;
+    }
+    HRESULT hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                    sig->lpVtbl->GetBufferSize(sig),
+                                                    &IID_ID3D12RootSignature, (void**)&g.rootsig_x);
+    sig->lpVtbl->Release(sig);
+    return SUCCEEDED(hr) ? 0 : -1;
+}
+
+static int make_depth_snapshot_pipeline(void)
+{
+    static const char source[] =
+        "Texture2D<float> depth_source : register(t0);\n"
+        "RWTexture2D<float> depth_destination : register(u0);\n"
+        "[numthreads(8, 8, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "    uint width, height;\n"
+        "    depth_destination.GetDimensions(width, height);\n"
+        "    if (id.x < width && id.y < height)\n"
+        "        depth_destination[id.xy] = "
+        "depth_source.Load(int3(id.xy, 0));\n"
+        "}\n";
+    ID3DBlob* shader = NULL;
+    ID3DBlob* errors = NULL;
+    HRESULT hr = D3DCompile(
+        source, sizeof(source) - 1u, "depth_snapshot_compute", NULL, NULL,
+        "main", "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+        &shader, &errors);
+    if (FAILED(hr)) {
+        fprintf(stderr,
+                "[zetatrack] depth snapshot shader compile failed "
+                "hr=0x%08lX: %s\n",
+                (unsigned long)hr,
+                errors ? (const char*)errors->lpVtbl->GetBufferPointer(errors)
+                       : "<no diagnostics>");
+        if (errors) errors->lpVtbl->Release(errors);
+        return -1;
+    }
+    if (errors) errors->lpVtbl->Release(errors);
+
+    D3D12_DESCRIPTOR_RANGE ranges[2] = {0};
+    ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    ranges[0].NumDescriptors = 1;
+    ranges[0].BaseShaderRegister = 0;
+    ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    ranges[1].NumDescriptors = 1;
+    ranges[1].BaseShaderRegister = 0;
+    D3D12_ROOT_PARAMETER parameters[2] = {0};
+    for (u32 i = 0; i < 2; ++i) {
+        parameters[i].ParameterType =
+            D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        parameters[i].DescriptorTable.NumDescriptorRanges = 1;
+        parameters[i].DescriptorTable.pDescriptorRanges = &ranges[i];
+        parameters[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    }
+    D3D12_ROOT_SIGNATURE_DESC description = {0};
+    description.NumParameters = 2;
+    description.pParameters = parameters;
+    ID3DBlob* serialized = NULL;
+    ID3DBlob* signature_errors = NULL;
+    hr = D3D12SerializeRootSignature(
+        &description, D3D_ROOT_SIGNATURE_VERSION_1,
+        &serialized, &signature_errors);
+    if (FAILED(hr)) {
+        fprintf(stderr,
+                "[zetatrack] depth snapshot root signature failed "
+                "hr=0x%08lX: %s\n",
+                (unsigned long)hr,
+                signature_errors
+                    ? (const char*)signature_errors->lpVtbl->GetBufferPointer(
+                          signature_errors)
+                    : "<no diagnostics>");
+        if (signature_errors)
+            signature_errors->lpVtbl->Release(signature_errors);
+        shader->lpVtbl->Release(shader);
+        return -1;
+    }
+    if (signature_errors)
+        signature_errors->lpVtbl->Release(signature_errors);
+    hr = g.dev->lpVtbl->CreateRootSignature(
+        g.dev, 0, serialized->lpVtbl->GetBufferPointer(serialized),
+        serialized->lpVtbl->GetBufferSize(serialized),
+        &IID_ID3D12RootSignature, (void**)&g.depth_snapshot_rootsig);
+    serialized->lpVtbl->Release(serialized);
+    if (FAILED(hr)) {
+        shader->lpVtbl->Release(shader);
+        return -1;
+    }
+
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pipeline = {0};
+    pipeline.pRootSignature = g.depth_snapshot_rootsig;
+    pipeline.CS.pShaderBytecode = shader->lpVtbl->GetBufferPointer(shader);
+    pipeline.CS.BytecodeLength = shader->lpVtbl->GetBufferSize(shader);
+    hr = g.dev->lpVtbl->CreateComputePipelineState(
+        g.dev, &pipeline, &IID_ID3D12PipelineState,
+        (void**)&g.depth_snapshot_pso);
+    shader->lpVtbl->Release(shader);
+    if (FAILED(hr)) return -1;
+
+    /* zdepth_argb: the snapshot as RSX D24S8 bytes (A = bits 23-16, R = 15-8, G = 7-0). */
+    static const char argb_source[] =
+        "Texture2D<float> depth_source : register(t0);\n"
+        "RWTexture2D<unorm float4> depth_argb : register(u0);\n"
+        "[numthreads(8, 8, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "    uint width, height;\n"
+        "    depth_argb.GetDimensions(width, height);\n"
+        "    if (id.x >= width || id.y >= height) return;\n"
+        "    uint d = (uint)(saturate(depth_source.Load(int3(id.xy, 0))) * 16777215.0 + 0.5);\n"
+        "    depth_argb[id.xy] = float4((float)((d >> 8) & 255u), (float)(d & 255u), 0.0,\n"
+        "                               (float)(d >> 16)) / 255.0;\n"
+        "}\n";
+    { const char* e = getenv("LD_DEPTH_AS_COLOR"); if (e && e[0] == '0') return 0; }
+    ID3DBlob* argb_cs = NULL;
+    errors = NULL;
+    hr = D3DCompile(argb_source, sizeof(argb_source) - 1u, "depth_argb_compute", NULL, NULL,
+                    "main", "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &argb_cs, &errors);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[zetatrack] depth-as-colour shader compile failed: %s\n",
+                errors ? (const char*)errors->lpVtbl->GetBufferPointer(errors) : "<no diagnostics>");
+        if (errors) errors->lpVtbl->Release(errors);
+        return 0;   /* optional: colour reads of a zeta keep the old path */
+    }
+    if (errors) errors->lpVtbl->Release(errors);
+    pipeline.CS.pShaderBytecode = argb_cs->lpVtbl->GetBufferPointer(argb_cs);
+    pipeline.CS.BytecodeLength = argb_cs->lpVtbl->GetBufferSize(argb_cs);
+    if (FAILED(g.dev->lpVtbl->CreateComputePipelineState(g.dev, &pipeline, &IID_ID3D12PipelineState,
+                                                         (void**)&g.depth_argb_pso)))
+        g.depth_argb_pso = NULL;
+    argb_cs->lpVtbl->Release(argb_cs);
+    return 0;
+}
+
+/* Display vblank source (Demon's Souls NOTES fix 53). The guest vblank clock (boot_main's ticker)
+ * ran on its own QPC timer: 100.000 Hz against a monitor at 99.99 Hz. The two drift past each other,
+ * and each time the frame hand-over lands on a display refresh boundary the frames come out 3 / 1
+ * refreshes for a second or two instead of an even 2 / 2 -- short judder bursts with every frame on
+ * time. This thread waits for the window's real vblanks (IDXGIOutput::WaitForVBlank) and keeps a
+ * least-squares fit of their times (period + phase) over the last 256; the ticker places its ticks
+ * on that grid when its own rate is a whole multiple of the display's. LD_VBLANK_LOCK=0 = off. */
+#define LDVB_N 256
+static struct {
+    SRWLOCK lock;
+    double t[LDVB_N]; long long k[LDVB_N]; int n, head;   /* samples: QPC us, refresh index */
+    double base_us, period_us; int valid;                  /* fitted grid: a vblank at base, every period */
+    long long idx; double last_t;
+} g_ldvb;
+
+static double ldvb_now_us(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1e6 / (double)f.QuadPart;
+}
+
+static void ldvb_fit(void)
+{
+    /* two passes: fit, drop samples more than 1 ms off the line (late wake-ups), fit again */
+    double sk = 0, st = 0, skk = 0, skt = 0, a = 0, b = 0; int m = 0;
+    for (int pass = 0; pass < 2; pass++) {
+        sk = st = skk = skt = 0; m = 0;
+        const double k0 = (double)g_ldvb.k[(g_ldvb.head - g_ldvb.n + LDVB_N) % LDVB_N];
+        for (int i = 0; i < g_ldvb.n; i++) {
+            const int j = (g_ldvb.head - g_ldvb.n + i + LDVB_N) % LDVB_N;
+            const double k = (double)g_ldvb.k[j] - k0, t = g_ldvb.t[j];
+            if (pass && fabs(t - (a + b * k)) > 1000.0) continue;
+            sk += k; st += t; skk += k * k; skt += k * t; m++;
+        }
+        const double d = m * skk - sk * sk;
+        if (m < 32 || d <= 0) return;
+        b = (m * skt - sk * st) / d; a = (st - b * sk) / m;
+        if (!pass) continue;
+        const double kn = (double)g_ldvb.k[(g_ldvb.head - 1 + LDVB_N) % LDVB_N] - k0;
+        AcquireSRWLockExclusive(&g_ldvb.lock);
+        g_ldvb.period_us = b; g_ldvb.base_us = a + b * kn;   /* the grid point of the newest sample */
+        g_ldvb.valid = b > 2000.0 && b < 50000.0;
+        ReleaseSRWLockExclusive(&g_ldvb.lock);
+    }
+}
+
+static DWORD WINAPI ldvb_thread(LPVOID unused)
+{
+    (void)unused;
+    IDXGIOutput* out = NULL;
+    double next_query = 0;
+    for (;;) {
+        const double now = ldvb_now_us();
+        if (!out || now >= next_query) {           /* the window may move to another monitor */
+            if (out) { out->lpVtbl->Release(out); out = NULL; }
+            if (FAILED(g.swap->lpVtbl->GetContainingOutput(g.swap, &out))) { out = NULL; Sleep(100); continue; }
+            next_query = now + 5e6;
+        }
+        if (FAILED(out->lpVtbl->WaitForVBlank(out))) { out->lpVtbl->Release(out); out = NULL; Sleep(10); continue; }
+        const double t = ldvb_now_us();
+        if (g_ldvb.n && g_ldvb.period_us > 0) {     /* whole refreshes since the last sample (missed waits) */
+            long long steps = (long long)floor((t - g_ldvb.last_t) / g_ldvb.period_us + 0.5);
+            if (steps < 1) steps = 1;
+            if (steps > 100000) { g_ldvb.n = 0; steps = 1; }   /* long stall / monitor change: start over */
+            g_ldvb.idx += steps;
+        } else g_ldvb.idx++;
+        g_ldvb.last_t = t;
+        g_ldvb.t[g_ldvb.head] = t; g_ldvb.k[g_ldvb.head] = g_ldvb.idx;
+        g_ldvb.head = (g_ldvb.head + 1) % LDVB_N;
+        if (g_ldvb.n < LDVB_N) g_ldvb.n++;
+        if (g_ldvb.period_us <= 0 && g_ldvb.n >= 8) {   /* first estimate before the fit has samples */
+            const int j0 = (g_ldvb.head - g_ldvb.n + LDVB_N) % LDVB_N;
+            g_ldvb.period_us = (t - g_ldvb.t[j0]) / (double)(g_ldvb.idx - g_ldvb.k[j0]);
+        }
+        if (g_ldvb.n >= 32 && (g_ldvb.idx % 16) == 0) ldvb_fit();
+    }
+}
+
+/* The fitted display grid: a recent vblank time (QPC us) and the refresh period. 0 until locked. */
+int rsx_live_draw_display_vblank(unsigned long long* vb_us, double* period_us)
+{
+    AcquireSRWLockShared(&g_ldvb.lock);
+    const int ok = g_ldvb.valid;
+    if (ok) {
+        if (vb_us) *vb_us = (unsigned long long)g_ldvb.base_us;
+        if (period_us) *period_us = g_ldvb.period_us;
+    }
+    ReleaseSRWLockShared(&g_ldvb.lock);
+    return ok;
+}
+
+static void ldvb_start(void)
+{
+    const char* e = getenv("LD_VBLANK_LOCK");
+    if (e && e[0] == '0') return;
+    InitializeSRWLock(&g_ldvb.lock);
+    HANDLE th = CreateThread(NULL, 0, ldvb_thread, NULL, 0, NULL);
+    if (th) { SetThreadPriority(th, THREAD_PRIORITY_TIME_CRITICAL); CloseHandle(th); }
+    fprintf(stderr, "[vblank-lock] display vblank source %s\n", th ? "started" : "FAILED");
+}
+
+int rsx_live_draw_init(void* hwnd, u32 width, u32 height,
+                       rsx_live_guest_ptr_fn guest_fn, void* guest_user)
+{
+    if (!rsx_live_draw_enabled()) return 0;
+    if (g.ready) return 0;
+    ld_present_measure_init();
+#if defined(YZ_PERF_PROFILE)
+    memset(&g_ld_profile, 0, sizeof(g_ld_profile));
+    {
+        LARGE_INTEGER frequency;
+        QueryPerformanceFrequency(&frequency);
+        g_ld_profile.qpc_frequency = frequency.QuadPart;
+        g_ld_profile.previous_present_qpc = ld_profile_qpc();
+    }
+#endif
+    g.width = width; g.height = height;
+    g.guest_ptr = guest_fn; g.guest_user = guest_user;
+    {
+        const char* requested = getenv("RSX_FP_CONSTANT_MODE");
+        char mode = 'B';
+        if (requested && requested[0]) {
+            if ((requested[0] == 'L' || requested[0] == 'l') &&
+                (!requested[1] ||
+                 _stricmp(requested, "literal") == 0))
+                mode = 'L';
+            else if ((requested[0] == 'B' || requested[0] == 'b') &&
+                     (!requested[1] ||
+                      _stricmp(requested, "buffered") == 0))
+                mode = 'B';
+            else
