+/* Channel fast path for lifted code (SPU_USE_DISPATCH_MT is set only on the
+ * port's lifted sources; SPU_NO_CHANNEL_FAST turns it off). Setting up a DMA
+ * is five or six channel writes that only store a field -- LSA, EAH, EAL,
+ * size, tag, tag mask -- and the reads of the tag and atomic status only load
+ * one. Through spu_wrch / spu_rdch each paid an out-of-line call, the
+ * debug-switch checks and the MFC engine lookup: about a third of Demon's
+ * Souls' SPU command dispatcher, the stage that limits Boletarian Palace's
+ * frame rate (NOTES fix 34). The lifted code passes the channel as a
+ * constant, so this folds to a single store or load; every other channel, and
+ * a pending external stop, still goes through the real functions. Must stay
+ * after the generated spu_recomp.h, which declares them. */
+#if defined(SPU_USE_DISPATCH_MT) && !defined(SPU_NO_CHANNEL_FAST)
+static inline void spu_wrch_fast_(spu_context* ctx, uint32_t channel, u128 value)
+{
+    const uint32_t v = value._u32[0];
+    switch (channel) {
+    case MFC_LSA:       ctx->mfc_lsa = v; return;
+    case MFC_EAH:       ctx->mfc_eah = v; return;
+    case MFC_EAL:       ctx->mfc_eal = v; return;
+    case MFC_Size:      ctx->mfc_size = v; return;
+    case MFC_TagID:     ctx->mfc_tag = v & 0x1F; return;
+    case MFC_WrTagMask: ctx->mfc_tag_mask = v; return;
+    default:            spu_wrch(ctx, channel, value); return;
+    }
+}
+static inline u128 spu_rdch_fast_(spu_context* ctx, uint32_t channel)
+{
+    if (!ctx->stop_request) {
+        if (channel == MFC_RdTagStat)    return spu_make_preferred_u32(ctx->mfc_tag_status);
+        if (channel == MFC_RdAtomicStat) return spu_make_preferred_u32(ctx->atomic_stat);
+    }
+    return spu_rdch(ctx, channel);
+}
+#define spu_wrch(c, ch, v) spu_wrch_fast_((c), (ch), (v))
+#define spu_rdch(c, ch)    spu_rdch_fast_((c), (ch))
+#endif
