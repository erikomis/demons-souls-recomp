+        yz_frontier_trace_emit(
+            YZ_FT_PARITY_GUEST_BLIT, i, location,
+            surface->last_guest_blit_generation, offset, value,
+            g_ld_fifo_get, g_ld_fifo_put, surface->last_write_generation);
+    }
+#endif
