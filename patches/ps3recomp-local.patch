-{
-    for (u32 i = 0; i < g.n_samplers; i++)
-        if (g.smp_keys[i] == key) return 1 + i;
-    if (g.n_samplers >= SMP_CACHE_SLOTS) return SMP_DEFAULT;
-    D3D12_SAMPLER_DESC sd = decode_sampler(t);
-    const u32 slot = 1 + g.n_samplers;
