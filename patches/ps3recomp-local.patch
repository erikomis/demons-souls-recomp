+/* cellAudioSetPortLevel(portNum, level) -- NID 0x56DFE179. Unimplemented, the call returned with r3
+ * untouched, so the caller read its own port number back as a status (MultiStream calls it 17
+ * times during Demon's Souls' boot). The level is a float: f1, hence the context handler. */
+s32 cellAudioSetPortLevel(u32 portNum, float level)
+{
+    static int n = 0;
+    if (PS3_LOG_FIRST(n, 8)) printf("[cellAudio] SetPortLevel(port=%u, level=%.3f)\n", portNum, level);
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+    if (portNum >= CELL_AUDIO_PORT_MAX || !s_ports[portNum].in_use)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+    if (!(level >= 0.0f)) return CELL_AUDIO_ERROR_PARAM;
+    mutex_lock(&s_audio_mutex);
+    s_ports[portNum].param.level = level;
+    mutex_unlock(&s_audio_mutex);
+    return CELL_OK;
+}
+static void hle_audio_set_port_level(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)cellAudioSetPortLevel((u32)ctx->gpr[3], (float)ctx->fpr[1]);
+}
