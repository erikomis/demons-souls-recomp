-    fprintf(stderr,
-            "[zetatrack] live new #%u %u:0x%X backing=%ux%u "
-            "clip=%ux%u canvas=%ux%u\n",
-            slot, location, offset, want_w, want_h,
-            rt_w, rt_h, g.width, g.height);
-    if (slot == g.n_zdepths) g.n_zdepths++;
-    return 1 + slot;
-}
