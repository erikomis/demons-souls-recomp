-            file = fopen(path, "w");
-            s_csv_file = file;
-            if (file) {
-                fprintf(file,
-                    "draw,frame,outcome,surf,prim,verts,source_verts,decoded_hash,"
-                    "pso_key,regs_hash,vp_hash,"
