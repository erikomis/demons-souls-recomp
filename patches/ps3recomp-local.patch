+/* End of the movie: SOURCE_EOS, then back to OPENED (the title then closes it,
+ * or starts it again -- Demon's Souls loops its title movie that way). */
+static void sail_check_eos(int slot)
+{
+    SailPlayer2* p = &s_sail_players[slot];
+    if (!p->running || p->eos_sent || !p->eng) return;
+    if (!sail_engine_finished(p->eng)) {
+        /* Audio still buffered: wait for the sound adapter to drain it, unless the
+         * pictures are done and the clock is a second past the movie's end (a
+         * title that stopped pulling sound must still see the end). */
+        SailDescriptor* d = sail_desc(p->desc_ea);
+        const int64_t end = d ? d->mi.end_pts : 0;
+        if (!end || !sail_engine_video_done(p->eng) || sail_clock(p) < end + 90000) return;
+    }
+    p->eos_sent = 1;
+    p->running = 0;
+    SAIL_LOG("[cellSail] end of stream\n");
+    sail_notify(slot, SAIL_EV_SOURCE_EOS, 0, 0, 0);
+    sail_state(slot, SAIL_ST_STOP_TRANSITION);
+    sail_state(slot, SAIL_ST_OPENED);
+}
