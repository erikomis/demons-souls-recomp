+            vm_write32(pInfo + 4, p->session);
+            vm_write32(pInfo + 8, ++p->vtag);
+            vm_write32(pInfo + 12, 0);
+            vm_write32(pInfo + 16, (u32)((u64)p->last_pts >> 32));
