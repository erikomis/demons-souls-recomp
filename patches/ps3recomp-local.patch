+/* Closing the window is switching the console off. The orderly shutdown after it
+ * never finished (guest and SPU threads keep spinning), so a closed game sat
+ * "Not Responding" on four cores until killed. 3 s after the close the process
+ * ends itself; the title saves as it plays, like a PS3. Both window procedures
+ * (this one, used by live draw, and the D3D12 backend's) arm it. */
+static DWORD WINAPI rsx_exit_flush(LPVOID arg) { (void)arg; fflush(NULL); return 0; }
+static DWORD WINAPI rsx_exit_guard(LPVOID arg)
+{
+    (void)arg;
+    Sleep(3000);
+    /* fflush(NULL) locks every stream, and a thread stuck mid-print would hold
+     * one forever: flush on the side, give it a second, then go regardless. */
+    HANDLE f = CreateThread(NULL, 0, rsx_exit_flush, NULL, 0, NULL);
+    if (f) { WaitForSingleObject(f, 1000); CloseHandle(f); }
+    TerminateProcess(GetCurrentProcess(), 0);
+    return 0;
+}
+void rsx_window_closing(void)
+{
+    static LONG armed = 0;
+    if (InterlockedExchange(&armed, 1) == 0) {
+        fprintf(stderr, "[exit] window closed: the process ends in 3 s\n");
+        HANDLE t = CreateThread(NULL, 0, rsx_exit_guard, NULL, 0, NULL);
+        if (t) CloseHandle(t);
+    }
+}
