+static DWORD WINAPI osk_window_thread(LPVOID arg)
+{
+    (void)arg;
+    HINSTANCE inst = GetModuleHandleW(NULL);
+    WNDCLASSW wc = {0};
+    wc.lpfnWndProc = osk_wndproc;
+    wc.hInstance = inst;
+    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+    wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+    wc.lpszClassName = L"ps3recomp_osk";
+    RegisterClassW(&wc);   /* fails harmlessly when already registered */
+
+    if (!s_osk_font) {
+        NONCLIENTMETRICSW ncm = { sizeof ncm };
+        SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof ncm, &ncm, 0);
+        ncm.lfMessageFont.lfHeight = -18;
+        s_osk_font = CreateFontIndirectW(&ncm.lfMessageFont);
+    }
+
+    /* Centred over the game window when it is in front, else on the screen. */
+    const int W = 440, H = 170;
+    RECT area; SystemParametersInfoW(SPI_GETWORKAREA, 0, &area, 0);
+    HWND fg = GetForegroundWindow(); DWORD pid = 0;
+    if (fg) GetWindowThreadProcessId(fg, &pid);
+    if (fg && pid == GetCurrentProcessId()) GetWindowRect(fg, &area);
+    const int x = area.left + ((area.right - area.left) - W) / 2;
+    const int y = area.top + ((area.bottom - area.top) - H) / 2;
+
+    HWND hwnd = CreateWindowExW(WS_EX_TOPMOST | WS_EX_DLGMODALFRAME, L"ps3recomp_osk",
+                                L"Enter text", WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                                x, y, W, H, NULL, NULL, inst, NULL);
+    if (!hwnd) {   /* no window: answer with the initial text, as before */
+        printf("[cellOskDialog] text box failed (error %lu)\n", (unsigned long)GetLastError());
+        fflush(stdout);
+        s_result_code = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK;
+        InterlockedExchange(&g_osk_host_window_open, 0);
+        osk_broadcast(OSK_SYSUTIL_FINISHED);
+        return 0;
+    }
+    s_osk_hwnd = hwnd;
+    RECT cr; GetClientRect(hwnd, &cr);
+    const int cw = cr.right - cr.left;
+    HWND hp = CreateWindowExW(0, L"STATIC", s_osk_prompt[0] ? s_osk_prompt : L"Enter text:",
+                              WS_CHILD | WS_VISIBLE, 16, 14, cw - 32, 24, hwnd, NULL, inst, NULL);
+    HWND he = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", s_osk_init,
+                              WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
+                              16, 44, cw - 32, 30, hwnd, (HMENU)(INT_PTR)OSK_ID_EDIT, inst, NULL);
+    HWND ho = CreateWindowExW(0, L"BUTTON", L"OK", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
+                              cw - 16 - 2 * 96 - 8, 88, 96, 30, hwnd, (HMENU)(INT_PTR)IDOK, inst, NULL);
+    HWND hc = CreateWindowExW(0, L"BUTTON", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP,
+                              cw - 16 - 96, 88, 96, 30, hwnd, (HMENU)(INT_PTR)IDCANCEL, inst, NULL);
+    HWND ctl[4] = { hp, he, ho, hc };
+    for (int i = 0; i < 4; i++) SendMessageW(ctl[i], WM_SETFONT, (WPARAM)s_osk_font, TRUE);
+    SendMessageW(he, EM_LIMITTEXT, s_osk_limit ? s_osk_limit : CELL_OSK_MAX_TEXT_LENGTH, 0);
+    SendMessageW(he, EM_SETSEL, 0, -1);
+    EnableWindow(ho, GetWindowTextLengthW(he) > 0);
+
+    ShowWindow(hwnd, SW_SHOW);
+    SetForegroundWindow(hwnd);
+    SetFocus(he);
+    printf("[cellOskDialog] text box open (limit %u chars)\n", s_osk_limit);
+    fflush(stdout);
+    if (getenv("OSK_BOX_AUTO")) SetTimer(hwnd, 1, 1500, NULL);
+
+    MSG m;
+    while (GetMessageW(&m, NULL, 0, 0) > 0) {
+        if (IsDialogMessageW(hwnd, &m)) continue;   /* Enter = OK, Esc = Cancel, Tab */
+        TranslateMessage(&m);
+        DispatchMessageW(&m);
+    }
+    s_osk_hwnd = NULL;
+    InterlockedExchange(&g_osk_host_window_open, 0);
+    osk_broadcast(OSK_SYSUTIL_FINISHED);
+    return 0;
+}
+
+/* Bring the text box up; 0 if it cannot be shown (the caller answers at once). */
+static int osk_open_host_window(const CellOskDialogChar* prompt, const CellOskDialogChar* init,
+                                u32 limit)
+{
+    u32 i;
+    for (i = 0; i < CELL_OSK_MAX_TEXT_LENGTH && prompt && prompt[i]; i++) s_osk_prompt[i] = prompt[i];
+    s_osk_prompt[i] = 0;
+    for (i = 0; i < CELL_OSK_MAX_TEXT_LENGTH && init && init[i]; i++) s_osk_init[i] = init[i];
+    s_osk_init[i] = 0;
+    s_osk_limit = limit;
+    InterlockedExchange(&g_osk_host_window_open, 1);
+    HANDLE t = CreateThread(NULL, 0, osk_window_thread, NULL, 0, NULL);
+    if (!t) { InterlockedExchange(&g_osk_host_window_open, 0); return 0; }
+    CloseHandle(t);
+    return 1;
+}
+
+static void osk_close_host_window(void)
+{
+    HWND h = s_osk_hwnd;
+    if (h) PostMessageW(h, WM_CLOSE, 0, 0);
+}
+#else
+static int osk_open_host_window(const CellOskDialogChar* prompt, const CellOskDialogChar* init,
+                                u32 limit)
+{ (void)prompt; (void)init; (void)limit; return 0; }
+static void osk_close_host_window(void) {}
+#endif
