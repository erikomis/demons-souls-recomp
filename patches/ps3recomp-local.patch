-        vm_write32(alloc_ea + 0, vm_read32(funcs_ea + 0));   /* pAlloc */
-        vm_write32(alloc_ea + 4, vm_read32(funcs_ea + 4));   /* pFree  */
+        const u32 fa = vm_read32(funcs_ea + 0), ff = vm_read32(funcs_ea + 4);
+        vm_write32(alloc_ea + 0, fa);   /* pAlloc */
+        vm_write32(alloc_ea + 4, ff);   /* pFree  */
+        sail_lock();
+        int k = 0;
+        while (k < 8 && s_allocs[k].ea && s_allocs[k].ea != alloc_ea) k++;
+        if (k < 8) { s_allocs[k].ea = alloc_ea; s_allocs[k].alloc = fa; s_allocs[k].free = ff; s_allocs[k].arg = pArg; }
+        sail_unlock();
     }
     return CELL_OK;
 }
