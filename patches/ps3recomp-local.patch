-    D3D12_GPU_DESCRIPTOR_HANDLE gpu;
-    g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(
-        g.srv_heap, &gpu);
-    gpu.ptr += (u64)base * g.srv_step;
-    *out_source = gpu;
-    gpu.ptr += g.srv_step;
