+                "sound pulls %u (%.2f s real) repeats %u\n",
+                (double)(clock - p->start_pts) / 90000.0, shown, dropped, queued, pcm_ms, under,
+                p->gpu_tag, p->vtag, p->snd_pulls, (double)p->snd_real / 48000.0, p->repeats);
+        p->log_us = sail_now_us();
