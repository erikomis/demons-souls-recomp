+/* ---------------------------------------------------------------------------
+ * Header parse (pure host code; the unit test drives it directly)
+ * -----------------------------------------------------------------------*/
+s32 pamf_header_parse(const uint8_t* hdr, size_t n, PamfHeaderInfo* out)
+{
+    if (!out)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    memset(out, 0, sizeof(*out));
+    if (!hdr || n < PAMF_OFF_STREAMS)
+        return (s32)CELL_PAMF_ERROR_INVALID_PAMF;
+    if (be32(hdr + PAMF_OFF_MAGIC) != CELL_PAMF_MAGIC)
+        return (s32)CELL_PAMF_ERROR_INVALID_PAMF;
+
+    u32 dataOffSectors = be32(hdr + PAMF_OFF_DATA_OFFSET);
+    /* A header bigger than 4 GB is garbage; refuse it rather than wrap. */
+    if (dataOffSectors > 0x1FFFFFu)
+        return (s32)CELL_PAMF_ERROR_INVALID_PAMF;
+
+    out->version    = be32(hdr + PAMF_OFF_VERSION);
+    out->headerSize = dataOffSectors * PAMF_SECTOR;
+    out->dataSize   = (u64)be32(hdr + PAMF_OFF_DATA_SIZE) * PAMF_SECTOR;
+    out->startPts   = ((u64)be16(hdr + PAMF_OFF_START_PTS_HI) << 32) | be32(hdr + PAMF_OFF_START_PTS_LO);
+    out->endPts     = ((u64)be16(hdr + PAMF_OFF_END_PTS_HI) << 32) | be32(hdr + PAMF_OFF_END_PTS_LO);
+    out->muxRateMax = be32(hdr + PAMF_OFF_MUX_RATE_MAX);
+    out->muxRateMin = be32(hdr + PAMF_OFF_MUX_RATE_MIN);
+    out->numStreams = hdr[PAMF_OFF_STREAM_COUNT];
+
+    /* Entries past the header proper (data offset) are mux data, not table;
+     * entries past n were not given to us. Either way stop there. */
+    size_t limit = n;
+    if (out->headerSize && out->headerSize < limit)
+        limit = out->headerSize;
+
+    u32 i;
+    for (i = 0; i < out->numStreams; i++) {
+        size_t off = PAMF_OFF_STREAMS + (size_t)i * PAMF_STREAM_ENTRY_SIZE;
+        if (i >= PAMF_HOST_MAX_STREAMS || off + PAMF_STREAM_ENTRY_SIZE > limit) {
+            printf("[cellPamf] header states %u streams, only %u fit (%zu bytes given)\n",
+                   out->numStreams, i, n);
+            break;
+        }
+        const u8* e  = hdr + off;
+        const u8* ci = e + PAMF_STREAM_INFO_OFF;
+        PamfStreamDesc* d = &out->streams[i];
+        d->rawType     = e[0];
+        d->sdkType     = raw_type_to_sdk(e[0]);
+        d->fidMajor    = e[4];
+        d->fidMinor    = e[5];
+        d->epOffset    = be32(e + 0x08);
+        d->epNum       = be32(e + 0x0C);
+        d->entryOffset = (u32)off;
+        if (sdk_is_video(d->sdkType)) {
+            /* Video: the channel is the PES id's low nibble (0xE0 + ch). */
+            d->channel       = d->fidMajor & 0x0F;
+            d->frameRateCode = ci[2] & 0x0F;
+            if (d->sdkType == CELL_PAMF_STREAM_TYPE_M2V) {
+                d->width  = be16(ci + 0x0C);   /* horizontal_size_value */
+                d->height = be16(ci + 0x0E);
+            } else {
+                /* AVC stores only macroblock counts (low byte); cropping is
+                 * left to the GetStreamInfo consumer. */
+                d->width  = (u16)(ci[0x09] * 16);
+                d->height = (u16)(ci[0x0B] * 16);
+            }
+        } else if (d->sdkType >= 0) {
+            /* Audio and user data: the private sub-id's low nibble. */
+            d->channel = d->fidMinor & 0x0F;
+            if (sdk_is_audio(d->sdkType)) {
+                d->audioChannels = ci[2];
+                d->audioFsCode   = ci[3];
+                d->audioBitsCode = ci[4];
+            }
+        } else {
+            d->channel = 0xFF;
+        }
+    }
+    out->numParsed = (u8)i;
+    return CELL_OK;
