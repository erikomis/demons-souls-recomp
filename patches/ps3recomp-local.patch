-{
-    D3D12_CPU_DESCRIPTOR_HANDLE h;
-    g.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.dsv_heap, &h);
-    h.ptr += (size_t)slot * g.dsv_step;
-    return h;
