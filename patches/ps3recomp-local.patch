+/* Movie clock in 90 kHz ticks: host time since Start (frozen while paused),
+ * shifted by PS3_SAIL_AV_MS. Never guest time -- the guest clock runs scaled in
+ * the 60 fps modes. */
+static int64_t sail_clock(SailPlayer2* p)
+{
+    static int av_ms = 0x7FFFFFFF;
+    if (av_ms == 0x7FFFFFFF) { const char* e = getenv("PS3_SAIL_AV_MS"); av_ms = e ? atoi(e) : 0; }
+    const uint64_t now = p->paused && p->paused_at_us ? p->paused_at_us : sail_now_us();
+    return p->start_pts + (int64_t)((now - p->t0_us) * 9 / 100) - (int64_t)av_ms * 90;
