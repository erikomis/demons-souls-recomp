+        s32 var1 = pointer - h5;
+        if (var1 < 0) var1 += depth * 2;
+        s32 var2 = (s32)(s16)ef_r16(q + 0x06) - (s32)ef_r16(q + 0x00);   /* pop1.m_h4 - m_h1 */
+        if (var2 < 0) var2 += depth * 2;
