-            g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
-            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
-            &IID_ID3D12Resource, (void**)&g.movie_overlay_readback))) {
-        fprintf(stderr, "[movie-ui] readback allocation failed\n");
