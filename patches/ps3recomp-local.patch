+
+/* Present a host-decoded RGBA8 frame to the window: copy it straight into the
+ * swap-chain backbuffer (both R8G8B8A8_UNORM at the swap size) and Present.
+ * The frame is clamped to the backbuffer size. Call from a single thread with
+ * movie mode on (so guest draws don't touch g.list). */
+void rsx_live_draw_present_rgba(const uint8_t* rgba, u32 w, u32 h)
+{
+    const int composite = ld_movie_composite_ui_enabled();
+    const int serialized = composite || g_ld_debug_layer_enabled;
+    if (serialized) {
+        InterlockedExchange(&g_ld_host_waiting, 1);
+        AcquireSRWLockExclusive(&g_ld_access_lock);
+    }
+    if (!g.ready || !rgba) {
+        if (serialized) {
+            ReleaseSRWLockExclusive(&g_ld_access_lock);
+            InterlockedExchange(&g_ld_host_waiting, 0);
+        }
+        return;
+    }
+    if (composite && !ld_movie_overlay_ensure()) {
+        ReleaseSRWLockExclusive(&g_ld_access_lock);
+        InterlockedExchange(&g_ld_host_waiting, 0);
+        return;
+    }
+    if (w > g.width)  w = g.width;
+    if (h > g.height) h = g.height;
+    const u32 pitch = (w * 4 + 255) & ~255u;          /* D3D12 copy pitch align */
+    if ((UINT64)pitch * h > UPLOAD_SIZE) {
+        if (serialized) {
+            ReleaseSRWLockExclusive(&g_ld_access_lock);
+            InterlockedExchange(&g_ld_host_waiting, 0);
+        }
+        return;
+    }
+
+    u8* host_upload = composite ? g.movie_upload_mapped : g.upload_mapped;
+    for (u32 y = 0; y < h; y++) {
+        u8* dstrow = host_upload + (size_t)y * pitch;
+        memcpy(dstrow, rgba + (size_t)y * w * 4, (size_t)w * 4);
+        if (composite && g.movie_overlay_valid && g.movie_overlay_rgba &&
+            g.movie_overlay_mask) {
+            const u8* ov = g.movie_overlay_rgba + (size_t)y * g.width * 4;
+            const u8* mask =
+                g.movie_overlay_mask + (size_t)y * g.width;
+            for (u32 x = 0; x < w; x++, ov += 4) {
+                const int coverage = mask[x];
+                if (!coverage) continue;
+                u8* out = dstrow + (size_t)x * 4;
+                if (coverage == 1) {
+                    out[0] = (u8)((out[0] * 64 + 127) / 255);
+                    out[1] = (u8)((out[1] * 64 + 127) / 255);
+                    out[2] = (u8)((out[2] * 64 + 127) / 255);
+                    continue;
+                }
+                const int white = ov[0] > ov[1]
+                    ? (ov[0] > ov[2] ? ov[0] : ov[2])
+                    : (ov[1] > ov[2] ? ov[1] : ov[2]);
+                for (int c = 0; c < 3; c++) {
+                    const int v =
+                        (white * coverage +
+                         out[c] * (255 - coverage) + 127) / 255;
+                    out[c] = (u8)v;
+                }
+                out[3] = 255;
+            }
+        }
+    }
+
+    const u32 bbi = g.swap->lpVtbl->GetCurrentBackBufferIndex(g.swap);
+    ID3D12Resource* bb = g.backbuf[bbi];
+
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = bb;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = bb; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; dst.SubresourceIndex = 0;
+    src.pResource = composite ? g.movie_upload : g.upload;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Offset = 0;
+    src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    src.PlacedFootprint.Footprint.Width = w;
+    src.PlacedFootprint.Footprint.Height = h;
+    src.PlacedFootprint.Footprint.Depth = 1;
+    src.PlacedFootprint.Footprint.RowPitch = pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+
+    ld_flush(LD_FLUSH_MOVIE_PRESENT);
+    {
+        const HRESULT present_hr = g.swap->lpVtbl->Present(g.swap, 1, 0);
+        if (SUCCEEDED(present_hr))
+            ld_present_measure_record(g_ld_frames);
+        else {
+            fprintf(stderr,
+                    "[d3d-fail] movie Present hr=0x%08lX frame=%u\n",
+                    (unsigned long)present_hr, g_ld_frames);
+            ld_dump_dred("MoviePresent", present_hr);
+            g.ready = 0;
+        }
+    }
+    if (serialized) {
+        ReleaseSRWLockExclusive(&g_ld_access_lock);
+        InterlockedExchange(&g_ld_host_waiting, 0);
+    }
+}
+
+/* Env-gated (RSX_DUMP) framebuffer dump: read the current color surface back
+ * and write a binary PPM. Self-contained -- creates + releases its own readback
+ * buffer, so no init/struct changes. Uses g.list which ld_flush leaves open. */
+/* Readback texel -> 8-bit RGB.  This title renders HDR into FP16 targets, so a
+ * dump has to tone it down rather than reinterpret the bytes.  Reinhard keeps
+ * the whole range visible without pretending to match the guest tonemapper. */
+static void ld_dump_texel_rgb(const u8* p, int fp16, u8* out)
+{
+    if (!fp16) { out[0] = p[0]; out[1] = p[1]; out[2] = p[2]; return; }
+    for (int c = 0; c < 3; c++) {
+        const u16 h = (u16)(p[c * 2] | (p[c * 2 + 1] << 8));
+        const int ex = (h >> 10) & 0x1F, ma = h & 0x3FF;
+        float f;
+        if (ex == 0)       f = (float)ma * (1.0f / 16384.0f) * (1.0f / 64.0f);
+        else if (ex == 31) f = 65504.0f;
+        else { f = 1.0f + (float)ma / 1024.0f;
+               int k = ex - 15;
+               while (k > 0) { f *= 2.0f; k--; }
+               while (k < 0) { f *= 0.5f; k++; } }
+        if (h & 0x8000) f = 0.0f;
+        f = f / (1.0f + f);                          /* Reinhard */
+        out[c] = (u8)(f * 255.0f + 0.5f);
+    }
+}
+
+/* --record: when set, ld_dump_surface_ppm appends to this ffmpeg pipe instead
+ * of opening `path`, and skips its per-dump diagnostics (every frame goes
+ * through here while recording). */
+static FILE* g_ld_record_to;
+
+/* Render-target write-back for small FP32 targets. Live-draw keeps render targets on the host, but a
+ * game may read one with the CPU: Demon's Souls reduces scene luminance into 16x16 F_X32 targets in
+ * local memory and its auto-exposure reads them back. Nothing ever reached guest memory, the CPU read 0
+ * and the exposure (shader global 0x87.x) stayed 0 -- a black world (NOTES fix 20/21). At each present
+ * the small FP32 surfaces are copied into persistent readback buffers before the present flush and
+ * stored into guest memory (big-endian floats, at the guest pitch) after it, so the CPU sees the
+ * result one flip later, as it would on the console. LD_RT_WRITEBACK=0 = off;
+ * LD_RT_WRITEBACK_MAX=<texels> (default 4096) caps the surface size; LD_RT_WRITEBACK_DBG=1 logs.
+ * Only a surface drawn, cleared or copied into since its last write-back is stored: the GPU writes
+ * memory only when it renders. Storing every small FP32 surface ever seen kept writing the targets of a
+ * finished session after quit-to-title; the game's local-memory heap (DLRegularHeap 0x1AD6370) had
+ * reused them for block headers, its free lists picked up luminance floats as links (-11.8 =
+ * 0xC13CED98) and it overwrote live data -- the final-copy quad at local 0xD0 (black screen), vertex
+ * buffers (stretched triangles). NOTES fix 31. */
+static struct { ID3D12Resource* rb; u32 size, pitch, w, h, texel, location, offset, guest_pitch, wgen; int pending; }
+    g_ld_wb[MAX_SURFACES];
+static int ld_wb_pending(u32 i) { return i < MAX_SURFACES && g_ld_wb[i].pending; }
+static int ld_wb_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_RT_WRITEBACK"); on = (e && e[0] == '0') ? 0 : 1; }
+    return on;
+}
+/* Record surface i's copy if it is a write-back target rendered since its last
+ * one; 1 if a copy was recorded. */
+static int ld_rt_writeback_record_one(u32 i)
+{
+    if (!ld_wb_on() || i >= g.n_surfaces || i >= MAX_SURFACES) return 0;
+    static u32 max_texels;
+    if (!max_texels) { const char* e = getenv("LD_RT_WRITEBACK_MAX"); max_texels = e ? (u32)atoi(e) : 4096u;
+                       if (!max_texels) max_texels = 4096u; }
+    {
+        surface_t* sf = &g.surfaces[i];
+        const u32 texel = sf->fmt == DXGI_FORMAT_R32_FLOAT ? 4u :
+                          sf->fmt == DXGI_FORMAT_R32G32B32A32_FLOAT ? 16u : 0u;
+        if (!texel || !sf->tex || !sf->w || !sf->h || sf->w * sf->h > max_texels || sf->sc != 1) return 0;
+        if (g_ld_wb[i].rb && g_ld_wb[i].wgen == sf->swin_wgen) return 0;   /* not rendered since */
+        const u32 pitch = (sf->w * texel + 255) & ~255u;
+        const u32 size = pitch * sf->h;
+        if (g_ld_wb[i].rb && g_ld_wb[i].size < size) { retire_texture(g_ld_wb[i].rb); g_ld_wb[i].rb = NULL; }
+        if (!g_ld_wb[i].rb) {
+            D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+            D3D12_RESOURCE_DESC bd = {0};
+            bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = size;
+            bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+            bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+            bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                    D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_ld_wb[i].rb)))
+                { g_ld_wb[i].rb = NULL; return 0; }
+            g_ld_wb[i].size = size;
+        }
+        D3D12_RESOURCE_BARRIER b = {0};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = sf->tex;
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+        D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+        src.pResource = sf->tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        dst.pResource = g_ld_wb[i].rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        dst.PlacedFootprint.Footprint.Format = sf->fmt;
+        dst.PlacedFootprint.Footprint.Width = sf->w;
+        dst.PlacedFootprint.Footprint.Height = sf->h;
+        dst.PlacedFootprint.Footprint.Depth = 1;
+        dst.PlacedFootprint.Footprint.RowPitch = pitch;
+        g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+        g_ld_wb[i].pitch = pitch; g_ld_wb[i].w = sf->w; g_ld_wb[i].h = sf->h; g_ld_wb[i].texel = texel;
+        g_ld_wb[i].location = sf->location; g_ld_wb[i].offset = sf->offset;
+        g_ld_wb[i].guest_pitch = sf->pitch ? sf->pitch : sf->w * texel;
+        g_ld_wb[i].wgen = sf->swin_wgen;
+        g_ld_wb[i].pending = 1;
+    }
+    return 1;
+}
+/* Every write-back target not copied yet; 1 if any copy was recorded. */
+static int ld_rt_writeback_record(void)
+{
+    int any = 0;
+    for (u32 i = 0; i < g.n_surfaces && i < MAX_SURFACES; i++) any |= ld_rt_writeback_record_one(i);
+    return any;
+}
+/* After the flush that executed ld_rt_writeback_record's copies. */
+static void ld_rt_writeback_commit(void)
+{
+    static int dbg = -1;
+    if (dbg < 0) dbg = getenv("LD_RT_WRITEBACK_DBG") ? 1 : 0;
+    for (u32 i = 0; i < MAX_SURFACES; i++) {
+        if (!g_ld_wb[i].pending) continue;
+        g_ld_wb[i].pending = 0;
+        const u32 row = g_ld_wb[i].w * g_ld_wb[i].texel;
+        if (g_ld_wb[i].guest_pitch < row) continue;
+        u8* gp = (u8*)guest_ptr(g_ld_wb[i].location, g_ld_wb[i].offset,
+                                g_ld_wb[i].guest_pitch * (g_ld_wb[i].h - 1) + row);
+        if (!gp) continue;
+        const u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)g_ld_wb[i].size};
+        if (FAILED(g_ld_wb[i].rb->lpVtbl->Map(g_ld_wb[i].rb, 0, &rr, (void**)&px))) continue;
+        for (u32 y = 0; y < g_ld_wb[i].h; y++) {
+            const u32* srow = (const u32*)(px + (SIZE_T)y * g_ld_wb[i].pitch);
+            u8* drow = gp + (SIZE_T)y * g_ld_wb[i].guest_pitch;
+            for (u32 k = 0; k < row / 4u; k++) {
+                const u32 v = srow[k];
+                drow[k * 4 + 0] = (u8)(v >> 24); drow[k * 4 + 1] = (u8)(v >> 16);
+                drow[k * 4 + 2] = (u8)(v >> 8);  drow[k * 4 + 3] = (u8)v;
+            }
+        }
+        if (dbg) {
+            static u32 n_logs;
+            if (n_logs++ < 64 || (g_ld_frames % 300) == 0) {
+                float f0, fc; memcpy(&f0, px, 4);
+                memcpy(&fc, px + (SIZE_T)(g_ld_wb[i].h / 2) * g_ld_wb[i].pitch + (g_ld_wb[i].w / 2) * g_ld_wb[i].texel, 4);
+                fprintf(stderr, "[rt-wb] frame %u %u:0x%X %ux%u texel %u -> guest (pitch %u) [0]=%g [mid]=%g\n",
+                        g_ld_frames, g_ld_wb[i].location, g_ld_wb[i].offset, g_ld_wb[i].w, g_ld_wb[i].h,
+                        g_ld_wb[i].texel, g_ld_wb[i].guest_pitch, f0, fc);
+            }
+        }
+        D3D12_RANGE wr = {0, 0};
+        g_ld_wb[i].rb->lpVtbl->Unmap(g_ld_wb[i].rb, 0, &wr);
+    }
+}
+
+static u64 ld_dump_surface_ppm(const char* path, const surface_t* surface)
+{
+    ID3D12Resource* rt = surface ? surface->tex : NULL;
+    if (!rt) return UINT64_MAX;
+    const u32 width = LD_HW(surface);
+    const u32 height = LD_HH(surface);
+    if (!width || !height) return UINT64_MAX;
+    const int fp16 = surface->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT;
+    const u32 texel = fp16 ? 8u : 4u;
+    const u32 pitch = (width * texel + 255) & ~255u;             /* 256-align */
+    const UINT64 rb_size = (UINT64)pitch * height;
+
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = rb_size;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return UINT64_MAX;
+
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = rt;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = rt; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; src.SubresourceIndex = 0;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = surface->fmt;
+    dst.PlacedFootprint.Footprint.Width = width;
+    dst.PlacedFootprint.Footprint.Height = height;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+
+    ld_flush(LD_FLUSH_READBACK);                   /* copy completes on the GPU */
+
+    u64 nonblack = UINT64_MAX;
+    u64 fingerprint = 1469598103934665603ull;
+    u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)rb_size};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        nonblack = 0;
+        if (!g_ld_record_to) {   /* raw texels, to tell an FP16 target from 8-bit data read as one */
+            const u8* r0 = px + (SIZE_T)(height / 4) * pitch + (width / 4) * texel;
+            fprintf(stderr, "[dump-raw] %s fmt=%d texel=%u bytes:", path, (int)surface->fmt, texel);
+            for (u32 bi = 0; bi < 16; bi++) fprintf(stderr, " %02X", r0[bi]);
+            fprintf(stderr, "\n");
+        }
+        FILE* f = g_ld_record_to ? g_ld_record_to : fopen(path, "wb");
+        if (f) {
+            fprintf(f, "P6\n%u %u\n255\n", width, height);
+            for (u32 y = 0; y < height; y++) {
+                const u8* row = px + (SIZE_T)y * pitch;
+                for (u32 x = 0; x < width; x++) {
+                    const u8* pixel = row + x * texel;
+                    u8 rgb[3]; ld_dump_texel_rgb(pixel, fp16, rgb);
+                    if (rgb[0] || rgb[1] || rgb[2])
+                        nonblack++;
+                    fingerprint = fnv1a(rgb, 3, fingerprint);
+                    fwrite(rgb, 1, 3, f);  /* RGBA->RGB */
+                }
+            }
+            if (f != g_ld_record_to) {
+                fclose(f);
+                fprintf(stderr, "[live-draw] wrote %s\n", path);
+            }
+        } else {
+            for (u32 y = 0; y < height; y++) {
+                const u8* row = px + (SIZE_T)y * pitch;
+                for (u32 x = 0; x < width; x++) {
+                    const u8* pixel = row + x * texel;
+                    u8 rgb[3]; ld_dump_texel_rgb(pixel, fp16, rgb);
+                    if (rgb[0] || rgb[1] || rgb[2])
+                        nonblack++;
+                    fingerprint = fnv1a(rgb, 3, fingerprint);
+                }
+            }
+        }
+        D3D12_RANGE wr = {0, 0};
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+        g_ld_last_dump_fingerprint = fingerprint;
+    }
+    rb->lpVtbl->Release(rb);
+    return nonblack;
+}
+
+/* LD_VIDEO=<out.mkv>: a showcase capture of the presented frames that does not slow the game
+ * (Demon's Souls NOTES fix 51). LD_RECORD reads every frame back behind a blocking flush; here the
+ * copy goes into a ring of readback buffers, is picked up a few presents later once the GPU has
+ * passed its fence, and a writer thread pipes it to ffmpeg. Frames land on a fixed LD_VIDEO_FPS grid
+ * (default 60) by their present time -- a frame that stayed up longer is repeated -- so the video
+ * shows the pacing a viewer saw. LD_VIDEO_FFMPEG=<ffmpeg.exe> (default "ffmpeg" on PATH),
+ * LD_VIDEO_ENC=<ffmpeg output codec args> (default NVENC H.264, constant quality 18). Matroska
+ * output stays playable when the process is killed instead of exiting. */
+#define LD_VIDEO_RING 4
+#define LD_VIDEO_QUEUE 12
+static struct {
+    int on;                       /* 0 unread, 1 on, 2 start at the next frame, -1 off */
+    u32 w, h, src_pitch, fmt;     /* fixed by the first frame */
+    int fp16, bgra;
+    struct { ID3D12Resource* rb; u64 fence; u64 t_us; int busy; } ring[LD_VIDEO_RING];
+    struct { u8* px; u64 t_us; } q[LD_VIDEO_QUEUE];
+    u32 q_head, q_tail;           /* producer writes tail, writer reads head */
+    SRWLOCK lock; CONDITION_VARIABLE cv;
+    FILE* pipe;
+    double fps;
+    u64 frames, dropped, written;
+} g_ldv;
+
+static u64 ldv_now_us(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (u64)((double)c.QuadPart * 1e6 / (double)f.QuadPart);
+}
+
+static DWORD WINAPI ldv_writer(LPVOID unused)
+{
+    (void)unused;
+    const size_t fb = (size_t)g_ldv.w * g_ldv.h * 4;
+    u8* last = (u8*)malloc(fb); u8* conv = (u8*)malloc(fb);
+    u64 last_t = 0; double grid = 0; int have = 0;
+    const double step = 1e6 / g_ldv.fps;
+    for (;;) {
+        AcquireSRWLockExclusive(&g_ldv.lock);
+        while (g_ldv.q_head == g_ldv.q_tail)
+            SleepConditionVariableSRW(&g_ldv.cv, &g_ldv.lock, INFINITE, 0);
+        const u32 k = g_ldv.q_head % LD_VIDEO_QUEUE;
+        ReleaseSRWLockExclusive(&g_ldv.lock);
+        u8* px = g_ldv.q[k].px; const u64 t = g_ldv.q[k].t_us;
+        if (!have) fprintf(stderr, "[video] first frame qpc_us=%llu\n", (unsigned long long)t);
+        if (have) {                      /* the previous frame was on screen from last_t until t */
+            if (grid < (double)last_t) grid = (double)last_t;
+            while (grid < (double)t) {
+                if (fwrite(last, 1, fb, g_ldv.pipe) != fb) { fprintf(stderr, "[video] ffmpeg pipe closed\n"); return 0; }
+                g_ldv.written++; grid += step;
+            }
+        }
+        /* rows tightly packed, 4 bytes a pixel, in the pix_fmt ffmpeg was told */
+        for (u32 y = 0; y < g_ldv.h; y++) {
+            const u8* srow = px + (size_t)y * g_ldv.src_pitch;
+            u8* drow = last + (size_t)y * g_ldv.w * 4;
+            if (!g_ldv.fp16) memcpy(drow, srow, (size_t)g_ldv.w * 4);
+            else for (u32 x = 0; x < g_ldv.w; x++) { ld_dump_texel_rgb(srow + x * 8, 1, drow + x * 4); drow[x * 4 + 3] = 255; }
+        }
+        (void)conv;
+        last_t = t; have = 1;
+        AcquireSRWLockExclusive(&g_ldv.lock);
+        g_ldv.q_head++;
+        ReleaseSRWLockExclusive(&g_ldv.lock);
+        if ((g_ldv.written % 600) < 2 && g_ldv.written)
+            fprintf(stderr, "[video] %llu frames presented, %llu written, %llu dropped\n",
+                    (unsigned long long)g_ldv.frames, (unsigned long long)g_ldv.written,
+                    (unsigned long long)g_ldv.dropped);
+    }
+}
+
+static int ldv_start(const surface_t* sf)
+{
+    const char* out = getenv("LD_VIDEO");
+    const char* ff = getenv("LD_VIDEO_FFMPEG");
+    const char* enc = getenv("LD_VIDEO_ENC");
+    const char* fe = getenv("LD_VIDEO_FPS");
+    g_ldv.fps = fe ? atof(fe) : 60.0; if (g_ldv.fps < 1) g_ldv.fps = 60.0;
+    g_ldv.w = LD_HW(sf); g_ldv.h = LD_HH(sf);
+    g_ldv.fp16 = sf->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT;
+    g_ldv.bgra = sf->fmt == DXGI_FORMAT_B8G8R8A8_UNORM || sf->fmt == DXGI_FORMAT_B8G8R8X8_UNORM;
+    g_ldv.fmt = (u32)sf->fmt;
+    g_ldv.src_pitch = (LD_HW(sf) * (g_ldv.fp16 ? 8u : 4u) + 255) & ~255u;
+    char cmd[MAX_PATH * 4];
+    snprintf(cmd, sizeof cmd,
+             "\"\"%s\" -loglevel error -y -f rawvideo -pix_fmt %s -s %ux%u -r %g -i - %s \"%s\"\"",
+             ff && ff[0] ? ff : "ffmpeg", g_ldv.bgra ? "bgra" : "rgba", LD_HW(sf), LD_HH(sf), g_ldv.fps,
+             enc && enc[0] ? enc : LD_HW(sf) > 4096u   /* 4x internal resolution: over NVENC's width limit */
+                 ? "-vf scale=-2:2160:flags=area -c:v h264_nvenc -preset p6 -rc vbr -cq 18 -b:v 0 -pix_fmt yuv420p"
+                 : "-c:v h264_nvenc -preset p6 -rc vbr -cq 18 -b:v 0 -pix_fmt yuv420p", out);
+    g_ldv.pipe = _popen(cmd, "wb");
+    fprintf(stderr, "[video] %s -> %s (%ux%u fmt %d, %g fps grid)\n", g_ldv.pipe ? "ffmpeg" : "FAILED to start ffmpeg",
+            out, LD_HW(sf), LD_HH(sf), (int)sf->fmt, g_ldv.fps);
+    if (!g_ldv.pipe) return 0;
+    const size_t sz = (size_t)g_ldv.src_pitch * g_ldv.h;
+    for (int i = 0; i < LD_VIDEO_QUEUE; i++) g_ldv.q[i].px = (u8*)malloc(sz);
+    InitializeSRWLock(&g_ldv.lock); InitializeConditionVariable(&g_ldv.cv);
+    HANDLE th = CreateThread(NULL, 0, ldv_writer, NULL, 0, NULL);
+    if (th) CloseHandle(th);
+    return th != NULL;
+}
+
+/* At each present, with the presented surface: hand finished copies to the writer, then record
+ * this frame's copy into a free ring slot. Never waits on the GPU. */
+static void ldv_frame(const surface_t* sf)
+{
+    if (!g_ldv.on) { const char* e = getenv("LD_VIDEO"); g_ldv.on = (e && e[0]) ? 2 : -1; }
+    if (g_ldv.on < 0 || !sf || !sf->tex) return;
+    if (g_ldv.on == 2) { g_ldv.on = ldv_start(sf) ? 1 : -1; if (g_ldv.on < 0) return; }
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    const size_t sz = (size_t)g_ldv.src_pitch * g_ldv.h;
+    for (;;) {                                   /* oldest finished copy first, in present order */
+        int best = -1;
+        for (int i = 0; i < LD_VIDEO_RING; i++)
+            if (g_ldv.ring[i].busy && (best < 0 || g_ldv.ring[i].t_us < g_ldv.ring[best].t_us)) best = i;
+        if (best < 0 || g_ldv.ring[best].fence > done) break;
+        ID3D12Resource* rb = g_ldv.ring[best].rb;
+        AcquireSRWLockExclusive(&g_ldv.lock);
+        const int full = g_ldv.q_tail - g_ldv.q_head >= LD_VIDEO_QUEUE;
+        ReleaseSRWLockExclusive(&g_ldv.lock);
+        if (full) g_ldv.dropped++;
+        else {
+            u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)sz};
+            if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+                const u32 k = g_ldv.q_tail % LD_VIDEO_QUEUE;
+                memcpy(g_ldv.q[k].px, px, sz); g_ldv.q[k].t_us = g_ldv.ring[best].t_us;
+                D3D12_RANGE wr = {0, 0}; rb->lpVtbl->Unmap(rb, 0, &wr);
+                AcquireSRWLockExclusive(&g_ldv.lock);
+                g_ldv.q_tail++;
+                ReleaseSRWLockExclusive(&g_ldv.lock);
+                WakeConditionVariable(&g_ldv.cv);
+            }
+        }
+        g_ldv.ring[best].busy = 0;
+    }
+    g_ldv.frames++;
+    if (LD_HW(sf) != g_ldv.w || LD_HH(sf) != g_ldv.h || (u32)sf->fmt != g_ldv.fmt) { g_ldv.dropped++; return; }
+    int slot = -1;
+    for (int i = 0; i < LD_VIDEO_RING; i++) if (!g_ldv.ring[i].busy) { slot = i; break; }
+    if (slot < 0) { g_ldv.dropped++; return; }
+    if (!g_ldv.ring[slot].rb) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = sz;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_ldv.ring[slot].rb)))
+            { g_ldv.ring[slot].rb = NULL; g_ldv.dropped++; return; }
+    }
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = sf->tex;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = sf->tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = g_ldv.ring[slot].rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = sf->fmt;
+    dst.PlacedFootprint.Footprint.Width = LD_HW(sf);
+    dst.PlacedFootprint.Footprint.Height = LD_HH(sf);
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = g_ldv.src_pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    /* the list this copy sits in is submitted before the next Signal, which is fence_value + 1 */
+    g_ldv.ring[slot].fence = g.fence_value + 1;
+    g_ldv.ring[slot].t_us = ldv_now_us();
+    g_ldv.ring[slot].busy = 1;
+}
+
+#if !defined(YZ_PERF_CLEAN)
+static void ld_parity_capture_surface(
+    const char* directory, const char* phase, u32 serial,
+    u32 buffer_id, u32 target)
+{
+    if (!directory || !directory[0] || target >= g.n_surfaces)
+        return;
+    surface_t* surface = &g.surfaces[target];
+    char path[MAX_PATH * 2];
+    snprintf(
+        path, sizeof(path),
+        "%s\\%s_%03u_flip_%llu_buf_%u_surface_%u_write_%u_kind_%u.ppm",
+        directory, phase, serial,
+        (unsigned long long)g_ld_flip_requested,
+        buffer_id, target, surface->last_write_generation,
+        surface->last_write_kind);
+    const u64 nonblack = ld_dump_surface_ppm(path, surface);
+    fprintf(
+        stderr,
+        "[parity-capture] phase=%s serial=%u flip=%llu buffer=%u "
+        "surface=%u resource=%u write=%u kind=%u draw=%u clear=%u "
+        "copy=%u blit=%u resolve=%u other=%u guest_blit=%u "
+        "present_copy=%u get=%08X put=%08X cb=%u vb=%u srv=%u "
+        "groups=%llu drop_ring=%llu cb_recycles=%llu frame_cb_recycles=%u "
+        "hash=%016llX nonblack=%s%llu path=%s\n",
+        phase, serial, (unsigned long long)g_ld_flip_requested,
+        buffer_id, target, surface->resource_serial,
+        surface->last_write_generation, surface->last_write_kind,
+        surface->last_draw_generation, surface->last_clear_generation,
+        surface->last_copy_generation, surface->last_blit_generation,
+        surface->last_resolve_generation, surface->last_other_generation,
+        surface->last_guest_blit_generation,
+        surface->last_present_copy_generation,
+        g_ld_fifo_get, g_ld_fifo_put, g.cb_used, g.vb_used,
+        g.srv_ring_used,
+        (unsigned long long)g_ld_stats.groups_executed,
+        (unsigned long long)g_ld_stats.group_drop_ring,
+        (unsigned long long)g_ld_vertex_constant_ring_recycles,
+        g_ld_frame_vertex_constant_ring_recycles,
+        (unsigned long long)g_ld_last_dump_fingerprint,
+        nonblack == UINT64_MAX ? "unknown:" : "",
+        (unsigned long long)(nonblack == UINT64_MAX ? 0 : nonblack),
+        path);
+    fflush(stderr);
+}
