-      idx++; }
-    const u64 regs_hash = fnv1a(
-        g.rsx.regs, RSX_DSP_NUM_REGS * sizeof(g.rsx.regs[0]),
-        1469598103934665603ull);
-    const u64 vp_hash = fnv1a(
-        g.rsx.vp, sizeof(g.rsx.vp), 1469598103934665603ull);
-    const u64 const_hash = fnv1a(
