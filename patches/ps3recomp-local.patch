+s32 cellSpursQueuePopBody(u64 queue_ea, u64 buffer_ea, u32 isPeek, u32 isBlocking)
+{
+    /* Ported from libsre (NID 0x91066667); layout as _cellSpursQueueInitialize.
+     * Phase 1 takes the element: the pop word is set to ~pop ("pop in progress")
+     * once the queue is seen non-empty. Phase 2 stores pop+1 (or pop, for a peek)
+     * and, if the queue had been full while an SPU producer registered as waiting
+     * (+0x30 flag, +0x31 its task id), signals that task. Both are atomic on the
+     * queue's line against the SPU's GETLLAR/PUTLLC, so they run under the
+     * lock-line lock and drop SPU reservations on it.
+     * Deviation: an empty blocking pop polls instead of sleeping on the lv2 event
+     * queue cellSpursQueueAttachLv2EventQueue would create (that HLE creates
+     * none). The pop word is never left "in progress" while polling, so the SPU
+     * producer never tries to wake us through an event port. */
+    const uint32_t q = (uint32_t)queue_ea, dst = (uint32_t)buffer_ea;
+    if (!q || !dst)                 return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (q & 0x7F)                   return CELL_SPURS_TASK_ERROR_ALIGN;
+    if (vm_read32(q + 0x1C) != 1)   return CELL_SPURS_TASK_ERROR_PERM;   /* SPU2PPU only */
+    const int32_t depth = (int32_t)vm_read32(q + 0x0C);
+    const uint32_t size = vm_read32(q + 0x08);
+    const uint32_t buf  = (uint32_t)vm_read64(q + 0x10);
+    if (depth <= 0) return CELL_SPURS_TASK_ERROR_STAT;
+    { static int dbg = -1; static unsigned long n;   /* QUEUE_DBG=1: the call and the indices it sees */
+      if (dbg < 0) dbg = getenv("QUEUE_DBG") ? 1 : 0;
+      if (dbg && (n++ < 24 || n % 50000 == 0))
+          fprintf(stderr, "[queue] pop #%lu q=0x%08X peek=%u block=%u pop=0x%08X push=0x%08X\n", n, q,
+                  isPeek, isBlocking, vm_read32(q + 0x00), vm_read32(q + 0x04)); }
+
+    int32_t pop, slot;
+    /* Under the lock-line lock only raw guest accesses: vm_write32 takes that
+     * lock itself, and taking it twice deadlocked this thread the first time the
+     * queue was non-empty. ef_line_end drops SPU reservations and unlocks. */
+    for (;;) {
+        spu_lockline_lock();
+        pop = (int32_t)lfq_r32(q + 0x00);
+        if (pop < 0) { spu_lockline_unlock(); return CELL_SPURS_TASK_ERROR_BUSY; }
+        int32_t push = (int32_t)lfq_r32(q + 0x04);
