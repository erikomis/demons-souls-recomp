+/* Video format the graphics adapter reports (CellSailVideoFormat, 32 bytes):
+ * coding 1 = RGBA interleaved, 8 bits, 29.97 Hz, width/height at +4/+6 (what
+ * the title reads to size its texture), pitch, alpha, BT.709, square pixels. */
+static void sail_write_vfmt(SailPlayer2* p, u32 ea)
+{
+    SailDescriptor* d = sail_desc(p->desc_ea);
+    const int w = d ? d->mi.width : 1280, h = d ? d->mi.height : 720;
+    for (u32 i = 0; i < 32; i += 4) vm_write32(ea + i, 0xFFFFFFFFu);
+    vm_write8(ea + 0, 1); vm_write8(ea + 1, 0); vm_write8(ea + 2, 8); vm_write8(ea + 3, 3);
+    vm_write16(ea + 4, (u16)w); vm_write16(ea + 6, (u16)h);
+    vm_write32(ea + 8, (u32)w * 4); vm_write32(ea + 12, 0xFF);
+    vm_write8(ea + 16, 1); vm_write8(ea + 17, 1); vm_write8(ea + 18, 0);
