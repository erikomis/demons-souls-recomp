@@ -0,0 +1,95 @@
+/* rsx_tex_pack -- texture dumping and replacement ("texture packs") for the
+ * live draw engine.
+ *
+ * Every guest texture the renderer decodes has a content hash already (the
+ * texture cache uses it to notice rewrites). Mixed with the format, size and
+ * channel remap it names the texture as the game samples it, independent of
+ * where in memory the game happened to load it:
+ *
+ *   LD_TEX_DUMP=1   write each texture's base level, as sampled (remap
+ *                   applied), to <dir>\dump\<KEY>_<w>x<h>_<fmt>.png, once per
+ *                   key, plus a line in <dir>\dump\index.csv.
+ *   <dir>\replace   any .png or .dds whose file name starts with a KEY (sub
+ *                   folders are fine) is loaded in a background thread and
+ *                   drawn instead of that texture, at any resolution. On by
+ *                   default whenever the folder holds such files;
+ *                   LD_TEX_REPLACE=0 turns it off.
+ *   LD_TEX_DIR      <dir>, default "textures" (relative to the working
+ *                   directory).
+ *   LD_TEX_REPLACE_MB  GPU memory kept for loaded replacements no texture is
+ *                   using (default 4096); beyond it the least recently used
+ *                   are dropped and reloaded from disk when needed again.
+ *
+ * Only 2D textures in the formats below take part (no cubemaps, no 1D ramps,
+ * no float render-target copies). Replacements are drawn with no channel remap
+ * because the dump already has it applied; a BC4 file is drawn grey (R to RGB,
+ * alpha 1) like the one-channel dumps. BC5 is refused: it has no blue / alpha,
+ * so it cannot hold what a dump shows. A replacement larger than the guest
+ * texture gets a sampler whose LOD range reaches its extra mip levels
+ * (rsx_live_draw.c sampler_slot_tp).
+ *
+ * This file is the D3D-free half: file scan, key table, the worker threads
+ * that load PNG / DDS files and write dumps, a BC1-3 decoder for the dumps.
+ * The GPU upload and the texture cache hook live in rsx_live_draw.c. */
+#ifndef RSX_TEX_PACK_H
+#define RSX_TEX_PACK_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { TEXPACK_IDLE = 0, TEXPACK_QUEUED, TEXPACK_READY, TEXPACK_FAILED, TEXPACK_RESIDENT };
+
+#define TEXPACK_MAX_LEVELS 15
+
+typedef struct {
+    uint32_t dxgi;             /* DXGI_FORMAT value, *_SRGB already mapped to UNORM */
+    uint32_t w, h, n_levels;
+    uint32_t block;            /* bytes per 4x4 block for BC formats, 0 = 4 bytes per texel */
+    uint64_t bytes;            /* all levels, as loaded */
+    struct {
+        const uint8_t* data;
+        uint32_t w, h;         /* texels */
+        uint32_t row_bytes;    /* one row of texels, or of 4x4 blocks */
+        uint32_t rows;         /* rows of texels, or of blocks */
+    } lev[TEXPACK_MAX_LEVELS];
+} texpack_image;
+
+/* Decodes one guest texel to RGBA with the remap applied (rsx_live_draw.c's
+ * decode_texel); the dump worker calls it for the uncompressed formats. */
+typedef void (*texpack_texel_fn)(uint32_t base_fmt, const uint8_t* p, uint32_t remap, uint8_t d[4]);
+
+/* Lazy; safe to call every time. Nonzero when dumping or replacing is on. */
+int texpack_active(void);
+int texpack_dump_on(void);
+int texpack_replace_on(void);
+
+/* RSX base format (after ld_tex_base_fmt) -> 1 if it can be dumped / replaced. */
+int texpack_supported_fmt(uint32_t base_fmt);
+uint64_t texpack_key(uint64_t content_hash, uint32_t base_fmt, uint32_t w, uint32_t h, uint32_t remap);
+
+/* Dumping. texpack_dump_claim returns 1 the first time it sees a key. src is
+ * copied before texpack_dump returns: the level-0 bytes exactly as the guest
+ * laid them down (BC blocks, or swizzled / pitch-linear texels). */
+int texpack_dump_claim(uint64_t key);
+void texpack_dump(uint64_t key, uint32_t base_fmt, int linear, uint32_t w, uint32_t h,
+                  uint32_t pitch, uint32_t remap, uint32_t mips, uint32_t location,
+                  uint32_t offset, const uint8_t* src, uint32_t nbytes, texpack_texel_fn texel);
+
+/* Replacement table. Index -1 = no file for that key. */
+int texpack_find(uint64_t key);
+int texpack_count(void);                      /* table slots: every index is below this */
+const char* texpack_path(int idx);
+int texpack_state(int idx);
+void texpack_set_state(int idx, int state);   /* render thread: RESIDENT -> IDLE on eviction */
+void texpack_request(int idx);                 /* IDLE -> QUEUED, loads in the background */
+const texpack_image* texpack_image_get(int idx);   /* valid while READY */
+void texpack_image_release(int idx, int new_state); /* frees the CPU copy; READY -> new_state */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
