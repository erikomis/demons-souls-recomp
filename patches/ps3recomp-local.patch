+/* One past the highest slot ever used: shut-down tasksets stay marked, so the
+ * count stays non-zero and every SPU atomic paid a 64-entry volatile scan
+ * (6% of Demon's Souls' command-generation SPU thread). */
+static volatile int s_ts_down_hi = 0;
+static void spu_taskset_wake_all(void);         /* below, next to the signal lock */
+
+int spu_taskset_is_down(uint32_t ea)
+{
+    if (!ea || !g_spu_tasksets_down) return 0;
+    const int hi = s_ts_down_hi;
+    for (int i = 0; i < hi; i++) if (s_ts_down[i] == ea) return 1;
+    return 0;
+}
+
+void spu_taskset_shutdown(uint32_t ea)
+{
+    if (!ea || spu_taskset_is_down(ea)) return;
+    for (int i = 0; i < 64; i++)
+        if (!s_ts_down[i]) { s_ts_down[i] = ea; if (i + 1 > s_ts_down_hi) s_ts_down_hi = i + 1;
+                             g_spu_tasksets_down++; break; }
+    /* Release any of its tasks parked in WAIT_SIGNAL so they reach an atomic. */
+    spu_taskset_wake_all();
