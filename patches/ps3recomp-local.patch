+typedef enum {
+    LD_COMPACT_EXPAND_OK = 1,
+    LD_COMPACT_EXPAND_DEGENERATE = 0,
+    LD_COMPACT_EXPAND_ALLOC = -1,
+    LD_COMPACT_EXPAND_PRIMITIVE = -2
+} ld_compact_expand_result;
+
+static void compact_vertex_copy(
+    u8* destination, u32 destination_vertex, u32 source_vertex)
+{
+    if (!dc.layout.stride)
+        return;
+    memcpy(
+        destination + (u64)destination_vertex * dc.layout.stride,
+        dc.compact_verts + (u64)source_vertex * dc.layout.stride,
+        dc.layout.stride);
+}
+
+static ld_compact_expand_result expand_compact_topology(
+    u32 prim, u8** expanded, u32* expanded_vertices, int* owned)
+{
+    *expanded = dc.compact_verts;
+    *expanded_vertices = 0;
+    *owned = 0;
+    const u32 segment_count = dc.n_cuts + 1;
+    switch (prim) {
+    case PRIM_TRIANGLES:
+        *expanded_vertices = dc.n_verts - dc.n_verts % 3;
+        break;
+    case PRIM_TRIANGLE_STRIP: {
+        if (dc.n_verts < 3)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        u32 total = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count >= 3) total += (count - 2) * 3;
+        }
+        if (!total)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        *expanded_vertices = total;
+        if (!dc.layout.stride)
+            break;
+        *expanded = (u8*)malloc((size_t)total * dc.layout.stride);
+        if (!*expanded)
+            return LD_COMPACT_EXPAND_ALLOC;
+        *owned = 1;
+        u32 write = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 0; i + 2 < count; i++) {
+                if (i & 1) {
+                    compact_vertex_copy(*expanded, write++, begin + i + 1);
+                    compact_vertex_copy(*expanded, write++, begin + i);
+                    compact_vertex_copy(*expanded, write++, begin + i + 2);
+                } else {
+                    compact_vertex_copy(*expanded, write++, begin + i);
+                    compact_vertex_copy(*expanded, write++, begin + i + 1);
+                    compact_vertex_copy(*expanded, write++, begin + i + 2);
+                }
+            }
+        }
+        break;
+    }
+    case PRIM_TRIANGLE_FAN: {
+        if (dc.n_verts < 3)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        u32 total = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count >= 3) total += (count - 2) * 3;
+        }
+        if (!total)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        *expanded_vertices = total;
+        if (!dc.layout.stride)
+            break;
+        *expanded = (u8*)malloc((size_t)total * dc.layout.stride);
+        if (!*expanded)
+            return LD_COMPACT_EXPAND_ALLOC;
+        *owned = 1;
+        u32 write = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 1; i + 1 < count; i++) {
+                compact_vertex_copy(*expanded, write++, begin);
+                compact_vertex_copy(*expanded, write++, begin + i);
+                compact_vertex_copy(*expanded, write++, begin + i + 1);
+            }
+        }
+        break;
+    }
+    case PRIM_QUADS: {
+        const u32 quads = dc.n_verts / 4;
+        if (!quads)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        *expanded_vertices = quads * 6;
+        if (!dc.layout.stride)
+            break;
+        *expanded = (u8*)malloc(
+            (size_t)*expanded_vertices * dc.layout.stride);
+        if (!*expanded)
+            return LD_COMPACT_EXPAND_ALLOC;
+        *owned = 1;
+        u32 write = 0;
+        for (u32 quad = 0; quad < quads; quad++) {
+            const u32 base = quad * 4;
+            compact_vertex_copy(*expanded, write++, base);
+            compact_vertex_copy(*expanded, write++, base + 1);
+            compact_vertex_copy(*expanded, write++, base + 2);
+            compact_vertex_copy(*expanded, write++, base + 2);
+            compact_vertex_copy(*expanded, write++, base + 3);
+            compact_vertex_copy(*expanded, write++, base);
+        }
+        break;
+    }
+    default:
+        return LD_COMPACT_EXPAND_PRIMITIVE;
+    }
+    return *expanded_vertices
+        ? LD_COMPACT_EXPAND_OK : LD_COMPACT_EXPAND_DEGENERATE;
+}
+
+static u32 topology_index_count(u32 prim)
+{
+    const u32 segment_count = dc.n_cuts + 1;
+    switch (prim) {
+    case PRIM_TRIANGLES:
+        return dc.n_source_refs - dc.n_source_refs % 3u;
+    case PRIM_TRIANGLE_STRIP:
+    case PRIM_TRIANGLE_FAN: {
+        u32 total = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_source_refs,
+                segment, &begin, &count);
+            (void)begin;
+            if (count >= 3) total += (count - 2) * 3;
+        }
+        return total;
+    }
+    case PRIM_QUADS:
+        return (dc.n_source_refs / 4) * 6;
+    default:
+        return 0;
+    }
+}
+
+static u32 topology_vertex_index(u32 occurrence)
+{
+    return dc.refs_remapped
+        ? rsx_vertex_remap_index(&dc.ref_remap, occurrence)
+        : occurrence;
+}
+
+static void write_topology_indices(u32 prim, u32* indices)
+{
+    u32 write = 0;
+    const u32 segment_count = dc.n_cuts + 1;
+    switch (prim) {
+    case PRIM_TRIANGLES: {
+        const u32 count =
+            dc.n_source_refs - dc.n_source_refs % 3u;
+        for (u32 occurrence = 0; occurrence < count; occurrence++)
+            indices[write++] = topology_vertex_index(occurrence);
+        break;
+    }
+    case PRIM_TRIANGLE_STRIP:
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_source_refs,
+                segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 0; i + 2 < count; i++) {
+                indices[write++] = topology_vertex_index(
+                    begin + i + (i & 1u));
+                indices[write++] = topology_vertex_index(
+                    begin + i + 1u - (i & 1u));
+                indices[write++] = topology_vertex_index(begin + i + 2u);
+            }
+        }
+        break;
+    case PRIM_TRIANGLE_FAN:
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_source_refs,
+                segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 1; i + 1 < count; i++) {
+                indices[write++] = topology_vertex_index(begin);
+                indices[write++] = topology_vertex_index(begin + i);
+                indices[write++] = topology_vertex_index(begin + i + 1u);
+            }
+        }
+        break;
+    case PRIM_QUADS:
+        for (u32 quad = 0; quad < dc.n_source_refs / 4; quad++) {
+            const u32 base = quad * 4;
+            indices[write++] = topology_vertex_index(base);
+            indices[write++] = topology_vertex_index(base + 1u);
+            indices[write++] = topology_vertex_index(base + 2u);
+            indices[write++] = topology_vertex_index(base + 2u);
+            indices[write++] = topology_vertex_index(base + 3u);
+            indices[write++] = topology_vertex_index(base);
+        }
+        break;
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Converted-vertex cache (LD_VCACHE=0 turns it off).
+ *
+ * Most of a frame's draws are static meshes whose guest vertex and index bytes
+ * do not change from frame to frame, yet every draw re-gathered its indices,
+ * de-duplicated them and decoded every attribute of every vertex to floats --
+ * about half of the RSX thread's time in Demon's Souls. A draw is described
+ * by its key (attribute registers, bases, batches, primitive, restart rule and
+ * the index bytes themselves); a hit re-hashes the guest vertex ranges the
+ * converted copy was made from and, when they are unchanged, uploads the
+ * stored vertices and topology indices instead of converting again.
+ * -----------------------------------------------------------------------*/
+#define LD_VC_SLOTS      8192u
+#define LD_VC_MAX_RANGES 16u
+#define LD_VC_BUDGET     (384ull << 20)
+typedef struct {
+    u64 key, src_hash;
+    const u8* range_p[LD_VC_MAX_RANGES];
+    u32 range_n[LD_VC_MAX_RANGES];
+    u32 n_ranges;
+    u32 n_verts, n_source_refs, n_tri, indexed, stride;
+    u8* verts;          /* n_verts * stride bytes, then n_tri u32 indices */
+    u64 bytes;
+    u32 last_frame;
+    u32 vca_off;        /* gpu: offset of verts in the GPU-visible arena */
+    u8 vca_cls, gpu;    /* gpu: verts live in the arena (write-only, never read back) */
+    u8 stable;          /* consecutive full source checks that found no change */
+    u32 checked_frame;  /* frame of the last source check (1-based; 0 = never) */
+    u64 sample_hash;    /* ld_vc_sample_hash at the last full check */
+} ld_vc_entry;
+static ld_vc_entry* g_ld_vc;
+static u64 g_ld_vc_bytes;
+static u64 g_ld_vc_hits, g_ld_vc_misses, g_ld_vc_stale, g_ld_vc_skips;
+
+/* GPU-visible home for the converted-vertex cache (LD_VC_GPU=0 = off).
+ * A hit used to memcpy the stored vertices and indices into the per-frame
+ * upload ring again -- ~46 MB a frame by the Boletaria 1-1 scaffolding, the
+ * largest single cost of the renderer thread there (NOTES fix 48). Now a
+ * cached draw's converted data is written once, into this persistently mapped
+ * upload-heap buffer, and the draw binds it in place. The ring is upload heap
+ * too, so the GPU reads the same memory type as before.
+ * Blocks are power-of-two classes (256 B .. 16 MB) carved from a bump pointer;
+ * a larger free block is split when a class is empty. A freed block may still
+ * be read by submitted or recorded work, so it waits in a pending list until
+ * the fence covering everything recorded at the time of the free completes. */
+#define LD_VCA_SIZE      (256ull << 20)
+#define LD_VCA_MIN_SHIFT 8u
+#define LD_VCA_CLASSES   17u          /* 2^8 .. 2^24 */
+#define LD_VCA_PENDING   16384u
+static ID3D12Resource* g_vca;
+static u8* g_vca_map;
+static u64 g_vca_gpu, g_vca_bump;
+static u32* g_vca_free[LD_VCA_CLASSES];
+static u32 g_vca_nfree[LD_VCA_CLASSES], g_vca_capfree[LD_VCA_CLASSES];
+static struct { u64 fence; u32 off; u32 cls; } g_vca_pend[LD_VCA_PENDING];
+static u32 g_vca_ph, g_vca_pt;       /* pending ring head / tail */
+static u64 g_vca_fails;
+
+static int ld_vca_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_VC_GPU");
+        on = (e && e[0] == '0') ? 0 : 1;
+        if (on && g.dev) {
+            D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+            D3D12_RESOURCE_DESC bd = {0};
+            bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = LD_VCA_SIZE;
+            bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+            bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+            bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            D3D12_RANGE rr = {0, 0};
+            if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                           D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&g_vca)) ||
+                FAILED(g_vca->lpVtbl->Map(g_vca, 0, &rr, (void**)&g_vca_map))) {
+                if (g_vca) g_vca->lpVtbl->Release(g_vca);
+                g_vca = NULL; g_vca_map = NULL;
+            }
+        }
+        if (!g_vca) on = 0;
+        else g_vca_gpu = g_vca->lpVtbl->GetGPUVirtualAddress(g_vca);
+        fprintf(stderr, "[vcache] GPU-resident arena %s\n", on ? "on (256 MB)" : "off");
+    }
+    return on;
+}
+
+static void ld_vc_free(ld_vc_entry* e);
+
+static void ld_vca_push_free(u32 cls, u32 off)
+{
+    if (g_vca_nfree[cls] == g_vca_capfree[cls]) {
+        const u32 cap = g_vca_capfree[cls] ? g_vca_capfree[cls] * 2u : 256u;
+        u32* n = (u32*)realloc(g_vca_free[cls], cap * sizeof(u32));
+        if (!n) return;   /* leaks the block; harmless */
+        g_vca_free[cls] = n; g_vca_capfree[cls] = cap;
+    }
+    g_vca_free[cls][g_vca_nfree[cls]++] = off;
+}
+
+/* Move pending frees whose fence has completed onto the free lists. */
+static void ld_vca_reclaim(void)
+{
+    if (g_vca_pt == g_vca_ph) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    while (g_vca_pt != g_vca_ph && g_vca_pend[g_vca_pt % LD_VCA_PENDING].fence <= done) {
+        const u32 i = g_vca_pt % LD_VCA_PENDING;
+        ld_vca_push_free(g_vca_pend[i].cls, g_vca_pend[i].off);
+        g_vca_pt++;
+    }
+}
+
+/* A block of at least `bytes`; 0 = none (the caller falls back to malloc). */
+static int ld_vca_alloc(u64 bytes, u32* off, u32* cls_out)
+{
+    u32 cls = 0;
+    while (cls < LD_VCA_CLASSES && (1ull << (cls + LD_VCA_MIN_SHIFT)) < bytes) cls++;
+    if (cls >= LD_VCA_CLASSES) return 0;
+    ld_vca_reclaim();
+    if (g_vca_nfree[cls]) {
+        *off = g_vca_free[cls][--g_vca_nfree[cls]];
+        *cls_out = cls;
+        return 1;
+    }
+    const u64 sz = 1ull << (cls + LD_VCA_MIN_SHIFT);
+    if (g_vca_bump + sz <= LD_VCA_SIZE) {
+        *off = (u32)g_vca_bump;
+        g_vca_bump += sz;
+        *cls_out = cls;
+        return 1;
+    }
+    for (u32 c = cls + 1; c < LD_VCA_CLASSES; c++) {
+        if (!g_vca_nfree[c]) continue;
+        u32 o = g_vca_free[c][--g_vca_nfree[c]];
+        while (c > cls) {   /* split: keep the low half, free the high half */
+            c--;
+            ld_vca_push_free(c, o + (u32)(1ull << (c + LD_VCA_MIN_SHIFT)));
+        }
+        *off = o;
+        *cls_out = cls;
+        return 1;
+    }
+    /* Full: drop the arena entries not drawn in the last few frames. Their
+     * blocks come back once the GPU is past them; this draw uses malloc. */
+    g_vca_fails++;
+    for (u32 i = 0; i < LD_VC_SLOTS; i++)
+        if (g_ld_vc[i].verts && g_ld_vc[i].gpu && g_ld_vc[i].last_frame + 4 < g_ld_frames)
+            ld_vc_free(&g_ld_vc[i]);
+    return 0;
+}
+
+static void ld_vca_release(u32 cls, u32 off)
+{
+    if (g_vca_ph - g_vca_pt >= LD_VCA_PENDING) {
+        ld_vca_reclaim();
+        if (g_vca_ph - g_vca_pt >= LD_VCA_PENDING) return;   /* leak rather than reuse early */
+    }
+    const u32 i = g_vca_ph % LD_VCA_PENDING;
+    g_vca_pend[i].fence = g.fence_value + 1u;   /* covers everything recorded so far */
+    g_vca_pend[i].off = off;
+    g_vca_pend[i].cls = cls;
+    g_vca_ph++;
+}
+
+static int ld_vc_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_VCACHE");
+        /* The draw CSV and its vertex dumps read dc's converted vertices,
+         * which a hit never fills. */
+        on = (e && e[0] == '0') || getenv("RSX_DRAW_CSV") ? 0 : 1;
+        if (on) g_ld_vc = (ld_vc_entry*)calloc(LD_VC_SLOTS, sizeof(ld_vc_entry));
+        if (!g_ld_vc) on = 0;
+        fprintf(stderr, "[vcache] converted-vertex cache %s\n", on ? "on" : "off");
+    }
+    return on;
+}
+
+static inline u64 ld_vc_rotl(u64 x, int r) { return (x << r) | (x >> (64 - r)); }
+
+/* Mutation detector over guest bytes: four independent multiply lanes so
+ * the loop runs at memory speed rather than one multiply's latency. */
+static u64 ld_vc_hash(const u8* p, size_t n, u64 seed)
+{
+    const u64 P1 = 0x9E3779B185EBCA87ull, P2 = 0xC2B2AE3D27D4EB4Full;
+    u64 a = seed ^ P1, b = seed + P2, c = ld_vc_rotl(seed, 17) ^ P2,
+        d = seed * P1 + 1;
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        u64 w[4];
+        memcpy(w, p + i, 32);
+        a = ld_vc_rotl(a ^ w[0], 29) * P1;
+        b = ld_vc_rotl(b ^ w[1], 29) * P1;
+        c = ld_vc_rotl(c ^ w[2], 29) * P1;
+        d = ld_vc_rotl(d ^ w[3], 29) * P1;
+    }
+    u64 h = ld_vc_rotl(a, 1) + ld_vc_rotl(b, 7) + ld_vc_rotl(c, 12) +
+            ld_vc_rotl(d, 18) + (u64)n * P2;
+    for (; i + 8 <= n; i += 8) {
+        u64 w;
+        memcpy(&w, p + i, 8);
+        h = ld_vc_rotl(h ^ (w * P2), 31) * P1;
+    }
+    for (; i < n; i++)
+        h = (h ^ p[i]) * P1;
+    h ^= h >> 33; h *= P2; h ^= h >> 29;
+    return h;
+}
+
+/* The draw's key, or 0 when this draw must not be cached (inline vertices,
+ * unreadable indices). */
+static u64 ld_vc_key(u32 prim, const rsx_vertex_layout_plan* layout)
+{
+    if (dc.inl || (!dc.n_arr && !dc.n_idx))
+        return 0;
+    /* The slot layout is a pure function of the mask. */
+    u64 h = ld_vc_hash((const u8*)&layout->mask, sizeof(layout->mask), prim);
+    struct {
+        u32 base_offset, base_index, divider, restart_en, restart_val;
+        u32 n_arr, n_idx;
+        rsx_dsp_index_array ia;
+    } hdr;
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.base_offset = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    hdr.base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+    hdr.divider = rsx_dsp_reg(&g.rsx, 0x1FC0);
+    hdr.n_arr = dc.n_arr;
+    hdr.n_idx = dc.n_idx;
+    if (dc.n_idx) {
+        rsx_dsp_get_index_array(&g.rsx, &hdr.ia);
+        static int no_restart = -1;
+        if (no_restart < 0) no_restart = getenv("RSX_NO_RESTART") ? 1 : 0;
+        hdr.restart_en = !no_restart &&
+            rsx_dsp_restart_index_enabled(&g.rsx, hdr.ia.is_u32);
+        hdr.restart_val = rsx_dsp_restart_index(&g.rsx);
+    }
+    h = ld_vc_hash((const u8*)&hdr, sizeof(hdr), h);
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        struct { rsx_dsp_vertex_attr a; float def[4]; } at;
+        memset(&at, 0, sizeof(at));
+        rsx_dsp_get_vertex_attr(&g.rsx, layout->attrs[slot], &at.a);
+        rsx_dsp_vertex_default(&g.rsx, layout->attrs[slot], at.def);
+        h = ld_vc_hash((const u8*)&at, sizeof(at), h);
+    }
+    if (dc.n_arr)
+        h = ld_vc_hash((const u8*)dc.arr, (size_t)dc.n_arr * sizeof(dc.arr[0]), h);
+    if (dc.n_idx) {
+        h = ld_vc_hash((const u8*)dc.idx, (size_t)dc.n_idx * sizeof(dc.idx[0]), h);
+        const u32 esz = hdr.ia.is_u32 ? 4u : 2u;
+        for (u32 r = 0; r < dc.n_idx; r++) {
+            const u64 start = (u64)hdr.ia.offset + (u64)dc.idx[r].first * esz;
+            const u64 bytes = (u64)dc.idx[r].count * esz;
+            if (!bytes) continue;
+            if (start + bytes > 0x100000000ull) return 0;
+            const u8* ip = guest_ptr(hdr.ia.location, (u32)start, (u32)bytes);
+            if (!ip) return 0;
+            g_rs_key_b += bytes;
+            h = ld_vc_hash(ip, (size_t)bytes, h);
+        }
+    }
+    return h ? h : 1;
+}
+
+static u64 ld_vc_src_hash(const ld_vc_entry* e)
+{
+    u64 h = 0x51ED270B27F3A4C1ull;
+    for (u32 i = 0; i < e->n_ranges; i++) {
+        g_rs_src_b += e->range_n[i];
+        h = ld_vc_hash(e->range_p[i], e->range_n[i], h);
+    }
+    return h;
+}
+
+/* Sparse probe of the source ranges: ranges up to 4 KB in full, longer ones
+ * 32 bytes out of every 1 KB plus their last 32. */
+static u64 ld_vc_sample_hash(const ld_vc_entry* e)
+{
+    u64 h = 0x2545F4914F6CDD1Dull;
+    for (u32 i = 0; i < e->n_ranges; i++) {
+        const u8* p = e->range_p[i];
+        const u32 n = e->range_n[i];
+        if (n <= 4096u) { h = ld_vc_hash(p, n, h); continue; }
+        for (u32 o = 0; o + 32 <= n; o += 1024) h = ld_vc_hash(p + o, 32, h);
+        h = ld_vc_hash(p + n - 32, 32, h);
+        g_rs_src_b += n / 32;
+    }
+    return h;
+}
+
+/* LD_VC_HASH_EVERY=1: re-hash a cached draw's whole source on every draw, as
+ * before NOTES fix 48. Default: once per frame per entry (later draws of the
+ * same key in the frame reuse the answer), and an entry unchanged for 8 checks
+ * gets the sparse probe, with a full check every 16th frame (staggered by
+ * slot); a probe mismatch checks in full at once. Vertex data that keeps
+ * changing (CPU skinning, particles) stays on full checks. */
+static int ld_vc_adaptive(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_VC_HASH_EVERY"); on = (e && e[0] == '1') ? 0 : 1; }
+    return on;
+}
+
+/* The guest ranges the fetch plan just read, merged where attributes
+ * interleave in one buffer. 0 when some attribute was not read from one
+ * stable range (it took the per-vertex fallback), so the draw is not cached. */
+static int ld_vc_collect_ranges(ld_vc_entry* e)
+{
+    e->n_ranges = 0;
+    for (u32 slot = 0; slot < dc.layout.count; slot++) {
+        const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[dc.layout.attrs[slot]];
+        if (!f->desc.type || !f->desc.size)
+            continue;
+        if (!f->stable_base || !f->elem_size)
+            return 0;
+        const u64 len = (u64)(f->stable_last - f->stable_first) * f->stride + f->elem_size;
+        if (len > UINT32_MAX)
+            return 0;
+        const u8* p = f->stable_base;
+        const u8* q = p + len;
+        u32 k = 0;
+        for (; k < e->n_ranges; k++) {
+            const u8* rp = e->range_p[k];
+            const u8* rq = rp + e->range_n[k];
+            if (p <= rq && rp <= q) {   /* overlap or touch: merge */
+                const u8* np = p < rp ? p : rp;
+                const u8* nq = q > rq ? q : rq;
+                e->range_p[k] = np;
+                e->range_n[k] = (u32)(nq - np);
+                break;
+            }
+        }
+        if (k == e->n_ranges) {
+            if (e->n_ranges >= LD_VC_MAX_RANGES)
+                return 0;
+            e->range_p[e->n_ranges] = p;
+            e->range_n[e->n_ranges] = (u32)len;
+            e->n_ranges++;
+        }
+    }
+    return 1;
+}
+
+static void ld_vc_free(ld_vc_entry* e)
+{
+    if (e->gpu) ld_vca_release(e->vca_cls, e->vca_off);
+    else free(e->verts);
+    g_ld_vc_bytes -= e->bytes;
+    memset(e, 0, sizeof(*e));
+}
+
+/* Over budget: drop everything not drawn in the last few frames. */
+static void ld_vc_trim(void)
+{
+    if (g_ld_vc_bytes <= LD_VC_BUDGET)
+        return;
+    for (u32 i = 0; i < LD_VC_SLOTS; i++)
+        if (g_ld_vc[i].verts && g_ld_vc[i].last_frame + 4 < g_ld_frames)
+            ld_vc_free(&g_ld_vc[i]);
+    if (g_ld_vc_bytes > LD_VC_BUDGET)
+        for (u32 i = 0; i < LD_VC_SLOTS; i++)
+            if (g_ld_vc[i].verts && g_ld_vc[i].last_frame != g_ld_frames)
+                ld_vc_free(&g_ld_vc[i]);
+}
+
+static void ld_vc_stats_frame(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_VCACHE_STATS") ? 1 : 0;
+    if (!on || !g_ld_vc || (g_ld_frames % 300) != 0)
+        return;
+    fprintf(stderr, "[vcache] frame %u: %llu hits, %llu misses, %llu stale, %llu uncacheable, %.1f MB\n",
+            g_ld_frames, (unsigned long long)g_ld_vc_hits, (unsigned long long)g_ld_vc_misses,
+            (unsigned long long)g_ld_vc_stale, (unsigned long long)g_ld_vc_skips,
+            (double)g_ld_vc_bytes / 1048576.0);
+    g_ld_vc_hits = g_ld_vc_misses = g_ld_vc_stale = g_ld_vc_skips = 0;
+}
+
+static void ld_rstats_frame(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_RSTATS") ? 1 : 0;
+    if (!on || (g_ld_frames % 300) != 0)
+        return;
+    const double f = 300.0, mb = 1048576.0;
+    fprintf(stderr, "[rstats] frame %u per frame: %.0f draws, index hash %.2f MB, vertex-src hash %.2f MB, "
+                    "ring copy %.2f MB, %.0f textures hashed %.2f MB, %u textures cached, vc %llu hit %llu miss %llu stale %llu skip, "
+                    "vc %.1f MB, arena bump %.1f MB, %llu arena fails; misses into empty %llu / live %llu / old %llu slots\n",
+            g_ld_frames, g_rs_draws / f, g_rs_key_b / f / mb, g_rs_src_b / f / mb, g_rs_copy_b / f / mb,
+            g_rs_tex_n / f, g_rs_tex_b / f / mb, g.n_textures,
+            (unsigned long long)g_ld_vc_hits, (unsigned long long)g_ld_vc_misses,
+            (unsigned long long)g_ld_vc_stale, (unsigned long long)g_ld_vc_skips,
+            g_ld_vc_bytes / mb, g_vca_bump / mb, (unsigned long long)g_vca_fails,
+            (unsigned long long)g_rs_miss_empty, (unsigned long long)g_rs_miss_live, (unsigned long long)g_rs_miss_old);
+    g_rs_miss_empty = g_rs_miss_live = g_rs_miss_old = 0;
+    g_rs_draws =g_rs_key_b = g_rs_src_b = g_rs_copy_b = g_rs_tex_b = g_rs_tex_n = 0;
+    g_ld_vc_hits = g_ld_vc_misses = g_ld_vc_stale = g_ld_vc_skips = 0;
+}
+
+static void sink_end_impl(void* user, const rsx_dispatch* r)
+{
+    (void)user; (void)r;
+    if (g_ld_movie_mode && !ld_movie_composite_ui_enabled()) return;
+    if (!dc.n_packets) { g_ld_stats.groups_empty++; return; }
+    g_ld_stats.groups_seen++;
+    /*
+     * a010's native per-mesh constant builder can overwrite the otherwise
+     * valid reconstructed camera with NaNs after the ordinary camera upload.
+     * Repair at the last measured boundary, immediately before the draw
+     * consumes the constants. Once the synchronized a010 reference is armed,
+     * replace finite-but-wrong native uploads too: the measured failure
+     * matrix is finite, yet projects the model thousands of pixels offscreen.
+     */
+    if (InterlockedCompareExchange(&g_ld_a010_camera_ready, 0, 0) != 0) {
+        int camera_has_nan = 0;
+        for (u32 slot = 108; slot <= 111 && !camera_has_nan; slot++)
+            for (u32 lane = 0; lane < 4; lane++) {
+                const u32 bits = g.rsx.constants[slot][lane];
+                if ((bits & 0x7F800000u) == 0x7F800000u &&
+                    (bits & 0x007FFFFFu) != 0) {
+                    camera_has_nan = 1;
+                    break;
+                }
+            }
+        if (camera_has_nan || g_yz_runtime_config.a010_start_reference ||
+            InterlockedCompareExchange(
+                &g_yz_a010_reference_camera_active, 0, 0) != 0) {
+            for (u32 i = 0; i < 16; i++)
+                g.rsx.constants[108 + i / 4][i % 4] =
+                    g_ld_a010_camera_bits[i];
+            static u64 repairs = 0;
+            repairs++;
+            if (repairs <= 16 || (repairs & (repairs - 1)) == 0) {
+                fprintf(stderr,
+                        "[a010-rsx-camera-repair] n=%llu frame=%u "
+                        "c108=%08X/%08X/%08X/%08X\n",
+                        (unsigned long long)repairs, g_ld_frames,
+                        g.rsx.constants[108][0], g.rsx.constants[108][1],
+                        g.rsx.constants[108][2], g.rsx.constants[108][3]);
+                fflush(stderr);
+            }
+        }
+    }
+    /* A polygon is a convex fan around its first vertex -- what the register-
+     * file engine (rsx_draw_engine.c) and the null backend already make of one.
+     * Left unmapped it was dropped outright: Twisted Metal's legal screens
+     * submit 16-vertex polygons. */
+    const u32 prim = g.rsx.current_primitive == 10u /* POLYGON */
+        ? PRIM_TRIANGLE_FAN : g.rsx.current_primitive;
+    rsx_vertex_layout_plan used_layout;
+    ld_current_vertex_layout(&used_layout);
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.used_attribute_draws++;
+    g_ld_profile.total.used_attribute_sum += used_layout.count;
+    if (used_layout.count > g_ld_profile.frame_used_attribute_max)
+        g_ld_profile.frame_used_attribute_max = used_layout.count;
+    if (used_layout.count > g_ld_profile.total_used_attribute_max)
+        g_ld_profile.total_used_attribute_max = used_layout.count;
+    const LONGLONG fetch_pack_begin = ld_profile_qpc();
+#endif
+    ld_vc_entry* vc_hit = NULL;
+    ld_vc_entry* vc_slot = NULL;
+    u64 vc_key = 0;
+    if (ld_vertex_compact_payload() && ld_vc_enabled()) {
+        vc_key = ld_vc_key(prim, &used_layout);
+        if (vc_key) {
+            ld_vc_entry* e = &g_ld_vc[vc_key & (LD_VC_SLOTS - 1u)];
+            vc_slot = e;
+            if (e->verts && e->key == vc_key && e->stride == used_layout.stride) {
+                const u32 slot = (u32)(vc_key & (LD_VC_SLOTS - 1u));
+                if (ld_vc_adaptive() && e->checked_frame == g_ld_frames + 1u)
+                    vc_hit = e;   /* already checked this frame */
+                else if (ld_vc_adaptive() && e->stable >= 8u &&
+                         ((g_ld_frames + slot) & 15u) != 0 &&
+                         ld_vc_sample_hash(e) == e->sample_hash) {
+                    vc_hit = e;
+                    e->checked_frame = g_ld_frames + 1u;
+                } else if (ld_vc_src_hash(e) == e->src_hash) {
+                    vc_hit = e;
+                    e->checked_frame = g_ld_frames + 1u;
+                    if (e->stable < 255u) e->stable++;
+                    e->sample_hash = ld_vc_sample_hash(e);
+                } else {
+                    e->stable = 0;
+                    g_ld_vc_stale++;
+                }
+            } else {
+                g_ld_vc_misses++;
+                if (!e->verts) g_rs_miss_empty++;
+                else if (e->last_frame + 1u >= g_ld_frames) g_rs_miss_live++;
+                else g_rs_miss_old++;
+            }
+        } else {
+            g_ld_vc_skips++;
+        }
+    }
+    if (vc_hit) {
+        g_ld_vc_hits++;
+        vc_hit->last_frame = g_ld_frames;
+        dc.n_verts = vc_hit->n_verts;
+        dc.n_source_refs = vc_hit->n_source_refs;
+    } else if (ld_vertex_compact_payload()) {
+        fetch_batches_hoisted(&used_layout, 1);
+    } else if (ld_vertex_hoist_fetch()) {
+        rsx_vertex_layout_plan legacy_layout;
+        ld_layout_plan_get(0xFFFFu, &legacy_layout);
+        fetch_batches_hoisted(&legacy_layout, 0);
+    } else {
+        fetch_batches();
+    }
+    if (!dc.n_source_refs)
+        dc.n_source_refs = dc.n_verts;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.vertex_fetch_pack_qpc +=
+        (u64)(ld_profile_qpc() - fetch_pack_begin);
+#endif
+    if (!dc.n_verts || !dc.fetch_ok) { g_ld_stats.group_drop_fetch++; return; }
+
+    /* Preserve validated occurrence order while allowing repeated compact
+     * vertex references to share one fetched and uploaded payload. */
+    int indexed = 0;
+    if (vc_hit) {
+        indexed = (int)vc_hit->indexed;
+    } else if (!rsx_vertex_topology_plan(prim, dc.refs_remapped, &indexed)) {
+        g_ld_stats.group_drop_primitive++;
+        return;
+    }
+    u32 n_tri = vc_hit ? vc_hit->n_tri : indexed
+        ? topology_index_count(prim)
+        : dc.n_source_refs - dc.n_source_refs % 3;
+
+    if (!n_tri) {
+        g_ld_stats.group_drop_degenerate++;
+        return;
+    }
+
+    live_a010_geom_trace(prim, n_tri);
+
+    const u32 vertex_stride =
+        ld_vertex_compact_payload() ? used_layout.stride : VERT_STRIDE;
+    const u32 uploaded_vertices = indexed ? dc.n_verts : n_tri;
+    const void* vertex_data = vc_hit ? (const void*)vc_hit->verts
+        : ld_vertex_compact_payload()
+        ? (const void*)dc.compact_verts : (const void*)dc.verts;
+    const u64 draw_vb_bytes = (u64)uploaded_vertices * vertex_stride;
+    const u64 draw_ib_bytes = indexed ? (u64)n_tri * sizeof(u32) : 0;
+    /* A miss on a cacheable draw keeps its converted vertices and topology
+     * indices (written here rather than read back out of the write-combined
+     * upload ring). */
+    const u32* vc_indices = vc_hit ? (const u32*)(vc_hit->verts + draw_vb_bytes) : NULL;
+    /* Non-zero: this draw binds its vertices / indices in place in the
+     * GPU-resident vertex-cache arena and skips the upload ring. */
+    u64 vca_vb = 0, vca_ib = 0;
+    if (vc_hit && vc_hit->gpu) {
+        vca_vb = g_vca_gpu + vc_hit->vca_off;
+        vca_ib = vca_vb + ((draw_vb_bytes + 15u) & ~15ull);
+        vc_indices = NULL;   /* write-combined: never read back */
+    }
+    if (!vc_hit && vc_slot && draw_vb_bytes + draw_ib_bytes <= (16u << 20)) {
+        ld_vc_entry fresh;
+        memset(&fresh, 0, sizeof(fresh));
+        if (ld_vc_collect_ranges(&fresh)) {
+            u32 a_off = 0, a_cls = 0;
+            /* In the arena the indices start 16-byte aligned (an index
+             * buffer view must be aligned to its 4-byte format). */
+            const u64 a_ib_at = (draw_vb_bytes + 15u) & ~15ull;
+            const int in_arena = ld_vca_enabled() &&
+                ld_vca_alloc(a_ib_at + draw_ib_bytes, &a_off, &a_cls);
+            const u64 ib_at = in_arena ? a_ib_at : draw_vb_bytes;
+            u8* mem = in_arena ? g_vca_map + a_off
+                               : (u8*)malloc((size_t)(draw_vb_bytes + draw_ib_bytes));
+            if (mem) {
+                if (in_arena) {
+                    fresh.gpu = 1;
+                    fresh.vca_off = a_off;
+                    fresh.vca_cls = (u8)a_cls;
+                }
+                if (vc_slot->verts) ld_vc_free(vc_slot);
+                memcpy(mem, vertex_data, (size_t)draw_vb_bytes);
+                if (indexed)
+                    write_topology_indices(prim, (u32*)(mem + ib_at));
+                fresh.key = vc_key;
+                fresh.src_hash = ld_vc_src_hash(&fresh);
+                fresh.n_verts = dc.n_verts;
+                fresh.n_source_refs = dc.n_source_refs;
+                fresh.n_tri = n_tri;
+                fresh.indexed = (u32)indexed;
+                fresh.stride = used_layout.stride;
+                fresh.verts = mem;
+                fresh.bytes = in_arena ? 1ull << (a_cls + LD_VCA_MIN_SHIFT)
+                                       : draw_vb_bytes + draw_ib_bytes;
+                fresh.last_frame = g_ld_frames;
+                *vc_slot = fresh;
+                g_ld_vc_bytes += fresh.bytes;
+                if (in_arena) {
+                    vca_vb = g_vca_gpu + a_off;
+                    vca_ib = vca_vb + ib_at;
+                    vc_indices = NULL;
+                } else {
+                    vc_indices = (const u32*)(mem + draw_vb_bytes);
+                }
+                ld_vc_trim();
+            }
+        } else {
+            g_ld_vc_skips++;
+        }
+    }
+    const u64 vb_capacity = VERT_BUFFER_SIZE;
+    if (vca_vb) {
+        /* In place in the arena: nothing to copy into the rings. */
+    } else if (draw_vb_bytes > vb_capacity || draw_ib_bytes > INDEX_BUFFER_SIZE) {
+        live_draw_csv_emit(prim, n_tri, "drop_vbring_oversize");
+        g_ld_stats.group_drop_ring++;
+        return;
+    }
+    g_rs_draws++;
+    g_ld_frame_draws++;
+    if (!vca_vb) {
+    if ((u64)g.vb_used + draw_vb_bytes > vb_capacity ||
+        (u64)g.ib_used + draw_ib_bytes > INDEX_BUFFER_SIZE) {
+        /*
+         * The replay-proven renderer recycles this upload ring mid-frame.
+         * Live used to drop every remaining draw instead, which discarded
+         * 181/184 sampled a010 groups after the orphanage workload filled the
+         * 256K-vertex ring.  We are still before this draw's memcpy, so it is
+         * safe to submit/wait and reuse every transient draw ring here.
+         */
+        ld_flush(LD_FLUSH_VERTEX_RING);
+        g.vb_used = 0;
+        g.ib_used = 0;
+        g.cb_used = 0;
+        g.ps_cb_used = 0;
+        g.srv_ring_used = 0;
+        g.smp_ring_used = 0;
+    }
+    g_rs_copy_b += draw_vb_bytes + draw_ib_bytes;
+    if (draw_vb_bytes)
+        memcpy(
+            g.vb_mapped + g.vb_used, vertex_data,
+            (size_t)draw_vb_bytes);
+    if (indexed && vc_indices)
+        memcpy((u8*)g.ib_mapped + g.ib_used, vc_indices, (size_t)draw_ib_bytes);
+    else if (indexed)
+        write_topology_indices(
+            prim, (u32*)((u8*)g.ib_mapped + g.ib_used));
+    }
+
+    g_ld_draw_nverts = dc.n_verts;   /* LD_FPCONST_VERTS */
+    u32 pso_pending = 0xFFFFFFFFu;
+    ID3D12PipelineState* pso = get_pso(
+        ld_vertex_mask_signature() ? &used_layout : NULL,
+        ld_vertex_compact_payload(), &pso_pending);
+    if (!pso && pso_pending != 0xFFFFFFFFu) {
+        pso = ld_pso_wait(pso_pending);   /* NOTES fix 62 */
+        if (!pso && g.psos[pso_pending].job) {
+            live_draw_csv_emit(prim, n_tri, "drop_pso_pending");
+            return;
+        }
+    }
+    if (!pso) {
+#if defined(YZ_PERF_PROFILE)
+        ld_profile_note_rejected_pso();
+#endif
+        live_draw_csv_emit(prim, n_tri, "drop_pso");
+        g_ld_stats.group_drop_pso++;
+        return;   /* no fallback in live path */
+    }
+    u32 vertex_cb_offset = 0;
+    int vertex_cb_plan = rsx_vertex_constant_ring_plan(
+        g.cb_used, CB_RING_BYTES, CB_BLOCK_ALIGNED, &vertex_cb_offset);
+    if (vertex_cb_plan == 0) {
+#if !defined(YZ_PERF_CLEAN)
+        g_ld_vertex_constant_ring_recycles++;
+        g_ld_frame_vertex_constant_ring_recycles++;
+        yz_frontier_trace_emit(
+            YZ_FT_PARITY_CB_RECYCLE, g_ld_frames, g_ld_last_present_target,
+            g.cb_used, CB_RING_BYTES, CB_BLOCK_ALIGNED,
+            (u32)g_ld_stats.groups_executed,
+            g_ld_fifo_get, g_ld_fifo_put);
+#endif
+        ld_flush(LD_FLUSH_VERTEX_CONSTANT_RING);
+        if (!g.ready)
+            return;
+        g.cb_used = 0;
+        vertex_cb_plan = rsx_vertex_constant_ring_plan(
+            g.cb_used, CB_RING_BYTES, CB_BLOCK_ALIGNED,
+            &vertex_cb_offset);
+    }
+    if (vertex_cb_plan != 1) {
+        live_draw_csv_emit(prim, n_tri, "drop_cbring_invalid");
+        g_ld_stats.group_drop_ring++;
+        return;
+    }
+    g.cb_used = vertex_cb_offset;
+    u32 ps_cb_offset = 0;
+    if (!ld_upload_pixel_constants(&ps_cb_offset)) {
+        live_draw_csv_emit(prim, n_tri, "drop_ps_cbring");
+        g_ld_stats.group_drop_ring++;
+        return;
+    }
+
+    const u32 target = current_surface();
+    if (target == LD_INVALID_SURFACE) {
+        live_draw_csv_emit(prim, n_tri, "drop_surface");
+        g_ld_stats.group_drop_surface++;
+        return;
+    }
+    /* LD_SKIP_SAMPLING=<hex offset>: drop draws that sample a texture at that
+     * offset. Debug only -- removing a post-process pass shows whether the
+     * scene under it has any colour at all. */
+    { static int64_t skip = -2;
+      if (skip == -2) { const char* e = getenv("LD_SKIP_SAMPLING"); skip = e ? (int64_t)strtoul(e, 0, 16) : -1; }
+      if (skip >= 0)
+          for (u32 u = 0; u < 16; u++) {
+              rsx_dsp_texture st; rsx_dsp_get_texture(&g.rsx, u, &st);
+              if (st.enabled && st.offset == (u32)skip) return;
+          } }
+    /* LD_TRACE_PSO=<hex key>: raw vertex attributes + unit-0 texels of the
+     * first three draws with that CSV pso_key. */
+    { static u64 tk = 1; static int tn;
+      if (tk == 1) { const char* e = getenv("LD_TRACE_PSO"); tk = e ? _strtoui64(e, 0, 16) : 0; }
+      if (tk && live_legacy_pso_key() == tk && tn >= 3) {
+          static u32 every;
+          if (dc.inl && (++every % 60) == 0)
+              fprintf(stderr, "[pso-trace] frame=%u col=%02X%02X%02X%02X\n", g_ld_frames,
+                      dc.inl[16], dc.inl[17], dc.inl[18], dc.inl[19]);
+      }
+      /* LD_TRACE_PSO_FROM=<frame>: the first three draws at or after that
+       * frame -- a PSO's first uses can predate the data it later draws. */
+      static long tfrom = -1;
+      if (tfrom < 0) { const char* e = getenv("LD_TRACE_PSO_FROM"); tfrom = e ? atol(e) : 0; }
+      if (tk && tn < 3 && live_legacy_pso_key() == tk && (long)g_ld_frames >= tfrom) {
+          tn++;
+          if (dc.inl) {
+              fprintf(stderr, "[pso-trace] inline stride=%u bytes=%u:", dc.inl_stride, dc.inl_bytes);
+              for (u32 k = 0; k < dc.inl_bytes && k < 6 * dc.inl_stride; k++)
+                  fprintf(stderr, "%s%02X", (k % dc.inl_stride) ? "" : " |", dc.inl[k]);
+              fprintf(stderr, "\n");
+          }
+          for (u32 ai = 0; ai < 16; ai++) {
+              rsx_dsp_vertex_attr va; rsx_dsp_get_vertex_attr(&g.rsx, ai, &va);
+              if (!va.type) continue;
+              fprintf(stderr, "[pso-trace] attr%u type=%u size=%u stride=%u loc=%u off=0x%X:",
+                      ai, va.type, va.size, va.stride, va.location, va.offset);
+              for (u32 vi = 0; vi < 6; vi++) {
+                  const u8* p = guest_ptr(va.location, va.offset + vi * va.stride, 16);
+                  if (!p) break;
+                  fprintf(stderr, " |");
+                  for (u32 k = 0; k < (va.type == RSX_VTX_TYPE_FLOAT ? 4u * va.size : 4u) && k < 16; k++)
+                      fprintf(stderr, "%02X", p[k]);
+              }
+              fprintf(stderr, "\n");
+          }
+          /* The raw array registers and base (the attrN lines above print the
+           * decoded offset only), and the constant colour a disabled attr3
+           * feeds -- the two things a draw that vanishes is usually missing. */
+          fprintf(stderr, "[pso-trace] vdata base_offset=0x%X base_index=%u raw attr0 off=0x%08X fmt=0x%08X\n",
+                  rsx_dsp_vertex_data_base_offset(&g.rsx), rsx_dsp_vertex_data_base_index(&g.rsx),
+                  rsx_dsp_reg(&g.rsx, 0x1680), rsx_dsp_reg(&g.rsx, 0x1740));
+          { float d3[4]; rsx_dsp_vertex_default(&g.rsx, 3, d3);
+            fprintf(stderr, "[pso-trace] attr3 const=%g %g %g %g\n", d3[0], d3[1], d3[2], d3[3]); }
+          /* Every non-zero transform constant (raw words), so the VS can be
+           * evaluated offline against exactly what this draw saw. */
+          for (u32 q = 0; q < 512; q++) {
