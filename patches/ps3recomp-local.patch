+#ifdef _WIN32
+/* Keep the game on one L3 cache (Demon's Souls NOTES fix 65). On a CPU with several core
+ * complexes (Ryzen CCDs) Windows spreads the game's threads over all of them, and the
+ * HighGraphics <-> SPU dispatcher hand-offs (lock-line stores, reservation checks) then cross
+ * dies on every command. Pinned to the biggest L3 (the 3D V-Cache die on X3D parts) a heavy
+ * Valley of Defilement spot ran 89.5 instead of 77 fps in the 100 fps mode. Only when there are
+ * two or more L3s and the chosen one serves at least 12 logical CPUs; single-L3 CPUs (most
+ * Intel, small Ryzens) are left alone. DES_AFFINITY=0 = off, DES_AFFINITY=<hex mask> = that mask. */
+static void pin_to_biggest_l3(void)
+{
+    const char* e = getenv("DES_AFFINITY");
+    if (e && e[0] == '0' && e[1] == 0) return;
+    DWORD_PTR proc = 0, sys = 0;
+    if (!GetProcessAffinityMask(GetCurrentProcess(), &proc, &sys)) return;
+    if (e && *e) {
+        const DWORD_PTR m = (DWORD_PTR)_strtoui64(e, NULL, 16) & sys;
+        if (m && SetProcessAffinityMask(GetCurrentProcess(), m))
+            fprintf(stderr, "[affinity] DES_AFFINITY: mask 0x%llX\n", (unsigned long long)m);
+        return;
+    }
+    DWORD len = 0;
+    GetLogicalProcessorInformationEx(RelationCache, NULL, &len);
+    if (!len) return;
+    char* buf = (char*)malloc(len);
+    if (!buf) return;
+    if (!GetLogicalProcessorInformationEx(RelationCache, (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)buf, &len)) {
+        free(buf); return; }
+    int n_l3 = 0; DWORD best_size = 0; KAFFINITY best_mask = 0;
+    for (DWORD at = 0; at < len; ) {
+        const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX* p = (const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)(buf + at);
+        if (!p->Size) break;
+        if (p->Relationship == RelationCache && p->Cache.Level == 3 && p->Cache.GroupMask.Group == 0) {
+            n_l3++;
+            if (p->Cache.CacheSize > best_size) { best_size = p->Cache.CacheSize; best_mask = p->Cache.GroupMask.Mask; }
+        }
+        at += p->Size;
+    }
+    free(buf);
+    const DWORD_PTR m = (DWORD_PTR)best_mask & proc;
+    int cpus = 0;
+    for (DWORD_PTR b = m; b; b &= b - 1) cpus++;
+    if (n_l3 < 2 || cpus < 12) return;
+    if (SetProcessAffinityMask(GetCurrentProcess(), m))
+        fprintf(stderr, "[affinity] %d L3 caches: pinned to the biggest (%lu MB, %d logical CPUs, mask 0x%llX); "
+                "DES_AFFINITY=0 = off\n", n_l3, (unsigned long)(best_size >> 20), cpus, (unsigned long long)m);
