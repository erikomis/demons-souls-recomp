-        format.bytes_per_texel = 4;
-        format.component_bytes = 4;
-        break;
-    case RSX_TEX_FMT_Y16X16_FLOAT:
-        format.dxgi = DXGI_FORMAT_R16G16_FLOAT;
-        format.bytes_per_texel = 4;
-        format.component_bytes = 2;
