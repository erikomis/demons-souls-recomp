+static void ts_live_add(uint32_t ea, long d)
+{
+    if (!ea) return;
+    AcquireSRWLockExclusive(&s_ts_live_lock);
+    int slot = -1;
+    for (int i = 0; i < 64; i++) if (s_ts_live_ea[i] == ea) { slot = i; break; }
+    if (slot < 0) for (int i = 0; i < 64; i++) if (!s_ts_live_ea[i]) { slot = i; s_ts_live_ea[i] = ea; s_ts_live_n[i] = 0; break; }
+    if (slot >= 0) { s_ts_live_n[slot] += d; if (s_ts_live_n[slot] <= 0) s_ts_live_ea[slot] = 0; }
