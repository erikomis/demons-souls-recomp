-                    "[rsx-clear] frame=%u n=%llu target=%u mask=0x%02X "
-                    "argb=0x%08X z24=0x%06X stencil=0x%02X\n",
-                    g_ld_frames, g_ld_stats.clears, target, mask,
-                    rsx_dsp_clear_color(&g.rsx), z >> 8, z & 0xFF);
