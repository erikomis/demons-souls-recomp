-        g.dev, 1, cpu, srv_cpu(SRV_DEPTH_SOURCE_BASE + zindex),
-        D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
-    cpu.ptr += g.srv_step;
