+/* LD_PSO_TIME=1: per new PSO, ms spent compiling HLSL (cache misses) and creating the PSO. */
+extern unsigned long long ps3_qpc_us(void);
+/* Per thread: build_pso also runs on the pipeline workers (NOTES fix 62). */
+static __declspec(thread) unsigned long long g_ld_pso_t_vs, g_ld_pso_t_ps, g_ld_pso_t_create, g_ld_pso_t_disk;
+static __declspec(thread) int g_ld_on_pso_worker;   /* this thread is a pipeline worker */
+
+/* Perf log (LD_PRESENT_LOG=<file>): the present lines (see Present below) and "# <us> <what>"
+ * lines from ps3_perf_note() anywhere -- shader compiles, slow file reads, the title's own
+ * per-step lines and marks -- in one file on one clock. Written from LD_PRESENT_LOG_FROM seconds
+ * after the first line (default 180) for LD_PRESENT_LOG_SECS seconds (default 60, 0 = until
+ * exit), flushed every second so a run that is closed or crashes keeps its log. */
+static SRWLOCK g_ld_plog_lock = SRWLOCK_INIT;
+static FILE* g_ld_plog;
+static volatile int g_ld_plog_on = -1;
+static unsigned long long g_ld_plog_from, g_ld_plog_end, g_ld_plog_flushed;
+/* The log file, locked (ld_plog_end unlocks), or NULL outside the logged window. */
+static FILE* ld_plog_begin(unsigned long long t)
+{
+    if (g_ld_plog_on == 0) return NULL;
+    AcquireSRWLockExclusive(&g_ld_plog_lock);
+    if (g_ld_plog_on < 0) {
+        const char* e = getenv("LD_PRESENT_LOG");
+        const char* fr = getenv("LD_PRESENT_LOG_FROM");
+        const char* s = getenv("LD_PRESENT_LOG_SECS");
+        const double secs = s ? atof(s) : 60.0;
+        g_ld_plog = e ? fopen(e, "w") : NULL;
+        g_ld_plog_from = t + (unsigned long long)((fr ? atof(fr) : 180.0) * 1e6);
+        g_ld_plog_end = secs > 0.0 ? g_ld_plog_from + (unsigned long long)(secs * 1e6) : ~0ull;
+        g_ld_plog_on = g_ld_plog ? 1 : 0;
+    }
+    if (g_ld_plog_on == 1 && t >= g_ld_plog_end) { fclose(g_ld_plog); g_ld_plog = NULL; g_ld_plog_on = 0; }
+    if (g_ld_plog_on == 1 && t >= g_ld_plog_from) return g_ld_plog;
+    ReleaseSRWLockExclusive(&g_ld_plog_lock);
+    return NULL;
+}
+static void ld_plog_end(unsigned long long t)
+{
+    if (t - g_ld_plog_flushed >= 1000000ull) { fflush(g_ld_plog); g_ld_plog_flushed = t; }
+    ReleaseSRWLockExclusive(&g_ld_plog_lock);
+}
+/* CPU time the calling thread has used, in microseconds, for the perf log: a late frame whose
+ * thread was busy the whole time was computing, one whose thread was mostly idle was waiting.
+ * QueryThreadCycleTime counts TSC ticks; the TSC rate is measured once (a 20 ms sleep). */
+unsigned long long ps3_thread_cpu_us(void)
+{
+    static volatile double tsc_per_us;
+    if (tsc_per_us == 0.0) {
+        const unsigned long long q0 = ps3_qpc_us(), c0 = __rdtsc();
+        Sleep(20);
+        const unsigned long long q1 = ps3_qpc_us(), c1 = __rdtsc();
+        tsc_per_us = (double)(c1 - c0) / (double)(q1 > q0 ? q1 - q0 : 1);
+    }
+    ULONG64 cyc = 0;
+    QueryThreadCycleTime(GetCurrentThread(), &cyc);
+    return (unsigned long long)((double)cyc / tsc_per_us);
+}
+void ps3_perf_note(const char* fmt, ...)
+{
+    if (g_ld_plog_on == 0) return;
+    const unsigned long long t = ps3_qpc_us();
+    FILE* f = ld_plog_begin(t);
+    if (!f) return;
+    va_list ap;
+    va_start(ap, fmt);
+    fprintf(f, "# %llu ", t);
+    vfprintf(f, fmt, ap);
+    fputc('\n', f);
+    va_end(ap);
+    ld_plog_end(t);
+}
+
+/* Late-step stack samples for the perf log (DES_PERF_STACKS=1): the title calls
+ * ps3_perf_step_begin() at the top of every frame step on its main thread. A sampler thread
+ * watches the step's age; once a step runs DES_PERF_STACK_MS (default 28) ms it suspends the
+ * main thread -- and each watched thread: guest threads named in DES_PERF_STACK_THREADS
+ * (comma-separated, e.g. "HighGraphics"), and "rsx", this renderer's thread -- every 4 ms (at
+ * most 8 times a step), walks its stack with the x64 unwind tables and logs
+ * "# <us> stack <thread> <step age ms> <frames from other modules> <exe RVA> ..." (only frames
+ * in the exe; symbolise with llvm-symbolizer against the PDB). Nothing is written while a thread
+ * is suspended (it may hold the CRT or log lock). */
+static volatile LONG64 g_perf_step_t0;
+static struct { HANDLE h; char tag[32]; } g_perf_thr[6];
+static volatile LONG g_perf_n_thr;
+static int g_perf_stacks = -1;
+static volatile int g_perf_started;   /* main registered: later threads append */
+static int perf_stacks_on(void)
+{
+    if (g_perf_stacks < 0) { const char* e = getenv("DES_PERF_STACKS"); g_perf_stacks = (e && *e == '1') ? 1 : 0; }
+    return g_perf_stacks;
+}
+static void perf_add_thread(const char* tag)
+{
+    const LONG i = InterlockedIncrement(&g_perf_n_thr) - 1;
+    if (i >= (LONG)(sizeof g_perf_thr / sizeof g_perf_thr[0])) { InterlockedDecrement(&g_perf_n_thr); return; }
+    HANDLE h = NULL;
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h,
+                    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0);
+    int k = 0;
+    for (; tag[k] && k < 31; k++) g_perf_thr[i].tag[k] = tag[k] == ' ' ? '_' : tag[k];
+    g_perf_thr[i].tag[k] = 0;
+    g_perf_thr[i].h = h;   /* last: the sampler skips a slot whose handle is not set yet */
+}
+/* A guest thread starting (sys_ppu_thread.c): watch it if DES_PERF_STACK_THREADS names it. */
+void ps3_perf_watch_thread(const char* name)
+{
+    if (!perf_stacks_on() || !name) return;
+    const char* list = getenv("DES_PERF_STACK_THREADS");
+    const size_t n = strlen(name);
+    for (const char* p = list; p && *p; ) {
+        const char* c = strchr(p, ',');
+        const size_t len = c ? (size_t)(c - p) : strlen(p);
+        if (len == n && !strncmp(p, name, n)) { perf_add_thread(name); return; }
+        p = c ? c + 1 : NULL;
+    }
+}
+static int perf_sample(HANDLE h, ULONG64 base, ULONG64* pcs, int max, int* other)
+{
+    int n = 0; *other = 0;
+    CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_FULL;
+    if (SuspendThread(h) == (DWORD)-1) return 0;
+    if (GetThreadContext(h, &c)) {
+        for (int depth = 0; depth < 64 && c.Rip && n < max; depth++) {
+            ULONG64 img = 0;
+            PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(c.Rip, &img, NULL);
+            if (img == base) pcs[n++] = c.Rip - base;
+            else if (n == 0) (*other)++;
+            if (!fn) { c.Rip = *(ULONG64*)c.Rsp; c.Rsp += 8; continue; }   /* leaf */
+            PVOID hd; ULONG64 est;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, fn, &c, &hd, &est, NULL);
+        }
+    }
+    ResumeThread(h);
+    return n;
+}
+static DWORD WINAPI perf_stack_sampler(LPVOID unused)
+{
+    (void)unused;
+    const char* e = getenv("DES_PERF_STACK_MS");
+    const unsigned long long after = (unsigned long long)((e ? atof(e) : 28.0) * 1000.0);
+    const ULONG64 base = (ULONG64)GetModuleHandleW(NULL);
+    LONG64 sampled_step = 0; int n_this_step = 0; unsigned long long next_at = 0;
+    /* DES_PERF_STACK_EVERY=<ms>: also sample the watched threads other than main (rsx, named guest
+     * threads) every <ms>, late step or not -- a profile of where the renderer spends its frames. */
+    const char* ev = getenv("DES_PERF_STACK_EVERY");
+    const unsigned long long every = ev ? (unsigned long long)(atof(ev) * 1000.0) : 0;
+    unsigned long long next_every = 0;
+    for (;;) {
+        Sleep(1);
+        const LONG64 t0 = g_perf_step_t0;
+        if (!t0) continue;
+        const unsigned long long now = ps3_qpc_us();
+        if (every && now >= next_every) {
+            next_every = now + every;
+            const LONG nt = g_perf_n_thr;
+            for (LONG i = 1; i < nt; i++) {
+                if (!g_perf_thr[i].h) continue;
+                ULONG64 pcs[48]; int other;
+                const int n = perf_sample(g_perf_thr[i].h, base, pcs, 48, &other);
+                if (!n) continue;
+                char line[48 * 12 + 96];
+                int at = snprintf(line, sizeof line, "stack %s -1 %d", g_perf_thr[i].tag, other);
+                for (int k = 0; k < n && at < (int)sizeof line - 12; k++) at += snprintf(line + at, sizeof line - at, " %llX", pcs[k]);
+                ps3_perf_note("%s", line);
+            }
+        }
+        if (t0 != sampled_step) { sampled_step = t0; n_this_step = 0; next_at = (unsigned long long)t0 + after; }
+        if (now < next_at || n_this_step >= 8) continue;
+        const LONG nt = g_perf_n_thr;
+        for (LONG i = 0; i < nt; i++) {
+            if (!g_perf_thr[i].h) continue;
+            ULONG64 pcs[48]; int other;
+            const int n = perf_sample(g_perf_thr[i].h, base, pcs, 48, &other);
+            if (i == 0 && g_perf_step_t0 != t0) break;   /* the step ended meanwhile */
+            if (!n) continue;
+            char line[48 * 12 + 96];
+            int at = snprintf(line, sizeof line, "stack %s %.1f %d", g_perf_thr[i].tag,
+                              (now - (unsigned long long)t0) / 1000.0, other);
+            for (int k = 0; k < n && at < (int)sizeof line - 12; k++) at += snprintf(line + at, sizeof line - at, " %llX", pcs[k]);
+            ps3_perf_note("%s", line);
+        }
+        if (g_perf_step_t0 != t0) { n_this_step = 8; continue; }
+        n_this_step++; next_at = now + 4000;
+    }
+}
+/* Per-thread CPU for the perf log (Demon's Souls NOTES fix 58): once a second
+ * "# <us> thr <process %> <name>=<%> ..." -- the busiest host threads by name (ps3_thread_name:
+ * "ppu HighGraphics", "spu ...", the renderer), % of one core over that second, from
+ * QueryThreadCycleTime. A stretch of late frames then says which thread was saturated and which
+ * sat waiting. Threads that started and ended within the second are not seen. DES_PERF_THREADS=0
+ * = off. */
+static DWORD WINAPI perf_thread_cpu(LPVOID unused)
+{
+    (void)unused;
+    typedef HRESULT (WINAPI *get_desc_fn)(HANDLE, PWSTR*);
+    const get_desc_fn get_desc = (get_desc_fn)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription");
+    enum { MAXT = 512 };
+    static struct { DWORD tid; ULONG64 cyc; char name[40]; int seen; } tab[MAXT];
+    int nt = 0;
+    const DWORD pid = GetCurrentProcessId();
+    const unsigned long long c0 = __rdtsc(), q0 = ps3_qpc_us();
+    Sleep(50);
+    const double tsc_per_us = (double)(__rdtsc() - c0) / (double)(ps3_qpc_us() - q0);
+    unsigned long long last = ps3_qpc_us();
+    ULONG64 proc_last = 0; QueryProcessCycleTime(GetCurrentProcess(), &proc_last);
+    for (;;) {
+        Sleep(1000);
+        const unsigned long long now = ps3_qpc_us();
+        const double span = (double)(now - last) * tsc_per_us / 100.0;   /* cycles per 1% of a core */
+        last = now;
+        struct { char name[40]; double pct; } agg[64]; int na = 0;
+        for (int i = 0; i < nt; i++) tab[i].seen = 0;
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snap == INVALID_HANDLE_VALUE) continue;
+        THREADENTRY32 te; te.dwSize = sizeof te;
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            if (te.th32OwnerProcessID != pid) continue;
+            HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+            if (!h) continue;
+            ULONG64 cyc = 0; QueryThreadCycleTime(h, &cyc);
+            int k = 0;
+            while (k < nt && tab[k].tid != te.th32ThreadID) k++;
+            if (k == nt && nt < MAXT) {
+                tab[nt].tid = te.th32ThreadID; tab[nt].cyc = cyc; tab[nt].name[0] = 0;
+                PWSTR w = NULL;
+                if (get_desc && SUCCEEDED(get_desc(h, &w)) && w) {
+                    int j = 0;
+                    for (; w[j] && j < 39; j++) tab[nt].name[j] = (w[j] == L' ' || w[j] > 126) ? '_' : (char)w[j];
+                    tab[nt].name[j] = 0; LocalFree(w); }
+                if (!tab[nt].name[0]) snprintf(tab[nt].name, sizeof tab[nt].name, "tid%lu", (unsigned long)te.th32ThreadID);
+                tab[nt].seen = 1; nt++; CloseHandle(h); continue;   /* new: counted from the next second */
+            }
+            CloseHandle(h);
+            if (k == nt) continue;
+            const double pct = (double)(cyc - tab[k].cyc) / span;
+            tab[k].cyc = cyc; tab[k].seen = 1;
+            int a = 0;
+            while (a < na && strcmp(agg[a].name, tab[k].name)) a++;
+            if (a == na && na < 64) { memcpy(agg[na].name, tab[k].name, 40); agg[na].pct = 0; na++; }
+            if (a < na) agg[a].pct += pct;
+        }
+        CloseHandle(snap);
+        /* threads gone since the last snapshot: drop them */
+        for (int i = 0; i < nt; ) { if (!tab[i].seen && tab[i].cyc) { tab[i] = tab[--nt]; } else i++; }
+        ULONG64 proc = 0; QueryProcessCycleTime(GetCurrentProcess(), &proc);
+        const double proc_pct = (double)(proc - proc_last) / span; proc_last = proc;
+        char line[1024]; int len = snprintf(line, sizeof line, "thr %.0f", proc_pct);
+        for (int shown = 0; shown < 10; shown++) {
+            int best = -1;
+            for (int a = 0; a < na; a++) if (agg[a].pct >= 2.0 && (best < 0 || agg[a].pct > agg[best].pct)) best = a;
+            if (best < 0) break;
+            len += snprintf(line + len, sizeof line - len, " %s=%.0f", agg[best].name, agg[best].pct);
+            agg[best].pct = -1.0;
+            if (len >= (int)sizeof line - 64) break;
+        }
+        ps3_perf_note("%s", line);
+    }
+    return 0;
+}
+
+void ps3_perf_step_begin(void)
+{
+    static int started, thr_started;
+    if (!thr_started) {
+        thr_started = 1;
+        const char* e = getenv("DES_PERF_THREADS");
+        if (!(e && *e == '0')) { HANDLE t = CreateThread(NULL, 0, perf_thread_cpu, NULL, 0, NULL); if (t) CloseHandle(t); }
+    }
+    if (!perf_stacks_on()) return;
+    if (!started) {
+        started = 1;
+        /* The main thread goes in slot 0: guest threads started earlier moved up one. */
+        perf_add_thread("main");
+        const LONG last = g_perf_n_thr - 1;
+        if (last > 0) {
+            HANDLE h = g_perf_thr[last].h; char tag[32]; memcpy(tag, g_perf_thr[last].tag, 32);
+            for (LONG i = last; i > 0; i--) g_perf_thr[i] = g_perf_thr[i - 1];
+            g_perf_thr[0].h = h; memcpy(g_perf_thr[0].tag, tag, 32);
+        }
+        g_perf_started = 1;
+        HANDLE t = CreateThread(NULL, 0, perf_stack_sampler, NULL, 0, NULL);
+        if (t) { SetThreadPriority(t, THREAD_PRIORITY_TIME_CRITICAL); CloseHandle(t); }
+        ps3_perf_note("info exe_base %llX", (unsigned long long)(ULONG64)GetModuleHandleW(NULL));
+    }
+    g_perf_step_t0 = (LONG64)ps3_qpc_us();
+}
+static ID3D12PipelineState* build_pso(
+    const char* vs_hlsl, const char* ps_hlsl, const render_state_t* rs,
+    const rsx_vertex_layout_plan* masked_layout, int packed_offsets)
+{
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL;
+    static u32 compile_fail_logs = 0;
+    static u32 create_fail_logs = 0;
+    const u32 vs_length = (u32)strlen(vs_hlsl);
+    const u32 ps_length = (u32)strlen(ps_hlsl);
+    const u64 vs_hash = fnv1a(
+        vs_hlsl, vs_length, 1469598103934665603ull);
+    const u64 ps_hash = fnv1a(
+        ps_hlsl, ps_length, 1469598103934665603ull);
+#if defined(YZ_PERF_PROFILE)
+    ld_profile_note_hlsl(
+        vs_hlsl, g_ld_profile.vs_hashes, &g_ld_profile.n_vs_hashes,
+        &g_ld_profile.total.vs_unique);
+    ld_profile_note_hlsl(
+        ps_hlsl, g_ld_profile.ps_hashes, &g_ld_profile.n_ps_hashes,
+        &g_ld_profile.total.ps_unique);
+    g_ld_profile.total.vs_blob_lookups++;
+    const LONGLONG vs_lookup_begin = ld_profile_qpc();
+#endif
+    int vs_post_boundary_hit = 0;
+    int vs_hash_seen = 0;
+    vs = shader_blob_cache_find(
+        &g.vs_blobs, vs_hlsl, vs_length, vs_hash,
+        &vs_post_boundary_hit, &vs_hash_seen);
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.vs_blob_lookup_qpc +=
+        (u64)(ld_profile_qpc() - vs_lookup_begin);
+#endif
+    HRESULT vs_hr = S_OK;
+    if (vs) {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.vs_blob_hits++;
+        if (vs_post_boundary_hit)
+            g_ld_profile.total.vs_post_boundary_repeats++;
+#endif
+    } else {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.vs_blob_misses++;
+#endif
+        { const unsigned long long td = ps3_qpc_us();
+        vs = shader_disk_cache_load('V', vs_hlsl, vs_length, vs_hash);
+        g_ld_pso_t_disk += ps3_qpc_us() - td; }
+        if (vs) {
+            shader_blob_cache_insert_accounted(
+                &g.vs_blobs, vs_hlsl, vs_length, vs_hash, vs,
+                'V', vs_hash_seen);
+        } else {
+#if defined(YZ_PERF_PROFILE)
+            g_ld_profile.total.vs_compile_calls++;
+            const LONGLONG compile_begin = ld_profile_qpc();
+#endif
+            const int vs_claim = ld_compile_claim('V', vs_hash, vs_length);   /* fix 62 dedupe */
+            if (!vs_claim)
+                vs = shader_blob_cache_find(&g.vs_blobs, vs_hlsl, vs_length, vs_hash, NULL, NULL);
+            int vs_compiled = 0;
+            if (!vs) {
+            const unsigned long long t0 = ps3_qpc_us();
+            vs_hr = D3DCompile(
+                vs_hlsl, vs_length, "xvs", NULL, NULL, "main",
+                "vs_5_0", 0, 0, &vs, &err);
+            g_ld_pso_t_vs += ps3_qpc_us() - t0;
+            vs_compiled = 1; }
+#if defined(YZ_PERF_PROFILE)
+            g_ld_profile.total.vs_compile_qpc +=
+                (u64)(ld_profile_qpc() - compile_begin);
+#endif
+            if (vs_compiled && SUCCEEDED(vs_hr)) {
+                shader_disk_cache_store(
+                    'V', vs_hlsl, vs_length, vs_hash, vs);
+                shader_blob_cache_insert_accounted(
+                    &g.vs_blobs, vs_hlsl, vs_length, vs_hash, vs,
+                    'V', vs_hash_seen);
+            }
+            if (vs_claim == 1)
+                ld_compile_release('V', vs_hash, vs_length);
+        }
+    }
+    if (FAILED(vs_hr)) {
+        if (PS3_LOG_FIRST(compile_fail_logs, 32)) {
+            const char* msg = err ? (const char*)err->lpVtbl->GetBufferPointer(err)
+                                  : "no compiler diagnostic";
+            fprintf(stderr, "[pso-fail] vertex compile: %.768s\n", msg);
+        }
+        if (err) err->lpVtbl->Release(err); return NULL;
+    }
+    if (err) {
+        err->lpVtbl->Release(err);
+        err = NULL;
+    }
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.ps_blob_lookups++;
+    const LONGLONG ps_lookup_begin = ld_profile_qpc();
+#endif
+    int ps_post_boundary_hit = 0;
+    int ps_hash_seen = 0;
+    ps = shader_blob_cache_find(
+        &g.ps_blobs, ps_hlsl, ps_length, ps_hash,
+        &ps_post_boundary_hit, &ps_hash_seen);
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.ps_blob_lookup_qpc +=
+        (u64)(ld_profile_qpc() - ps_lookup_begin);
+#endif
+    HRESULT ps_hr = S_OK;
+    if (ps) {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.ps_blob_hits++;
+        if (ps_post_boundary_hit)
+            g_ld_profile.total.ps_post_boundary_repeats++;
+#endif
+    } else {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.ps_blob_misses++;
+#endif
+        { const unsigned long long td = ps3_qpc_us();
+        ps = shader_disk_cache_load('P', ps_hlsl, ps_length, ps_hash);
+        g_ld_pso_t_disk += ps3_qpc_us() - td; }
+        if (ps) {
+            shader_blob_cache_insert_accounted(
+                &g.ps_blobs, ps_hlsl, ps_length, ps_hash, ps,
+                'P', ps_hash_seen);
+        } else {
+#if defined(YZ_PERF_PROFILE)
+            g_ld_profile.total.ps_compile_calls++;
+            const LONGLONG compile_begin = ld_profile_qpc();
+#endif
+            const int ps_claim = ld_compile_claim('P', ps_hash, ps_length);   /* fix 62 dedupe */
+            if (!ps_claim)
+                ps = shader_blob_cache_find(&g.ps_blobs, ps_hlsl, ps_length, ps_hash, NULL, NULL);
+            int ps_compiled = 0;
+            if (!ps) {
+            const unsigned long long t0 = ps3_qpc_us();
+            ps_hr = D3DCompile(
+                ps_hlsl, ps_length, "xps", NULL, NULL, "main",
+                "ps_5_0", 0, 0, &ps, &err);
+            g_ld_pso_t_ps += ps3_qpc_us() - t0;
+            ps_compiled = 1; }
+#if defined(YZ_PERF_PROFILE)
+            g_ld_profile.total.ps_compile_qpc +=
+                (u64)(ld_profile_qpc() - compile_begin);
+#endif
+            if (ps_compiled && SUCCEEDED(ps_hr)) {
+                shader_disk_cache_store(
+                    'P', ps_hlsl, ps_length, ps_hash, ps);
+                shader_blob_cache_insert_accounted(
+                    &g.ps_blobs, ps_hlsl, ps_length, ps_hash, ps,
+                    'P', ps_hash_seen);
+            }
+            if (ps_claim == 1)
+                ld_compile_release('P', ps_hash, ps_length);
+        }
+    }
+    if (FAILED(ps_hr)) {
+        if (PS3_LOG_FIRST(compile_fail_logs, 32)) {
+            const char* msg = err ? (const char*)err->lpVtbl->GetBufferPointer(err)
+                                  : "no compiler diagnostic";
+            fprintf(stderr, "[pso-fail] pixel compile: %.768s\n", msg);
+        }
+        if (err) err->lpVtbl->Release(err);
+        vs->lpVtbl->Release(vs); return NULL;
+    }
+    if (err) {
+        err->lpVtbl->Release(err);
+        err = NULL;
+    }
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    const u32 input_count =
+        masked_layout ? masked_layout->count : RSX_DSP_NUM_VERTEX_ATTR;
+    for (u32 slot = 0; slot < input_count; slot++) {
+        const u32 attr =
+            masked_layout ? masked_layout->attrs[slot] : slot;
+        D3D12_INPUT_ELEMENT_DESC e = {
+            "ATTR", attr, DXGI_FORMAT_R32G32B32A32_FLOAT, 0,
+            masked_layout && !packed_offsets ? attr * 16u : slot * 16u,
+            D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0
+        };
+        il[slot] = e;
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = g.rootsig_x;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+    pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+    pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.InputLayout.pInputElementDescs = input_count ? il : NULL;
+    pd.InputLayout.NumElements = input_count;
+    apply_render_state(&pd, rs);
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = rs->rt_count ? rs->rt_count : 1;
+    for (u32 r = 0; r < pd.NumRenderTargets; r++)
+        pd.RTVFormats[r] = (DXGI_FORMAT)rs->rt_fmt;
+    pd.SampleDesc.Count = 1;
+    ID3D12PipelineState* pso = NULL;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.create_pso_calls++;
+    const LONGLONG create_begin = ld_profile_qpc();
+#endif
+    const unsigned long long create_t0 = ps3_qpc_us();
+    HRESULT hr = g.dev->lpVtbl->CreateGraphicsPipelineState(
+        g.dev, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+    g_ld_pso_t_create += ps3_qpc_us() - create_t0;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.create_pso_qpc +=
+        (u64)(ld_profile_qpc() - create_begin);
+#endif
+    if (FAILED(hr)) {
+        const HRESULT removed = g.dev->lpVtbl->GetDeviceRemovedReason(g.dev);
+        if (PS3_LOG_FIRST(create_fail_logs, 32))
+            fprintf(stderr,
+                    "[pso-fail] create hr=0x%08lX removed=0x%08lX "
+                    "depth{test=%u write=%u func=%u} blend=%u "
+                    "cull{enable=%u face=%u}\n",
+                    (unsigned long)hr, (unsigned long)removed,
+                    rs->depth_test, rs->depth_write, rs->depth_func,
+                    rs->blend_enable, rs->cull_enable, rs->cull_face);
+        if (removed != S_OK)
+            { if (!g_ld_on_pso_worker) ld_dump_dred("CreateGraphicsPipelineState", hr); }
+    }
+    vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+    return SUCCEEDED(hr) ? pso : NULL;
+}
+
+/* ---------------------------------------------------------------------------
+ * Pipelines built off the drain thread (Demon's Souls NOTES fix 62).
+ *
+ * The thread that drains the guest FIFO also runs the guest vblank clock and presents
+ * (boot_main vblank_ticker). A new pipeline used to be built right there: D3DCompile (a
+ * skinned-character vertex program takes ~300 ms in fxc), a disk-cache file read, the
+ * driver's CreateGraphicsPipelineState (up to ~100 ms the first time). Every millisecond of
+ * that held up the vblank handler and the frame's fences, so the game's main thread sat
+ * waiting -- the "game step late (thread waiting)" hitches in new areas, and 0.3-1.3 s
+ * freezes for new shaders.
+ *
+ * Now a miss still decompiles here (cheap, static buffers). If both shaders are already compiled
+ * (in memory or the disk cache) the pipeline is built here as before -- identical frames. Only a
+ * pipeline that needs fxc goes to LD_PSO_THREADS (default 2) workers, and its draws are skipped
+ * until it is ready: the object shows a few frames late instead of freezing the game. Draws into a
+ * display buffer and full-screen passes (no depth test, <= 6 vertices: post-process, tone map,
+ * blits later passes read) never skip: they build or wait as before. Two pipelines needing the
+ * same new shader share one compile. LD_PSO_ASYNC=0 = the old path everywhere.
+ * Perf log: "psoa <vs ms> <ps ms> <create ms> <ms from request to ready> <draws skipped>" per
+ * worker-built pipeline, "psow <ms> <built here>" when a must-draw waited >= 1 ms, "psof" per
+ * frame for the builds still done here.
+ * ------------------------------------------------------------------------*/
+typedef struct ld_pso_job {
+    struct ld_pso_job* next;          /* queue link */
+    int state;                        /* 0 queued, 1 building, 2 done -- under g_ld_pq_lock */
+    HANDLE done;                      /* manual reset, set at state 2 */
+    u32 slot;                         /* g.psos[] index */
+    char *vs, *ps;
+    render_state_t rs;
+    rsx_vertex_layout_plan layout;
+    int has_layout, packed;
+    ID3D12PipelineState* pso;
+    unsigned long long t_vs, t_ps, t_create, t_submit, t_done;
+    u32 skipped;
+} ld_pso_job;
+
+static CRITICAL_SECTION g_ld_pq_lock;
+static CONDITION_VARIABLE g_ld_pq_cv;
+static ld_pso_job *g_ld_pq_head, *g_ld_pq_tail;
+static HANDLE g_ld_pq_thr[8];
+static int g_ld_pq_nthr;
+static volatile LONG g_ld_pq_quit;
+static int g_ld_pso_async = -1;
+static u32 g_ld_pso_pending[1024];    /* g.psos[] slots with a job */
+static u32 g_ld_n_pso_pending;
+static u32 g_ld_frame_pso_n;                      /* pipelines built on this thread this frame */
+static unsigned long long g_ld_frame_pso_us, g_ld_frame_pso_disk_us;
+static unsigned long long g_ld_pso_async_n, g_ld_pso_async_skips;
+static u32 g_ld_draw_nverts;   /* defined (tentatively) again below, next to its other users */
+
+static void ld_pso_job_run(ld_pso_job* j)
+{
+    g_ld_pso_t_vs = g_ld_pso_t_ps = g_ld_pso_t_create = 0;
+    j->pso = build_pso(j->vs, j->ps, &j->rs, j->has_layout ? &j->layout : NULL, j->packed);
+    j->t_vs = g_ld_pso_t_vs; j->t_ps = g_ld_pso_t_ps; j->t_create = g_ld_pso_t_create;
+    j->t_done = ps3_qpc_us();
+}
+
+static void ld_pso_job_finish(ld_pso_job* j)
+{
+    /* The event is set before the lock goes: once state 2 is visible the renderer may free j. */
+    EnterCriticalSection(&g_ld_pq_lock);
+    j->state = 2;
+    SetEvent(j->done);
+    LeaveCriticalSection(&g_ld_pq_lock);
+}
+
+static DWORD WINAPI ld_pso_worker(LPVOID unused)
+{
+    (void)unused;
+    g_ld_on_pso_worker = 1;
+    for (;;) {
+        EnterCriticalSection(&g_ld_pq_lock);
+        while (!g_ld_pq_head && !g_ld_pq_quit)
+            SleepConditionVariableCS(&g_ld_pq_cv, &g_ld_pq_lock, INFINITE);
+        if (g_ld_pq_quit) { LeaveCriticalSection(&g_ld_pq_lock); return 0; }
+        ld_pso_job* j = g_ld_pq_head;
+        g_ld_pq_head = j->next;
+        if (!g_ld_pq_head) g_ld_pq_tail = NULL;
+        j->next = NULL;
+        j->state = 1;
+        LeaveCriticalSection(&g_ld_pq_lock);
+        ld_pso_job_run(j);
+        ld_pso_job_finish(j);
+    }
+}
+
+static int ld_pso_async_on(void)
+{
+    if (g_ld_pso_async >= 0) return g_ld_pso_async;
+    const char* e = getenv("LD_PSO_ASYNC");
+    g_ld_pso_async = !(e && *e == '0');
+    if (!g_ld_pso_async) return 0;
+    const char* t = getenv("LD_PSO_THREADS");
+    int n = t ? atoi(t) : 2;
+    if (n < 1) n = 1;
+    if (n > 8) n = 8;
+    InitializeCriticalSection(&g_ld_pq_lock);
+    InitializeConditionVariable(&g_ld_pq_cv);
+    shader_disk_cache_prepare();          /* its lazy init is not thread-safe: do it here */
+    for (int i = 0; i < n; i++) {
+        HANDLE h = CreateThread(NULL, 0, ld_pso_worker, NULL, 0, NULL);
+        if (!h) break;
+        SetThreadPriority(h, THREAD_PRIORITY_BELOW_NORMAL);
+        SetThreadDescription(h, L"rsx_pso_worker");
+        g_ld_pq_thr[g_ld_pq_nthr++] = h;
+    }
+    if (!g_ld_pq_nthr) { g_ld_pso_async = 0; DeleteCriticalSection(&g_ld_pq_lock); }
+    fprintf(stderr, "[pso-async] %s: %d workers for new shader compiles\n",
+            g_ld_pso_async ? "on" : "off (no threads)", g_ld_pq_nthr);
+    return g_ld_pso_async;
+}
+
+/* Queue a build; the g.psos[] slot is the caller's. NULL = could not queue (build it now). */
+static ld_pso_job* ld_pso_submit(u32 slot, const char* vs, const char* ps, const render_state_t* rs,
+                                 const rsx_vertex_layout_plan* layout, int packed)
+{
+    if (g_ld_n_pso_pending >= sizeof g_ld_pso_pending / sizeof g_ld_pso_pending[0]) return NULL;
+    ld_pso_job* j = (ld_pso_job*)calloc(1, sizeof *j);
+    if (!j) return NULL;
+    j->vs = _strdup(vs); j->ps = _strdup(ps);
+    j->done = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!j->vs || !j->ps || !j->done) {
+        free(j->vs); free(j->ps); if (j->done) CloseHandle(j->done); free(j);
+        return NULL;
+    }
+    j->slot = slot;
+    j->rs = *rs;
+    if (layout) { j->layout = *layout; j->has_layout = 1; }
+    j->packed = packed;
+    j->t_submit = ps3_qpc_us();
+    g_ld_pso_pending[g_ld_n_pso_pending++] = slot;
+    EnterCriticalSection(&g_ld_pq_lock);
+    if (g_ld_pq_tail) g_ld_pq_tail->next = j; else g_ld_pq_head = j;
+    g_ld_pq_tail = j;
+    LeaveCriticalSection(&g_ld_pq_lock);
+    WakeConditionVariable(&g_ld_pq_cv);
+    g_ld_pso_async_n++;
+    return j;
+}
+
+/* A finished job: its pipeline goes into the table (NULL = failed, cached like before). */
+static void ld_pso_harvest(u32 slot)
+{
+    ld_pso_job* j = g.psos[slot].job;
+    g.psos[slot].pso = j->pso;
+    g.psos[slot].job = NULL;
+    { static int on = -1; if (on < 0) on = getenv("LD_PSO_TIME") ? 1 : 0;
+      if (on) fprintf(stderr, "[pso-time] frame %u pso %u: vs compile %.1f ms, ps compile %.1f ms, "
+                      "create %.1f ms (async: ready after %.1f ms, %u draws skipped)\n",
+                      g_ld_frames, slot, j->t_vs / 1000.0, j->t_ps / 1000.0, j->t_create / 1000.0,
+                      (j->t_done - j->t_submit) / 1000.0, j->skipped); }
+    if (j->t_vs + j->t_ps + j->t_create >= 1000 || j->skipped)
+        ps3_perf_note("psoa %.1f %.1f %.1f %.1f %u", j->t_vs / 1000.0, j->t_ps / 1000.0,
+                      j->t_create / 1000.0, (j->t_done - j->t_submit) / 1000.0, j->skipped);
+    CloseHandle(j->done); free(j->vs); free(j->ps); free(j);
+    for (u32 i = 0; i < g_ld_n_pso_pending; i++)
+        if (g_ld_pso_pending[i] == slot) { g_ld_pso_pending[i] = g_ld_pso_pending[--g_ld_n_pso_pending]; break; }
+}
+
+static int ld_pso_job_done(const ld_pso_job* j)
+{
+    EnterCriticalSection(&g_ld_pq_lock);
+    const int d = j->state == 2;
+    LeaveCriticalSection(&g_ld_pq_lock);
+    return d;
+}
+
+/* Once a frame: finished jobs whose pipeline was not asked for again still get logged / freed. */
+static void ld_pso_sweep(void)
+{
+    for (u32 i = 0; i < g_ld_n_pso_pending; ) {
+        const u32 slot = g_ld_pso_pending[i];
+        if (ld_pso_job_done(g.psos[slot].job)) ld_pso_harvest(slot);   /* swaps the last one in */
+        else i++;
+    }
+}
+
+/* Does skipping this draw show? Display-buffer targets and full-screen passes. */
+static int ld_pso_draw_critical(void)
+{
+    rsx_dsp_surface sf;
+    rsx_dsp_get_surface(&g.rsx, &sf);
+    for (u32 i = 0; i < 8; i++) {
+        const display_buffer_t* d = &g.display_buffers[i];
+        if (d->valid && d->location == sf.color_location[0] && d->offset == sf.color_offset[0])
+            return 1;
+    }
+    if (g_ld_draw_nverts <= 6) {
+        render_state_t rs;
+        decode_render_state(&rs);
+        if (!rs.depth_test) return 1;
+    }
+    return 0;
+}
+
+/* Would this pipeline run fxc? No when both shaders are in memory or in the disk cache: then it
+ * is built right here as before (deterministic, ~1-2 ms), and only real compiles go to a worker. */
+static int ld_pso_needs_compile(const char* vs, const char* ps)
+{
+    for (int k = 0; k < 2; k++) {
+        const char* src = k ? ps : vs;
+        const u32 len = (u32)strlen(src);
+        const u64 h = fnv1a(src, len, 1469598103934665603ull);
+        ID3DBlob* b = shader_blob_cache_find(k ? &g.ps_blobs : &g.vs_blobs, src, len, h, NULL, NULL);
+        if (b) { b->lpVtbl->Release(b); continue; }
+        char path[MAX_PATH];
+        if (shader_disk_cache_path(path, k ? 'P' : 'V', h, len) &&
+            GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES) continue;
+        return 1;
+    }
+    return 0;
+}
+
+/* The draw at slot's pipeline is being compiled. A draw whose loss would show (display buffer,
+ * full-screen pass) gets it now -- built here if no worker has started it, else waited for, as
+ * before fix 62. Any other draw is skipped until it is ready (the object appears a few frames late
+ * instead of freezing the game). Returns the pipeline, or NULL = skip. */
+static ID3D12PipelineState* ld_pso_wait(u32 slot)
+{
+    ld_pso_job* j = g.psos[slot].job;
+    if (!ld_pso_draw_critical()) {
+        if (ld_pso_job_done(j)) { ld_pso_harvest(slot); return g.psos[slot].pso; }
+        j->skipped++;
+        g_ld_pso_async_skips++;
+        return NULL;
+    }
+    const unsigned long long t0 = ps3_qpc_us();
+    int run_here = 0;
+    EnterCriticalSection(&g_ld_pq_lock);
+    if (j->state == 0) {   /* still queued: take it out, build it on this thread */
+        ld_pso_job** pp = &g_ld_pq_head; ld_pso_job* prev = NULL;
+        while (*pp && *pp != j) { prev = *pp; pp = &(*pp)->next; }
+        if (*pp) {
+            *pp = j->next;
+            if (g_ld_pq_tail == j) g_ld_pq_tail = prev;
+            j->next = NULL; j->state = 1; run_here = 1;
+        }
+    }
+    LeaveCriticalSection(&g_ld_pq_lock);
+    if (run_here) { ld_pso_job_run(j); ld_pso_job_finish(j); }
+    else WaitForSingleObject(j->done, INFINITE);
+    const unsigned long long waited = ps3_qpc_us() - t0;
+    if (waited >= 1000) ps3_perf_note("psow %.1f %d", waited / 1000.0, run_here);
+    ld_pso_harvest(slot);
+    return g.psos[slot].pso;
+}
+
+/* Shutdown: stop the workers before the device goes (they call into it). */
+static void ld_pso_async_shutdown(void)
+{
+    if (g_ld_pso_async <= 0) return;
+    EnterCriticalSection(&g_ld_pq_lock);
+    g_ld_pq_quit = 1;
+    LeaveCriticalSection(&g_ld_pq_lock);
+    WakeAllConditionVariable(&g_ld_pq_cv);
+    if (g_ld_pq_nthr) WaitForMultipleObjects((DWORD)g_ld_pq_nthr, g_ld_pq_thr, TRUE, 5000);
+    for (int i = 0; i < g_ld_pq_nthr; i++) CloseHandle(g_ld_pq_thr[i]);
+    g_ld_pq_nthr = 0;
+    while (g_ld_n_pso_pending) {
+        const u32 slot = g_ld_pso_pending[0];
+        ld_pso_job* j = g.psos[slot].job;
+        if (j->state != 2) { j->pso = NULL; j->state = 2; }   /* never built */
+        ld_pso_harvest(slot);
+    }
+    fprintf(stderr, "[pso-async] %llu pipelines built off-thread, %llu draws skipped while building\n",
+            g_ld_pso_async_n, g_ld_pso_async_skips);
+}
+
+static int ld_current_vertex_layout(rsx_vertex_layout_plan* layout)
+{
+    const u32 start = rsx_dsp_vp_start(&g.rsx);
+    if (start >= RSX_DSP_VP_INSTR) {
+        ld_layout_plan_get(0xFFFFu, layout);
+        return 0;
+    }
+    const u8* vp_uc = (const u8*)(g.rsx.vp + start * 4);
+    const u32 vp_instrs = rsx_vp_program_size_instrs(
+        vp_uc, (RSX_DSP_VP_INSTR - start) * 16);
+    rsx_vp_input_analysis analysis = {0xFFFFu, 0};
+    if (!vp_instrs ||
+        rsx_vp_analyze_inputs(
+            vp_uc, vp_instrs * 16, &analysis) != (int)vp_instrs ||
+        !analysis.exact)
+        analysis.input_mask = 0xFFFFu;
+    ld_layout_plan_get(analysis.input_mask, layout);
+    return vp_instrs != 0;
+}
+
+/* LD_PSO_DBG=1: name the first bail-out of each kind in get_pso(). Every exit
+ * there returns NULL silently and the caller only counts drop{pso=N}, so a
+ * title whose draws ALL die in this function has no way to say which gate
+ * rejected them. One line per distinct reason, so a stuck title prints a
+ * handful of lines rather than one per draw. */
+static void ld_pso_bail(int* said, const char* reason)
+{
+    static int dbg = -1;
+    if (dbg < 0) dbg = getenv("LD_PSO_DBG") ? 1 : 0;
+    if (!dbg || *said) return;
+    *said = 1;
+    fprintf(stderr, "[pso-bail] %s\n", reason);
+    fflush(stderr);
+}
+#define LD_PSO_BAIL(reason) \
+    do { static int _said_ = 0; ld_pso_bail(&_said_, (reason)); } while (0)
+
+static u32 g_ld_draw_nverts;   /* vertex count of the draw being set up (diagnostics) */
+/* Fragment-program memo (Demon's Souls NOTES fix 55). get_pso decoded the bound program's size
+ * (rsx_fp_program_size) and hashed it byte by byte (rsx_fp_structural_hash, FNV-1a) on every draw --
+ * ~7% of the renderer thread. Both read only the instruction blocks (the inline constant slots,
+ * which games patch per draw, are skipped). So per program address a copy of the program and its
+ * constant-slot mask is kept: when every instruction block still matches the copy byte for byte,
+ * the size and the structural hash (per seed) are what those functions would return.
+ * LD_FP_MEMO=0 = off. */
+#define LD_FPM_N 64u
+#define LD_FPM_BYTES 4096u
+typedef struct {
+    u32 loc, off, size, valid;
+    u64 seed[4], shash[4]; u32 next_seed;
+    u8 cmask[LD_FPM_BYTES / 16 / 8];
+    u8 code[LD_FPM_BYTES];
+} ld_fpm_t;
+static ld_fpm_t g_fpm[LD_FPM_N];
+static ld_fpm_t* g_fpm_cur;   /* the entry ld_fpm_size matched or filled for this draw */
+
+static unsigned long long g_memo_checks, g_memo_bad;
+static int ld_memo_check(void)   /* LD_MEMO_CHECK=1 (debug): compute both ways, log differences */
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_MEMO_CHECK") ? 1 : 0;
+    return on;
+}
+static void ld_memo_report(const char* what, unsigned long long a, unsigned long long b)
+{
+    g_memo_checks++;
+    if (a != b && ++g_memo_bad <= 20)
+        fprintf(stderr, "[memo-check] MISMATCH %s: memo %llX original %llX\n", what, a, b);
+    if ((g_memo_checks & 0xFFFFF) == 0)
+        fprintf(stderr, "[memo-check] %llu checks, %llu mismatches\n", g_memo_checks, g_memo_bad);
+}
+
+static int ld_fpm_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_FP_MEMO"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+
+static int ld_fpm_same(const ld_fpm_t* m, const u8* p)
+{
+    for (u32 b = 0; b < m->size / 16; b++) {
+        if (m->cmask[b / 8] & (1u << (b & 7))) continue;
+        u64 x[2], y[2];
+        memcpy(x, p + b * 16, 16); memcpy(y, m->code + b * 16, 16);
+        if (x[0] != y[0] || x[1] != y[1]) return 0;
+    }
+    return 1;
+}
+
+/* = rsx_fp_program_size(head, 0x10000) for the program at (loc, off); head maps >= 16 bytes. */
+static u32 ld_fpm_size(u32 loc, u32 off, const u8* head)
+{
+    g_fpm_cur = NULL;
+    if (!ld_fpm_on()) return rsx_fp_program_size(head, 0x10000);
+    ld_fpm_t* m = &g_fpm[((off >> 4) ^ (off >> 12) ^ (loc << 5)) & (LD_FPM_N - 1u)];
+    if (m->valid && m->loc == loc && m->off == off) {
+        const u8* p = guest_ptr(loc, off, m->size);
+        if (p && ld_fpm_same(m, p)) {
+            g_fpm_cur = m;
+            if (ld_memo_check()) ld_memo_report("fp size", m->size, rsx_fp_program_size(head, 0x10000));
+            return m->size;
+        }
+    }
+    const u32 size = rsx_fp_program_size(head, 0x10000);
+    u8 cm[LD_FPM_BYTES / 16 / 8];
+    const u8* p = size && size <= LD_FPM_BYTES ? guest_ptr(loc, off, size) : NULL;
+    if (p && rsx_fp_program_layout(p, 0x10000, cm, sizeof cm) == size) {
+        m->loc = loc; m->off = off; m->size = size; m->valid = 1;
+        memcpy(m->cmask, cm, sizeof cm);
+        memcpy(m->code, p, size);
+        m->seed[0] = m->seed[1] = m->seed[2] = m->seed[3] = 0; m->next_seed = 0;
+        m->shash[0] = m->shash[1] = m->shash[2] = m->shash[3] = 0;
+        g_fpm_cur = m;
+    } else m->valid = 0;
+    return size;
+}
+
+/* = rsx_fp_structural_hash(uc, size, seed), from the memo entry ld_fpm_size matched. */
+static u64 ld_fpm_structural(const u8* uc, u32 size, u64 seed)
+{
+    ld_fpm_t* m = g_fpm_cur;
+    if (!m || m->size != size) return rsx_fp_structural_hash(uc, size, seed);
+    for (u32 i = 0; i < 4; i++)
+        if (m->shash[i] && m->seed[i] == seed) {
+            if (ld_memo_check()) ld_memo_report("fp hash", m->shash[i], rsx_fp_structural_hash(uc, size, seed));
+            return m->shash[i];
+        }
+    const u64 h = rsx_fp_structural_hash(uc, size, seed);
+    if (h) { const u32 i = m->next_seed++ & 3u; m->seed[i] = seed; m->shash[i] = h; }
+    return h;
+}
+
+static ID3D12PipelineState* get_pso(
+    const rsx_vertex_layout_plan* masked_layout, int packed_payload, u32* pending)
+{
+    memset(&g_ld_current_pso, 0, sizeof(g_ld_current_pso));
+    const u32 start = rsx_dsp_vp_start(&g.rsx);
+    if (start >= RSX_DSP_VP_INSTR) { LD_PSO_BAIL("no vertex program uploaded (vp start out of range)"); return NULL; }
+    const u8* vp_uc = (const u8*)(g.rsx.vp + start * 4);
+    /* The program's length, FNV hash and texture-fetch mask depend only on the
+     * vp[] words: recomputed only when the start slot changes or a program
+     * word was written since (rsx_dispatch_vp_generation). The byte-wise hash
+     * ran twice per draw over the whole program -- ~4% of the renderer thread
+     * by the Boletaria scaffolding (NOTES fix 48). Same values as before. */
+    static struct { u32 valid, start, gen, instrs, txl; u64 hash; } vpm;
+    {
+        extern u32 rsx_dispatch_vp_generation;
+        const u32 gen = rsx_dispatch_vp_generation;
+        if (!vpm.valid || vpm.start != start || vpm.gen != gen) {
+            vpm.instrs = rsx_vp_program_size_instrs(vp_uc, (RSX_DSP_VP_INSTR - start) * 16);
+            vpm.hash = fnv1a(vp_uc, vpm.instrs * 16, 1469598103934665603ull);
+            vpm.txl = vp_txl_unit_mask(vp_uc, vpm.instrs);
+            vpm.start = start; vpm.gen = gen; vpm.valid = 1;
+        }
+    }
+    const u32 vp_instrs = vpm.instrs;
+    if (!vp_instrs) { LD_PSO_BAIL("vertex program has zero instructions"); return NULL; }
+
+    u32 fp_loc = 0;
+    const u32 fp_off = rsx_dsp_fragment_program(&g.rsx, &fp_loc);
+    const u8* fp_uc = guest_ptr(fp_loc, fp_off, 16);
+    if (!fp_uc) { LD_PSO_BAIL("fragment program address does not resolve to guest memory"); return NULL; }
+    const u32 fp_size = ld_fpm_size(fp_loc, fp_off, fp_uc);
+    if (!fp_size) {
+        /* No END-bit instruction in 64 KB: the bytes at (location, offset) are
+         * not a fragment program. Almost always the LOCATION is wrong, not the
+         * offset -- the same class of bug caner hit in Yakuza with textures --
+         * so report the register the guest actually wrote and the head of what
+         * we read, which is what says local-vs-main. */
+        static int said = 0;
+        /* LD_PSO_DBG=3: report every distinct failing program register (up to
+         * 16), not just the first -- tells "one bad program" from "all bad". */
+        { static u32 seen[16]; static int nseen = 0;
+          const char* dbg = getenv("LD_PSO_DBG");
+          if (dbg && atoi(dbg) >= 3) {
+              const u32 reg = rsx_dsp_reg(&g.rsx, 0x08E4);
+              int k = 0;
+              while (k < nseen && seen[k] != reg) k++;
+              if (k == nseen && nseen < 16) {
+                  seen[nseen++] = reg;
+                  fprintf(stderr, "[pso-bail] distinct FP reg 0x%08X empty (frame %u)\n",
+                          reg, (unsigned)g_ld_frames);
+              }
+          } }
+        if (!said && getenv("LD_PSO_DBG")) {
+            said = 1;
+            fprintf(stderr,
+                    "[pso-bail] fragment program size reads as zero: "
+                    "reg=0x%08X -> loc=%u off=0x%08X, first words "
+                    "%08X %08X %08X %08X\n",
+                    rsx_dsp_reg(&g.rsx, 0x08E4 /* M_FP_ACTIVE_PROGRAM */), fp_loc, fp_off,
+                    rsx_fp_read_word(fp_uc + 0), rsx_fp_read_word(fp_uc + 4),
+                    rsx_fp_read_word(fp_uc + 8), rsx_fp_read_word(fp_uc + 12));
+            /* All-zero here has two very different causes: the offset resolved
+             * into the wrong memory, or nothing ever wrote the buffer. Scan
+             * forward for the first non-zero byte -- a hit a few hundred bytes
+             * on means the region IS populated and the offset is wrong; no hit
+             * across 64 KB means the producer never ran. */
+            {
+                const u8* q = guest_ptr(fp_loc, fp_off, 0x10000);
+                u32 i = 0;
+                if (q) { while (i < 0x10000u && !q[i]) i++; }
+                if (!q)
+                    fprintf(stderr, "[pso-bail]   (64 KB window not mapped)\n");
+                else if (i == 0x10000u)
+                    fprintf(stderr, "[pso-bail]   64 KB from here is entirely "
+                                    "zero -- nothing ever wrote this buffer\n");
+                else
+                    fprintf(stderr, "[pso-bail]   first non-zero byte at "
+                                    "+0x%X -- the region is populated, the "
+                                    "offset is wrong\n", i);
+                /* LD_PSO_DBG=2: hexdump the window, so it can be read as
+                 * microcode or as something else (allocator headers, ...). */
+                if (q && atoi(getenv("LD_PSO_DBG")) >= 2) {
+                    for (u32 r = 0; r < 0x200; r += 16)
+                        fprintf(stderr, "[pso-bail]   +%03X: %08X %08X %08X %08X\n", r,
+                                rsx_fp_read_word(q + r), rsx_fp_read_word(q + r + 4),
+                                rsx_fp_read_word(q + r + 8), rsx_fp_read_word(q + r + 12));
+                }
+            }
+            fflush(stderr);
+        }
+        return NULL;
+    }
+    /* re-resolve with the true size to validate the whole program is mapped */
+    fp_uc = guest_ptr(fp_loc, fp_off, fp_size);
+    if (!fp_uc) { LD_PSO_BAIL("fragment program is not fully mapped in guest memory"); return NULL; }
+
+    /* Fragment output register mode (fp16 h0 vs fp32 r0) is driven by the
+     * SHADER_CONTROL word bit 0x40 (same fix as the replay harness â€” the
+     * AUTO heuristic returned stale fp32 scratch for h0-writing materials);
+     * fold the deciding bit into the cache key so a program reused under a
+     * different export mode gets its own PSO. Kill-switch RSX_FP_CTRL_AUTO=1
+     * restores the old heuristic for the A/B. */
+    static int ctrl_auto = -1;
+    if (ctrl_auto < 0) ctrl_auto = getenv("RSX_FP_CTRL_AUTO") ? 1 : 0;
+    const u32 fp_ctrl = ctrl_auto ? RSX_FP_CTRL_AUTO : rsx_dsp_shader_control(&g.rsx);
+    u32 cube_mask = 0;
+    for (u32 unit = 0; unit < RSX_DSP_NUM_TEXTURES; unit++) {
+        rsx_dsp_texture texture;
+        rsx_dsp_get_texture(&g.rsx, unit, &texture);
+        if (texture.enabled && texture.cubemap)
+            cube_mask |= 1u << unit;
+    }
+    const u32 vtex_mask = vertex_texture_mask();
+    const u32 txl_mask = vpm.txl;
+    if (txl_mask && !(txl_mask & vtex_mask)) {
+        g_ld_vtex_missing_for_txl++;
+        static u32 warned = 0;
+        if (PS3_LOG_FIRST(warned, 32) && vertex_texture_trace_enabled()) {
+            fprintf(stderr,
+                    "[vtex] TXL shader has no supported binding txl=0x%X "
+                    "bound=0x%X start=%u instrs=%u\n",
+                    txl_mask, vtex_mask, start, vp_instrs);
+            for (u32 u = 0; u < RSX_DSP_NUM_VERTEX_TEXTURES; u++) {
+                if (!((txl_mask >> u) & 1u)) continue;
+                const u32 base = 0x0900 + u * 0x20;
+                fprintf(stderr,
+                        "[vtex] raw u%u off=%08X fmt=%08X wrap=%08X "
+                        "ctl0=%08X ctl3=%08X filter=%08X rect=%08X\n",
+                        u, rsx_dsp_reg(&g.rsx, base),
+                        rsx_dsp_reg(&g.rsx, base + 4),
+                        rsx_dsp_reg(&g.rsx, base + 8),
+                        rsx_dsp_reg(&g.rsx, base + 12),
+                        rsx_dsp_reg(&g.rsx, base + 16),
+                        rsx_dsp_reg(&g.rsx, base + 20),
+                        rsx_dsp_reg(&g.rsx, base + 24));
+            }
+        }
+    }
+
+    render_state_t rs;
+    decode_render_state(&rs);
+    if (rsx_fp_collect_constants(
+            fp_uc, fp_size, &g.fp_constants) < 0) {
+        LD_PSO_BAIL("fragment program constant collection failed");
+        return NULL;
+    }
+    /* LD_FPCONST=<pso key hex> [LD_FPCONST_FROM=<frame>]: the inline fragment
+     * constants of that pipeline's first draws, as floats -- a shader whose
+     * output is all black is either sampling black or multiplying by a zero
+     * constant, and only the values say which. */
+    { static u64 ck = 1; static u32 from, n, csurf = ~0u;
+      if (ck == 1) { const char* e = getenv("LD_FPCONST"); ck = e ? _strtoui64(e, 0, 16) : 0;
+                     e = getenv("LD_FPCONST_FROM"); from = e ? (u32)atoi(e) : 0;
+                     /* LD_FPCONST_SURF=<offset hex>: the same dump for draws into that colour surface */
+                     e = getenv("LD_FPCONST_SURF"); if (e) { csurf = (u32)strtoul(e, NULL, 16); if (!ck) ck = 2; } }
+      int csurf_hit = 0;
+      if (csurf != ~0u) { rsx_dsp_surface fsf; rsx_dsp_get_surface(&g.rsx, &fsf); csurf_hit = fsf.color_offset[0] == csurf; }
+      /* LD_FPCONST_TEX0=<offset hex>: draws whose texture unit 0 is at that offset (one mesh) */
+      { static u32 ctex = 1;
+        if (ctex == 1) { const char* e = getenv("LD_FPCONST_TEX0"); ctex = e ? (u32)strtoul(e, NULL, 16) : ~0u;
+                         if (ctex != ~0u && !ck) ck = 2; }
+        if (ctex != ~0u) { rsx_dsp_texture t0; rsx_dsp_get_texture(&g.rsx, 0, &t0);
+                           csurf_hit = t0.enabled && t0.offset == ctex; } }
+      /* LD_FPCONST_VERTS=<n>: draws with exactly n vertices (after strip/fan expansion, the CSV's verts) */
+      { static long cv = -2;
+        if (cv == -2) { const char* e = getenv("LD_FPCONST_VERTS"); cv = e ? atol(e) : -1; if (cv >= 0 && !ck) ck = 2; }
+        if (cv >= 0) csurf_hit = g_ld_draw_nverts == (u32)cv; }
+      if (ck && g_ld_frames >= from && n < 6 && (live_legacy_pso_key() == ck || csurf_hit)) {
+          n++;
+          fprintf(stderr, "[fpconst] frame %u key %016llx fp loc=%u off=0x%08X size=%u count=%u\n", g_ld_frames,
+                  (unsigned long long)live_legacy_pso_key(), fp_loc, fp_off, fp_size, g.fp_constants.count);
+          /* LD_FPCONST_VPC=<first>,<count>: also print those vertex-program constants */
+          { const char* e = getenv("LD_FPCONST_VPC");
+            if (e) { u32 c0 = (u32)strtoul(e, NULL, 0), cn = 8; const char* cm = strchr(e, ',');
+                     if (cm) cn = (u32)strtoul(cm + 1, NULL, 0);
+                     for (u32 c = c0; c < c0 + cn && c < RSX_DSP_NUM_CONSTANTS; c++)
+                         fprintf(stderr, "    vc%u %g %g %g %g\n", c, ld_c2f(g.rsx.constants[c][0]),
+                                 ld_c2f(g.rsx.constants[c][1]), ld_c2f(g.rsx.constants[c][2]),
+                                 ld_c2f(g.rsx.constants[c][3])); } }
+          if (n == 1) {   /* the draw's vertex attributes: format/stride and vertices 0..2 decoded */
+              const u32 vbase = rsx_dsp_vertex_data_base_offset(&g.rsx);
+              for (u32 at = 0; at < 16; at++) {
+                  rsx_dsp_vertex_attr va; rsx_dsp_get_vertex_attr(&g.rsx, at, &va);
+                  if (!va.type || !va.size) continue;
+                  fprintf(stderr, "    attr%u type=%u size=%u stride=%u loc=%u off=0x%08X base=0x%X:", at, va.type, va.size, va.stride,
+                          va.location, va.offset, vbase);
+                  for (u32 vi = 0; vi < 3; vi++) {
+                      float o4[4] = {0, 0, 0, 1};
+                      fetch_attr(at, vbase, vi, 0, o4);
+                      fprintf(stderr, " (%.3f %.3f %.3f %.3f)", o4[0], o4[1], o4[2], o4[3]);
+                  }
+                  fprintf(stderr, "\n");
+              }
+          }
+          /* First dump only: every other copy of this program in guest memory
+           * (same first 64 bytes) and its last two constants -- a program that
+           * is patched in a copy the draw does not point at shows up here. */
+          if (n == 1) {   /* LD_MEMDUMP=<dir>: guest main (512 MB) + RSX local (256 MB) to files */
+              extern uint8_t* vm_base;
+              const char* md = getenv("LD_MEMDUMP");
+              if (md && vm_base) {
+                  /* 64 KB at a time; uncommitted guest pages are written as zeros. */
+                  static const struct { const char* name; u32 ea, len; } rg[2] = {
+                      { "main_00000000.bin", 0x00000000u, 0x20000000u },
+                      { "local_C0000000.bin", 0xC0000000u, 0x10000000u } };
+                  static uint8_t zero[0x10000];
+                  for (int r = 0; r < 2; r++) {
+                      char fn[MAX_PATH]; FILE* f;
+                      snprintf(fn, sizeof fn, "%s/%s", md, rg[r].name);
+                      if (!(f = fopen(fn, "wb"))) continue;
+                      for (u32 o = 0; o < rg[r].len; o += 0x1000u) {   /* per page */
+                          const uint8_t* p = vm_base + rg[r].ea + o;
+                          MEMORY_BASIC_INFORMATION mbi;
+                          const int ok = VirtualQuery(p, &mbi, sizeof mbi) && mbi.State == MEM_COMMIT &&
+                                         !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD));
+                          fwrite(ok ? p : zero, 1, 0x1000u, f);
+                      }
+                      fclose(f);
+                  }
+                  fprintf(stderr, "[fpconst] memory dumped to %s\n", md);
+              }
+          }
+          if (n == 1) {   /* where (0, 2, 0, 1) lives un-swapped in main memory */
+              extern uint8_t* vm_base;
+              static const uint8_t pat[16] = {0,0,0,0, 0x40,0,0,0, 0,0,0,0, 0x3F,0x80,0,0};
+              int hits = 0;
+              for (u32 o = 0; vm_base && o + 16 <= 0x20000000u && hits < 40; o += 4)
+                  if (memcmp(vm_base + o, pat, 16) == 0) {
+                      hits++;
+                      fprintf(stderr, "    tone-vec ea=0x%08X  before: %08X %08X %08X %08X\n", o,
+                              o >= 16 ? __builtin_bswap32(*(const u32*)(vm_base + o - 16)) : 0,
+                              o >= 16 ? __builtin_bswap32(*(const u32*)(vm_base + o - 12)) : 0,
+                              o >= 16 ? __builtin_bswap32(*(const u32*)(vm_base + o - 8)) : 0,
+                              o >= 16 ? __builtin_bswap32(*(const u32*)(vm_base + o - 4)) : 0);
+                  }
+          }
+          if (n == 1) {   /* the program itself, as host-order words */
+              for (u32 o = 0; o < fp_size; o += 16)
+                  fprintf(stderr, "    uc+%03X %08X %08X %08X %08X\n", o,
+                          rsx_fp_read_word(fp_uc + o), rsx_fp_read_word(fp_uc + o + 4),
+                          rsx_fp_read_word(fp_uc + o + 8), rsx_fp_read_word(fp_uc + o + 12));
+          }
+          if (n == 1 && fp_size >= 64) {
+              /* All of guest main memory too, not only what is IO-mapped. */
+              { extern uint8_t* vm_base;
+                for (u32 o = 0; vm_base && o + fp_size <= 0x20000000u; o += 16) {
+                    if (memcmp(vm_base + o, fp_uc, 64) != 0) continue;
+                    rsx_fp_constant_block cb;
+                    if (rsx_fp_collect_constants(vm_base + o, fp_size, &cb) < 0 || cb.count < 2) continue;
+                    const u32 a = cb.count - 2;
+                    fprintf(stderr, "    copy ea=0x%08X%s c%u=(%g %g %g %g)\n", o,
+                            (vm_base + o == fp_uc) ? " <- drawn" : "", a,
+                            ld_c2f(cb.values[a][0]), ld_c2f(cb.values[a][1]),
+                            ld_c2f(cb.values[a][2]), ld_c2f(cb.values[a][3]));
+                } }
+              for (u32 loc = 0; loc < 2; loc++) {
+                  const u32 span = loc ? 0x0F900000u : 0x10000000u;
+                  const u8* base = guest_ptr(loc, 0, span);
+                  if (!base) continue;
+                  for (u32 o = 0; o + fp_size <= span; o += 16) {
+                      /* instruction words only: a patched copy differs in its constants */
+                      if (memcmp(base + o, fp_uc, 16) != 0 ||
+                          (fp_size >= 0x390 && memcmp(base + o + 0x380, fp_uc + 0x380, 16) != 0)) continue;
+                      rsx_fp_constant_block cb;
+                      if (rsx_fp_collect_constants(base + o, fp_size, &cb) < 0 || cb.count < 2) continue;
+                      const u32 a = cb.count - 2, b = cb.count - 1;
+                      fprintf(stderr, "    copy loc=%u off=0x%08X%s c%u=(%g %g %g %g) c%u=(%g %g %g %g)\n",
+                              loc, o, (loc == fp_loc && o == fp_off) ? " <- drawn" : "",
+                              a, ld_c2f(cb.values[a][0]), ld_c2f(cb.values[a][1]), ld_c2f(cb.values[a][2]), ld_c2f(cb.values[a][3]),
+                              b, ld_c2f(cb.values[b][0]), ld_c2f(cb.values[b][1]), ld_c2f(cb.values[b][2]), ld_c2f(cb.values[b][3]));
+                  }
+              }
+          }
+          for (u32 c = 0; c < g.fp_constants.count; c++)
+              fprintf(stderr, "    c%-2u %12.5g %12.5g %12.5g %12.5g\n", c,
+                      ld_c2f(g.fp_constants.values[c][0]), ld_c2f(g.fp_constants.values[c][1]),
+                      ld_c2f(g.fp_constants.values[c][2]), ld_c2f(g.fp_constants.values[c][3]));
+      } }
+    g.fp_alpha_ref = rsx_fp_alpha_ref(
+        rs.alpha_ref_raw, rs.alpha_ref_format);
+
+    u64 key = vpm.hash;
+    if (ld_fp_constants_buffered())
+        key = ld_fpm_structural(fp_uc, fp_size, key);
+    else
+        key = fnv1a(fp_uc, fp_size, key);
+    if (!key) {
+        LD_PSO_BAIL("shader hash collapsed to zero");
+        return NULL;
+    }
+    const u32 fp_ctrl_key = fp_ctrl & 0x4Eu;   /* 32-bit exports, depth export */
+    key = fnv1a(&fp_ctrl_key, sizeof(fp_ctrl_key), key);
+    key = fnv1a(&cube_mask, sizeof(cube_mask), key);
+    key = fnv1a(&vtex_mask, sizeof(vtex_mask), key);
+    /* Depth-texture comparison (Demon's Souls NOTES fix 70). A shadow map is a depth texture whose
+     * TEXTURE_ADDRESS zfunc asks the RSX to compare the stored depth with the lookup's reference
+     * and return 0 or 1; the fragment program only sees that result. The translator supports it
+     * (rsx_fp_shadow_desc, the shared engine and Metal use it) but this renderer never passed the
+     * state, so every shadow lookup returned the raw stored depth (~1.0) and the game lit what it
+     * meant to shadow ("white shadows", GitHub issue #10). Layouts the translator cannot compare
+     * (enabled=2: float depth, cubes, mips...) keep the raw sampling instead of failing the draw.
+     * LD_SHADOW_COMPARE=0 = raw sampling everywhere, as before. */
+    rsx_fp_shadow_desc shadow[16];
+    memset(shadow, 0, sizeof shadow);
+    int any_shadow = 0;
+    u32 shadow_sc[16] = {0}, any_shadow_sc = 0;   /* UNNORM compare units on a scaled snapshot (fix 74) */
+    { static int on = -1;
+      if (on < 0) { const char* e = getenv("LD_SHADOW_COMPARE"); on = !(e && *e == '0'); }
+      const u32 sampled = on ? rsx_fp_texture_units(fp_uc, fp_size) : 0;
+      for (u32 u = 0; u < 16; u++) {
+          if (!(sampled & (1u << u))) continue;
+          rsx_dsp_texture t;
+          rsx_dsp_get_texture(&g.rsx, u, &t);
+          if (!t.enabled) continue;
+          rsx_fp_shadow_desc_from_texture(&shadow[u], t.format, t.dimension, t.cubemap, t.mipmaps,
+                                          t.filter, t.wrap, t.control0);
+          /* The compare reads depth from .r, which only the R32F zeta snapshot provides: a D16
+           * texture, or a D24 one that will be read from guest memory, keeps raw sampling. */
+          if (shadow[u].enabled == 1) {
+              int snap = 0;
+              if ((t.format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM) == TEX_FMT_DEPTH24_D8)
+                  for (u32 zi = 0; zi < g.n_zdepths; zi++)
+                      if (g.zdepths[zi].location == t.location && g.zdepths[zi].offset == t.offset &&
+                          (g.zdepths[zi].had_write || g.zdepths[zi].snapshot_valid)) {
+                          snap = 1;
+                          if (shadow[u].unnormalized && g.zdepths[zi].sc > 1)
+                              { shadow_sc[u] = g.zdepths[zi].sc; any_shadow_sc = 1; }
+                          break;
+                      }
+              if (!snap) memset(&shadow[u], 0, sizeof shadow[u]);
+          }
+          if (shadow[u].enabled == 2) {
+              static u32 said;
+              if (PS3_LOG_FIRST(said, 8))
+                  fprintf(stderr, "[shadow] unit %u: comparison layout not supported (fmt 0x%X dim %u "
+                          "cube %u mips %u filter 0x%X) -- raw depth\n", u, t.format, t.dimension,
+                          t.cubemap, t.mipmaps, t.filter);
+              memset(&shadow[u], 0, sizeof shadow[u]);
+          }
+          if (shadow[u].enabled) any_shadow = 1;
+      } }
+    if (any_shadow) key = fnv1a(shadow, sizeof shadow, key);
+    if (any_shadow_sc) key = fnv1a(shadow_sc, sizeof shadow_sc, key);
+    /* BRB/CLB outcomes are baked into the program (rsx_vp_set_branch_bits). */
+    const int vp_branch_bits_used = rsx_vp_uses_branch_bits(vp_uc, vp_instrs * 16);
+    const u32 vp_branch_bits = vp_branch_bits_used ? rsx_dsp_reg(&g.rsx, 0x1FF8u) : 0;
+    if (vp_branch_bits_used)
+        key = fnv1a(&vp_branch_bits, sizeof(vp_branch_bits), key);
+    /* Texel-addressed (RSX_TEX_FMT_UNNORM) units need their coordinates divided
+     * by the texture size in the shader -- D3D12 has no unnormalised addressing
+     * mode. The divisor is baked into the HLSL, so the sizes are part of the
+     * PSO identity and must be in the key. */
+    u32 unnorm_mask = 0;
+    u32 unnorm_dim[16][3] = {{0}};
+    for (u32 uu = 0; uu < 16; uu++) {
+        rsx_dsp_texture ut; rsx_dsp_get_texture(&g.rsx, uu, &ut);
+        if (!ut.enabled || !(ut.format & TEX_FMT_UNNORM)) continue;
+        if (!ut.width || !ut.height) continue;
+        unnorm_mask |= 1u << uu;
+        unnorm_dim[uu][0] = ut.width;
+        unnorm_dim[uu][1] = ut.height;
+        /* A depth texture bound to a zeta's snapshot reads that host
+         * resource, which is as large as the largest pass that used the zeta
+         * (bounded by the zeta), not as large as the texture. Texel
+         * coordinates address the resource, so divide by its size: a texture
+         * smaller than the zeta then reads its top-left corner, as it does in
+         * VRAM, instead of a stretched copy of the whole depth buffer. */
+        if ((ut.format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM) ==
+                TEX_FMT_DEPTH24_D8) {
+            for (u32 zi = 0; zi < g.n_zdepths; zi++) {
+                const zdepth_t* z = &g.zdepths[zi];
+                if (z->location != ut.location || z->offset != ut.offset)
+                    continue;
+                /* Only when the bind will take the snapshot (it has, or
+                 * will copy, a depth-writing pass); a zeta that was only
+                 * cleared is read from guest memory at texture size. */
+                if (z->snapshot && (z->had_write || z->snapshot_valid) &&
+                    z->snapshot_w >= ut.width &&
+                    z->snapshot_h >= ut.height) {
+                    unnorm_dim[uu][0] = z->snapshot_w;
+                    unnorm_dim[uu][1] = z->snapshot_h;
+                }
+                break;
+            }
+        }
+    }
+    key = fnv1a(&unnorm_mask, sizeof(unnorm_mask), key);
+    if (unnorm_mask) key = fnv1a(unnorm_dim, sizeof(unnorm_dim), key);
+    /* A scaled target (fix 74): programs that read WPOS get it in guest pixels. Not in the key at
+     * 1x, so unscaled keys (and the disk shader cache) stay as they were. */
+    u32 wpos_sc = 1;
+    { rsx_dsp_surface wsf; rsx_dsp_get_surface(&g.rsx, &wsf);
+      wpos_sc = ld_surface_scale(wsf.clip_w ? wsf.clip_w : g.width, wsf.clip_h ? wsf.clip_h : g.height); }
+    if (wpos_sc > 1) key = fnv1a(&wpos_sc, sizeof(wpos_sc), key);
+    if (masked_layout) {
+        static const u32 masked_layout_tag = 0x314B534Du; /* "MSK1" */
+        const u32 payload_stride =
+            packed_payload ? masked_layout->stride : VERT_STRIDE;
+        key = fnv1a(
+            &masked_layout_tag, sizeof(masked_layout_tag), key);
+        key = fnv1a(
+            &masked_layout->mask, sizeof(masked_layout->mask), key);
+        key = fnv1a(
+            &payload_stride, sizeof(payload_stride), key);
+        key = fnv1a(
+            &packed_payload, sizeof(packed_payload), key);
+    }
+    if (ld_fp_constants_buffered())
+        key = ld_hash_structural_render_state(&rs, key);
+    else
+        key = fnv1a(&rs, sizeof(rs), key);
+#if defined(YZ_PERF_PROFILE)
+    ld_profile_note_fp_variants(
+        fp_uc, fp_size, fp_ctrl_key, cube_mask, &rs);
+#endif
+    g_ld_current_pso.valid = 1;
+    g_ld_current_pso.key = key;
+    g_ld_current_pso.vp_hash = vpm.hash;
+    g_ld_current_pso.vp_start = start;
+    g_ld_current_pso.vp_instrs = vp_instrs;
+    g_ld_current_pso.fp_location = fp_loc;
+    g_ld_current_pso.fp_offset = fp_off;
+    g_ld_current_pso.fp_size = fp_size;
+    g_ld_current_pso.fp_control = fp_ctrl;
+    g_ld_current_pso.cube_mask = cube_mask;
+    g_ld_current_pso.vtex_mask = vtex_mask;
+    g_ld_current_pso.txl_mask = txl_mask;
+    g_ld_current_pso.input_mask =
+        masked_layout ? masked_layout->mask : 0xFFFFu;
+    g_ld_current_pso.input_stride =
+        masked_layout && packed_payload
+            ? masked_layout->stride : VERT_STRIDE;
+    g_ld_current_pso.packed_offsets =
+        masked_layout && packed_payload;
+
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.pso_lookups++;
+#endif
+    for (u32 i = 0; i < g.n_psos; i++) {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.pso_probes++;
+#endif
+        if (g.psos[i].key == key) {
+#if defined(YZ_PERF_PROFILE)
+            g_ld_profile.total.pso_hits++;
+#endif
+            if (g.psos[i].job) {   /* being built (fix 62) */
+                if (!ld_pso_job_done(g.psos[i].job)) { *pending = i; return NULL; }
+                ld_pso_harvest(i);
+            }
+            return g.psos[i].pso;
+        }
+    }
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.pso_misses++;
+#endif
+    if (g.n_psos >= MAX_PSOS) {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.pso_full++;
+#endif
+        LD_PSO_BAIL("PSO cache full (MAX_PSOS)");
+        return NULL;
+    }
+
+    static char vs_hlsl[256 * 1024];
+    static char ps_hlsl[256 * 1024];
+    ID3D12PipelineState* pso = NULL;
+#if defined(YZ_PERF_PROFILE)
+    const LONGLONG decompile_begin = ld_profile_qpc();
+#endif
+    rsx_vp_set_branch_base(rsx_dsp_vp_start(&g.rsx));
+    rsx_vp_set_branch_bits(vp_branch_bits);
+    const int vi = masked_layout
+        ? rsx_vp_decompile_compact_ex(
+            vp_uc, vp_instrs * 16, vtex_mask, masked_layout->mask,
+            vs_hlsl, sizeof(vs_hlsl))
+        : rsx_vp_decompile_ex(
+            vp_uc, vp_instrs * 16, vtex_mask, vs_hlsl, sizeof(vs_hlsl));
+    u32 decompiled_constant_count = 0;
+    int fi;
+    if (ld_fp_constants_buffered()) {
+        fi = any_shadow   /* fix 70 */
+            ? rsx_fp_decompile_buffered_shadow_ex(
+                fp_uc, fp_size, fp_ctrl, cube_mask, shadow, ps_hlsl,
+                sizeof(ps_hlsl), &decompiled_constant_count)
+            : rsx_fp_decompile_buffered_ex(
+                fp_uc, fp_size, fp_ctrl, cube_mask, ps_hlsl,
+                sizeof(ps_hlsl), &decompiled_constant_count);
+        if (any_shadow && fi <= 0) {   /* e.g. TXB/TXL on a compare unit: raw sampling, as before */
+            static u32 said;
+            if (PS3_LOG_FIRST(said, 8))
+                fprintf(stderr, "[shadow] comparison not translatable for fp 0x%08X -- raw depth\n", fp_off);
+            fi = rsx_fp_decompile_buffered_ex(
+                fp_uc, fp_size, fp_ctrl, cube_mask, ps_hlsl,
+                sizeof(ps_hlsl), &decompiled_constant_count);
+        }
+        if (fi > 0 &&
+            decompiled_constant_count != g.fp_constants.count)
+            fi = -1;
+        if (fi > 0 && rs.alpha_test_enable &&
+            rsx_fp_apply_alpha_test_buffered(
+                ps_hlsl, sizeof(ps_hlsl), rs.alpha_func) < 0)
+            fi = -1;
+        if (fi > 0) {
+            const int np = rsx_fp_apply_unnorm_scale(
+                ps_hlsl, sizeof(ps_hlsl), unnorm_mask, unnorm_dim, cube_mask, 0u);
+            { static int n = 0;
+              if (PS3_LOG_FIRST(n, 8))
+                  fprintf(stderr, "[unnorm] mask=0x%X cube=0x%X dim0=%ux%u"
+                                  " patched=%d\n",
+                          unnorm_mask, cube_mask, unnorm_dim[0][0],
+                          unnorm_dim[0][1], np); }
+            if (np < 0) fi = -1;
+        }
+    } else {
+        fi = rsx_fp_decompile_ex(
+            fp_uc, fp_size, fp_ctrl, cube_mask,
+            ps_hlsl, sizeof(ps_hlsl));
+        if (fi > 0 && rs.alpha_test_enable &&
+            rsx_fp_apply_alpha_test(
+                ps_hlsl, sizeof(ps_hlsl), rs.alpha_func,
+                g.fp_alpha_ref) < 0)
+            fi = -1;
+        if (fi > 0 && rsx_fp_apply_unnorm_scale(
+                ps_hlsl, sizeof(ps_hlsl), unnorm_mask,
+                unnorm_dim, cube_mask, 0u) < 0)
+            fi = -1;
+    }
+    /* Scaled targets and snapshots (fix 74): WPOS in guest pixels; an UNNORM compare's texel
+     * coordinates over the guest size (its helper divides by the host GetDimensions). */
+    if (fi > 0 && wpos_sc > 1 && rsx_fp_apply_wpos_grid(ps_hlsl, sizeof(ps_hlsl), wpos_sc, wpos_sc) < 0)
+        fi = -1;
+    for (u32 u = 0; fi > 0 && any_shadow_sc && u < 16; u++) {
+        if (!shadow_sc[u]) continue;
+        char fn[48], rep[64];
+        snprintf(fn, sizeof fn, "float4 _rsx_shadow%u(float3 coordinate) {", u);
+        snprintf(rep, sizeof rep, "    float2 uv = coordinate.xy * (%u.0 / size);\n", shadow_sc[u]);
+        static const char old_uv[] = "    float2 uv = coordinate.xy / size;\n";
+        char* at = strstr(ps_hlsl, fn);
+        char* uv = at ? strstr(at, old_uv) : NULL;
+        const size_t len = strlen(ps_hlsl), lo = sizeof old_uv - 1u, ln = strlen(rep);
+        if (!uv || len - lo + ln + 1 > sizeof(ps_hlsl)) { fi = -1; break; }
+        memmove(uv + ln, uv + lo, len - (size_t)(uv - ps_hlsl) - lo + 1);
+        memcpy(uv, rep, ln);
+    }
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.decompile_qpc +=
+        (u64)(ld_profile_qpc() - decompile_begin);
+#endif
+    /* LD_FORCE_GREEN=1: make every fragment program return solid green.
+     *
+     * The same trick as LD_CLEAR_TEST, applied one stage later. Clears are
+     * visible on these surfaces and draws are not, while the engine reports
+     * 18,452 groups executed with zero drops and the GPU state cannot discard
+     * anything (viewport 0,0 720x512, scissor full, depth test off, colour mask
+     * all channels, blend off, cull off). Two possibilities remain and they need
+     * opposite fixes: the draws reach the GPU and the SAMPLED DATA is black, or
+     * they never reach it and the accounting is wrong. Green separates them. */
+    { static int fg = -1;
+      /* LD_FORCE_GREEN=<pso key hex> limits it to one PSO. */
+      static u64 gk = 0;
+      if (fg < 0) { const char* e = getenv("LD_FORCE_GREEN"); fg = e ? 1 : 0;
+                    gk = e ? _strtoui64(e, 0, 16) : 0; if (gk == 1) gk = 0; }
+      if (fg && fi > 0 && (!gk || gk == live_legacy_pso_key())) {
+          /* The emulated alpha test discards before the return, so replacing
+           * only the return still showed nothing for a failing alpha. */
+          for (char* d = strstr(ps_hlsl, "discard;"); d; d = strstr(d, "discard;"))
+              memcpy(d, "        ", 8);
+          char* r = NULL;   /* the LAST return: helpers (shadow compare, fix 70) come first */
+          for (char* q = strstr(ps_hlsl, "    return "); q; q = strstr(q + 1, "    return ")) r = q;
+          if (r) {
+              char* semi = strchr(r, ';');
+              if (semi) {
+                  const char rep[] = "    return float4(0,1,0,1);";
+                  const size_t rl = sizeof(rep) - 1;
+                  const size_t old = (size_t)(semi + 1 - r);
+                  const size_t used = strlen(ps_hlsl);
+                  if (used - old + rl + 1 <= sizeof(ps_hlsl)) {
+                      memmove(r + rl, semi + 1, used - (size_t)(semi + 1 - ps_hlsl) + 1);
+                      memcpy(r, rep, rl);
+                  }
+              }
+          }
+      } }
+    /* LD_FORCE_COL0=1: every vertex program outputs white COLOR0 -- separates
+     * "the VS computes a wrong colour" from everything downstream of it. */
+    /* LD_FORCE_COL0=<pso key hex> limits it to one PSO. */
+    { static int fc = -1; static u64 fk = 0;
+      if (fc < 0) { const char* e = getenv("LD_FORCE_COL0"); fc = e ? 1 : 0;
+                    fk = e ? _strtoui64(e, 0, 16) : 0; if (fk == 1) fk = 0; }
+      char* c0 = fc && vi > 0 && (!fk || fk == live_legacy_pso_key())
+                 ? strstr(vs_hlsl, "Out.col0 = o[1];") : NULL;
+      if (c0) memcpy(c0, "Out.col0=1+0*_p;", 16); }   /* same length, in place */
+    /* LD_PS_OUT=<fp offset hex>:<hlsl expr>: DIAGNOSTIC -- that fragment program's colour output
+     * becomes float4(<expr>) (e.g. "h[5].xyz,1"), to see an intermediate value on screen. */
+    { static int po = -1; static u32 po_off; static const char* po_expr;
+      if (po < 0) { const char* e = getenv("LD_PS_OUT"); po = 0;
+                    if (e && strchr(e, ':')) { po = 1; po_off = (u32)strtoul(e, NULL, 16); po_expr = strchr(e, ':') + 1; } }
+      if (po && fi > 0 && fp_off == po_off) {
+          char* o = strstr(ps_hlsl, "float4 _o0 = ");
+          if (!o) o = strstr(ps_hlsl, "float4 _o = ");
+          char* semi = o ? strchr(o, ';') : NULL;
+          if (semi) {
+              char rep[512];
+              const int head = (int)(strchr(o, '=') - o) + 2;
+              snprintf(rep, sizeof rep, "%.*sfloat4(%s)", head, o, po_expr);
+              const size_t rl = strlen(rep), old = (size_t)(semi - o), used = strlen(ps_hlsl);
+              if (used - old + rl + 1 <= sizeof(ps_hlsl)) {
+                  memmove(o + rl, semi, used - (size_t)(semi - ps_hlsl) + 1);
+                  memcpy(o, rep, rl);
+                  fprintf(stderr, "[ps-out] fp 0x%08X output -> float4(%s)\n", fp_off, po_expr);
+              }
+          }
+      } }
+    /* LD_HLSL_DUMP=<dir>: files named by the PSO key the draw CSV prints. */
+    { static const char* hd = (const char*)-1;
+      if (hd == (const char*)-1) hd = getenv("LD_HLSL_DUMP");
+      if (hd) {
+        char fn[MAX_PATH]; FILE* f;
+        snprintf(fn, sizeof fn, "%s/hlsl_%016llx.vs.txt", hd, (unsigned long long)live_legacy_pso_key());
+        f = fopen(fn, "wb"); if (f) { fputs(vi > 0 ? vs_hlsl : "<vp fail>", f); fclose(f); }
+        snprintf(fn, sizeof fn, "%s/hlsl_%016llx.ps.txt", hd, (unsigned long long)live_legacy_pso_key());
+        f = fopen(fn, "wb"); if (f) { fputs(fi > 0 ? ps_hlsl : "<fp fail>", f); fclose(f); }
+        /* ...and by fragment-program address: the key hashes the ucode's embedded constants,
+         * so a program with per-frame constants never matches the key a later draw prints. */
+        snprintf(fn, sizeof fn, "%s/hlsl_fp%u_%08X.ps.txt", hd, fp_loc, fp_off);
+        f = fopen(fn, "wb"); if (f) { fputs(fi > 0 ? ps_hlsl : "<fp fail>", f); fclose(f); }
+        snprintf(fn, sizeof fn, "%s/hlsl_fp%u_%08X.vs.txt", hd, fp_loc, fp_off);
+        f = fopen(fn, "wb"); if (f) { fputs(vi > 0 ? vs_hlsl : "<vp fail>", f); fclose(f); }
+      } }
+    if (vi > 0 && fi > 0 && ld_pso_async_on() && ld_pso_needs_compile(vs_hlsl, ps_hlsl)) {   /* fix 62 */
+        ld_pso_job* job = ld_pso_submit(g.n_psos, vs_hlsl, ps_hlsl, &rs, masked_layout, packed_payload);
+        if (job) {
+            g.psos[g.n_psos].key = key;
+            g.psos[g.n_psos].pso = NULL;
+            g.psos[g.n_psos].job = job;
+            *pending = g.n_psos;
+            g.n_psos++;
+            return NULL;
+        }
+    }
+    if (vi > 0 && fi > 0) {
+        g_ld_pso_t_vs = g_ld_pso_t_ps = g_ld_pso_t_create = g_ld_pso_t_disk = 0;
+        const unsigned long long tb = ps3_qpc_us();
+        pso = build_pso(
+            vs_hlsl, ps_hlsl, &rs, masked_layout, packed_payload);
+        { static int on = -1; if (on < 0) on = getenv("LD_PSO_TIME") ? 1 : 0;
+          if (on) fprintf(stderr, "[pso-time] frame %u pso %u: vs compile %.1f ms, ps compile %.1f ms, create %.1f ms\n",
+                          g_ld_frames, g.n_psos, g_ld_pso_t_vs / 1000.0, g_ld_pso_t_ps / 1000.0,
+                          g_ld_pso_t_create / 1000.0); }
+        if (g_ld_pso_t_vs + g_ld_pso_t_ps + g_ld_pso_t_create >= 1000)
+            ps3_perf_note("pso %.1f %.1f %.1f", g_ld_pso_t_vs / 1000.0, g_ld_pso_t_ps / 1000.0,
+                          g_ld_pso_t_create / 1000.0);
+        g_ld_frame_pso_n++;                                  /* psof (fix 62) */
+        g_ld_frame_pso_us += ps3_qpc_us() - tb;
+        g_ld_frame_pso_disk_us += g_ld_pso_t_disk;
+    }
+
+    g.psos[g.n_psos].key = key;
+    g.psos[g.n_psos].pso = pso;
+    g.psos[g.n_psos].job = NULL;
+    g.n_psos++;
+    return pso;
+}
+
+static int ld_upload_pixel_constants(u32* out_offset)
+{
+    if (out_offset)
+        *out_offset = 0;
+    if (!ld_fp_constants_buffered())
+        return 1;
+    if (!g.ps_cb || !g.ps_cb_mapped)
+        return 0;
+
+    /* HLSL uses a one-element placeholder array for programs with no inline
+     * constants so fp_alpha retains a valid 16-byte slot. */
+    const u32 value_slots =
+        g.fp_constants.count ? g.fp_constants.count : 1u;
+    const u32 data_bytes = (value_slots + 1u) * 16u;
+    u32 offset = 0;
+    u32 allocation_bytes = 0;
+    int plan = rsx_fp_constant_ring_plan(
+        g.ps_cb_used, PS_CB_RING_BYTES, data_bytes,
+        &offset, &allocation_bytes);
+    if (plan < 0) {
+#if defined(YZ_PERF_PROFILE)
+        g_ld_profile.total.ps_constant_capacity_failures++;
+#endif
+        return 0;
+    }
+    if (plan == 0) {
+        ld_flush(LD_FLUSH_PIXEL_CONSTANT_RING);
+        if (!g.ready)
+            return 0;
+        g.ps_cb_used = 0;
+        plan = rsx_fp_constant_ring_plan(
+            g.ps_cb_used, PS_CB_RING_BYTES, data_bytes,
+            &offset, &allocation_bytes);
+        if (plan != 1) {
+#if defined(YZ_PERF_PROFILE)
+            g_ld_profile.total.ps_constant_capacity_failures++;
+#endif
+            return 0;
+        }
+    }
+
+#if defined(YZ_PERF_PROFILE)
+    const LONGLONG upload_begin = ld_profile_qpc();
+#endif
+    u8* destination = g.ps_cb_mapped + offset;
+    memset(destination, 0, data_bytes);
+    if (g.fp_constants.count)
+        memcpy(
+            destination, g.fp_constants.values,
+            (size_t)g.fp_constants.count * 16u);
+    memcpy(
+        destination + value_slots * 16u,
+        &g.fp_alpha_ref, sizeof(g.fp_alpha_ref));
+    g.ps_cb_used += allocation_bytes;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.ps_constant_allocations++;
+    g_ld_profile.total.ps_constant_upload_bytes += data_bytes;
+    g_ld_profile.total.ps_constant_upload_qpc +=
+        (u64)(ld_profile_qpc() - upload_begin);
+#endif
+    if (out_offset)
+        *out_offset = offset;
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Draw accumulation sink (mirrors the harness sink)
+ * -----------------------------------------------------------------------*/
+typedef struct { float a[16][4]; } vtx_t;
+typedef struct { u32 first, count; } batch_t;
+/* Packets one draw may queue (Demon's Souls NOTES fix 64). An RSX DRAW_ARRAYS / DRAW_INDEX_ARRAY packet
+ * covers at most 256 vertices or indices, so the old 256 entries capped a draw at 65,536 and dropped
+ * the rest ("qfull" in the stats line): the Storm King arena's large meshes lost whole sections.
+ * 16384 packets = 4M vertices per draw. */
+#define DC_MAX_BATCHES 16384u
+
+typedef struct {
+    /* INLINE_ARRAY source for this primitive, or NULL. The stream is the
+     * vertices themselves, in guest byte order, so the fetch path reads it
+     * with the same big-endian decoders it uses for a vertex array -- only
+     * the base pointer differs. inl_off[i] is attribute i's byte offset
+     * within one inline vertex; the attributes are packed in ascending
+     * index order, which is what makes the offsets derivable at all (an
+     * inline stream carries no per-array offset registers). */
+    const u8* inl; u32 inl_bytes, inl_stride; u32 inl_off[16];
+    batch_t arr[DC_MAX_BATCHES]; u32 n_arr;
+    batch_t idx[DC_MAX_BATCHES]; u32 n_idx;
+    u32     n_packets;
+    vtx_t*  verts; u32 n_verts, cap_verts;
+    rsx_vertex_ref* refs; u32 n_refs, cap_refs;
+    u32     n_source_refs;
+    int     refs_remapped;
+    rsx_vertex_remap ref_remap;
+    u8* compact_verts; u64 compact_capacity;
+    rsx_vertex_layout_plan layout;
+    rsx_vertex_fetch_plan fetch_plan;
+    int     fetch_ok;
+    /* Primitive-restart cut points (s25 port of the replay-harness fix):
+     * a guest index equal to the RSX restart sentinel is a cut marker, not
+     * a vertex reference (RPCS3 RSXThread.cpp:398); fetch_batches records
+     * the n_verts position at each one and the STRIP/FAN expansion must
+     * not bridge across a cut. */
+    u32*    cuts; u32 n_cuts, cap_cuts;
+} draw_ctx;
+
+static draw_ctx dc;
+
+static void dc_reset(void)
+{
+    dc.n_arr = dc.n_idx = dc.n_verts = dc.n_refs = 0;
+    dc.n_source_refs = 0;
+    dc.refs_remapped = 0;
+    dc.n_packets = 0;
+    dc.n_cuts = 0;
+    dc.fetch_ok = 1;
+    dc.inl = NULL; dc.inl_bytes = dc.inl_stride = 0;
+}
+static void push_vert(const vtx_t* v)
+{
+    if (dc.n_verts >= dc.cap_verts) {
+        u32 nc = dc.cap_verts ? dc.cap_verts * 2 : 4096;
+        vtx_t* nv = (vtx_t*)realloc(dc.verts, (size_t)nc * sizeof(vtx_t));
+        if (!nv) { dc.fetch_ok = 0; return; }
+        dc.verts = nv; dc.cap_verts = nc;
+    }
+    dc.verts[dc.n_verts++] = *v;
+}
+
+static void push_compact_ref(u32 vertex_id, u32 base_index)
+{
+    if (dc.n_refs >= dc.cap_refs) {
+        const u32 next_capacity = dc.cap_refs ? dc.cap_refs * 2u : 4096u;
+        rsx_vertex_ref* refs = (rsx_vertex_ref*)realloc(
+            dc.refs, (size_t)next_capacity * sizeof(*refs));
+        if (!refs) {
+            dc.fetch_ok = 0;
+            return;
+        }
+        dc.refs = refs;
+        dc.cap_refs = next_capacity;
+    }
+    dc.refs[dc.n_refs].vertex_id = vertex_id;
+    dc.refs[dc.n_refs].base_index = base_index;
+    dc.n_refs++;
+}
+
+static int reserve_compact_vertices(u64 bytes)
+{
+    if (bytes <= dc.compact_capacity)
+        return 1;
+    if (bytes > SIZE_MAX)
+        return 0;
+    u64 next_capacity = dc.compact_capacity ? dc.compact_capacity : 1u << 20;
+    while (next_capacity < bytes) {
+        if (next_capacity > SIZE_MAX / 2u)
+            return 0;
+        next_capacity *= 2u;
+    }
+    u8* vertices = (u8*)realloc(
+        dc.compact_verts, (size_t)next_capacity);
+    if (!vertices)
+        return 0;
+    dc.compact_verts = vertices;
+    dc.compact_capacity = next_capacity;
+    return 1;
+}
+
+static int reserve_legacy_vertices(u32 count)
+{
+    if (count <= dc.cap_verts)
+        return 1;
+    u32 next_capacity = dc.cap_verts ? dc.cap_verts : 4096u;
+    while (next_capacity < count) {
+        if (next_capacity > UINT32_MAX / 2u)
+            return 0;
+        next_capacity *= 2u;
+    }
+    vtx_t* vertices = (vtx_t*)realloc(
+        dc.verts, (size_t)next_capacity * sizeof(*vertices));
+    if (!vertices)
+        return 0;
+    dc.verts = vertices;
+    dc.cap_verts = next_capacity;
+    return 1;
+}
+
+static float ld_be_f32(const u8* p)
+{
+    const u32 v = ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+                  ((u32)p[2] << 8) | (u32)p[3];
+    float f;
+    memcpy(&f, &v, 4);
+    return f;
+}
+
+static float ld_be_f16(const u8* p)
+{
+    const u16 h = (u16)((p[0] << 8) | p[1]);
+    const u32 sign = (u32)(h >> 15) << 31;
+    const u32 exp = (h >> 10) & 0x1F;
+    const u32 man = h & 0x3FF;
+    u32 out;
+    if (exp == 0)
+        out = sign;
+    else if (exp == 31)
+        out = sign | 0x7F800000u | (man << 13);
+    else
+        out = sign | ((exp + 112) << 23) | (man << 13);
+    float f;
+    memcpy(&f, &out, 4);
+    return f;
+}
+
+static int fetch_attr(u32 i, u32 base, u32 vertex_id, u32 base_index,
+                      float out[4])
+{
+    rsx_dsp_vertex_attr a;
+    rsx_dsp_get_vertex_attr(&g.rsx, i, &a);
+    if (!a.type || !a.size) return 0;
+    out[0] = out[1] = out[2] = 0.0f;
+    out[3] = 1.0f;
+    const u32 elem_size = rsx_vertex_attrib_size(a.type, a.size);
+    const u32 stride = a.stride ? a.stride : elem_size;
+    const u32 divider_mask = rsx_dsp_reg(&g.rsx, 0x1FC0);
+    if (a.frequency >= 2)
+        g_ld_divider_fetches++;
+    const u32 source_element = rsx_vertex_element_index(
+        vertex_id, base_index, a.frequency,
+        (divider_mask >> i) & 1u);
+    const u8* p;
+    if (dc.inl) {
+        /* Inline vertices ignore the array offset and the data base: the
+         * stream IS the array, packed at the declared stride. */
+        const u64 at = (u64)source_element * dc.inl_stride + dc.inl_off[i];
+        if (at + elem_size > dc.inl_bytes) return 0;
+        p = dc.inl + at;
+    } else {
+        p = guest_ptr(
+            a.location,
+            rsx_dsp_resolve_vertex_offset(base, a.offset) + source_element * stride,
+            elem_size);
+    }
+    if (!p) return 0;
+    for (u32 c = 0; c < a.size && c < 4; c++) {
+        switch (a.type) {
+        case RSX_VTX_TYPE_FLOAT:
+            out[c] = ld_be_f32(p + c * 4);
+            break;
+        case RSX_VTX_TYPE_HALF:
+            out[c] = ld_be_f16(p + c * 2);
+            break;
+        case RSX_VTX_TYPE_UNORM8:
+            out[c] = p[c] / 255.0f;
+            break;
+        case RSX_VTX_TYPE_UINT8:
+            out[c] = (float)p[c];
+            break;
+        case RSX_VTX_TYPE_SNORM16: {
+            const s16 v = (s16)((p[c * 2] << 8) | p[c * 2 + 1]);
+            out[c] = rsx_s1_to_float(v);
+            break;
+        }
+        case RSX_VTX_TYPE_SINT16: {
+            const s16 v = (s16)((p[c * 2] << 8) | p[c * 2 + 1]);
+            out[c] = (float)v;
+            break;
+        }
+        case RSX_VTX_TYPE_CMP32: {
+            const u32 w = ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+                          ((u32)p[2] << 8) | (u32)p[3];
+            s32 x = (s32)(w & 0x7FF);          if (x & 0x400) x -= 0x800;
+            s32 y = (s32)((w >> 11) & 0x7FF); if (y & 0x400) y -= 0x800;
+            s32 z = (s32)((w >> 22) & 0x3FF); if (z & 0x200) z -= 0x400;
+            out[0] = (float)x / 1023.0f;
+            out[1] = (float)y / 1023.0f;
+            out[2] = (float)z / 511.0f;
+            out[3] = 1.0f;
+            return 1;
+        }
+        default:
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static void fetch_one(u32 base, u32 vertex_id, u32 base_index)
+{
+    vtx_t v;
+    for (u32 i = 0; i < 16; i++) {
+        rsx_dsp_vertex_attr a;
+        rsx_dsp_get_vertex_attr(&g.rsx, i, &a);
+        if (a.type && a.size &&
+            fetch_attr(i, base, vertex_id, base_index, v.a[i])) continue;
+        if (i == 0) { dc.fetch_ok = 0; return; }
+        rsx_dsp_vertex_default(&g.rsx, i, v.a[i]);
+        if (i == 3 && v.a[3][0] == 0 && v.a[3][1] == 0 && v.a[3][2] == 0 && v.a[3][3] == 1)
+            v.a[3][0] = v.a[3][1] = v.a[3][2] = 1.0f;
+    }
+    push_vert(&v);
+}
+
+static void fetch_batches(void)
+{
+    const u32 base = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    for (u32 r = 0; r < dc.n_arr && dc.fetch_ok; r++)
+        for (u32 i = 0; i < dc.arr[r].count && dc.fetch_ok; i++)
+            fetch_one(base, dc.arr[r].first + i, 0);
+    if (!dc.n_idx) return;
+    const u32 base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+    rsx_dsp_index_array ia; rsx_dsp_get_index_array(&g.rsx, &ia);
+    /* Restart sentinel handling, same rule as the replay harness (RPCS3
+     * RSXThread.cpp:398 "if (value == restart) continue" + rsx_methods.h
+     * restart_index_enabled()/restart_index()): record a cut, never fetch
+     * the phantom vertex. Kill-switch RSX_NO_RESTART shared with the
+     * harness for byte-exact A/B. */
+    static int s_no_restart = -1;
+    if (s_no_restart < 0) s_no_restart = getenv("RSX_NO_RESTART") ? 1 : 0;
+    const int restart_en = !s_no_restart && rsx_dsp_restart_index_enabled(&g.rsx, ia.is_u32);
+    const u32 restart_val = rsx_dsp_restart_index(&g.rsx);
+    for (u32 r = 0; r < dc.n_idx && dc.fetch_ok; r++)
+        for (u32 i = 0; i < dc.idx[r].count && dc.fetch_ok; i++) {
+            const u32 esz = ia.is_u32 ? 4 : 2;
+            const u8* ip = guest_ptr(ia.location, ia.offset + (dc.idx[r].first + i) * esz, esz);
+            if (!ip) { dc.fetch_ok = 0; return; }
+            const u32 index = ia.is_u32
+                ? (((u32)ip[0] << 24) | ((u32)ip[1] << 16) | ((u32)ip[2] << 8) | ip[3])
+                : (u32)((ip[0] << 8) | ip[1]);
+            if (restart_en && index == restart_val) {
+                if (!rsx_restart_cut_push(&dc.cuts, &dc.n_cuts, &dc.cap_cuts,
+                                          dc.n_verts)) {
+                    dc.fetch_ok = 0;
+                    return;
+                }
+                continue;
+            }
+            fetch_one(base, index, base_index);
+        }
+}
+
+static void fetch_batches_hoisted(
+    const rsx_vertex_layout_plan* layout, int packed_payload)
+{
+    for (u32 batch = 0; batch < dc.n_arr && dc.fetch_ok; batch++)
+        for (u32 i = 0; i < dc.arr[batch].count && dc.fetch_ok; i++)
+            push_compact_ref(dc.arr[batch].first + i, 0);
+
+    if (dc.n_idx && dc.fetch_ok) {
+        const u32 base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+        rsx_dsp_index_array index_array;
+        rsx_dsp_get_index_array(&g.rsx, &index_array);
+        const u32 element_size = index_array.is_u32 ? 4u : 2u;
+        static int no_restart = -1;
+        if (no_restart < 0)
+            no_restart = getenv("RSX_NO_RESTART") ? 1 : 0;
+        const int restart_enabled =
+            !no_restart &&
+            rsx_dsp_restart_index_enabled(&g.rsx, index_array.is_u32);
+        const u32 restart_value = rsx_dsp_restart_index(&g.rsx);
+
+        for (u32 batch = 0; batch < dc.n_idx && dc.fetch_ok; batch++) {
+            const u32 first = dc.idx[batch].first;
+            const u32 count = dc.idx[batch].count;
+            const u64 start64 =
+                (u64)index_array.offset + (u64)first * element_size;
+            const u64 bytes64 = (u64)count * element_size;
+            const u8* contiguous = NULL;
+            if (count && start64 <= UINT32_MAX &&
+                bytes64 <= UINT32_MAX &&
+                start64 + bytes64 <= 0x100000000ull) {
+                contiguous = guest_ptr(
+                    index_array.location, (u32)start64, (u32)bytes64);
+            }
+            for (u32 i = 0; i < count && dc.fetch_ok; i++) {
+                const u32 source_offset =
+                    index_array.offset + (first + i) * element_size;
+                const u8* source = contiguous
+                    ? contiguous + (size_t)i * element_size
+                    : guest_ptr(
+                        index_array.location, source_offset, element_size);
+                if (!source) {
+                    dc.fetch_ok = 0;
+                    break;
+                }
+                const u32 index = index_array.is_u32
+                    ? (((u32)source[0] << 24) |
+                       ((u32)source[1] << 16) |
+                       ((u32)source[2] << 8) | source[3])
+                    : (u32)((source[0] << 8) | source[1]);
+                if (restart_enabled && index == restart_value) {
+                    if (!rsx_restart_cut_push(
+                            &dc.cuts, &dc.n_cuts, &dc.cap_cuts,
+                            dc.n_refs)) {
+                        dc.fetch_ok = 0;
+                        break;
+                    }
+                    continue;
+                }
+                push_compact_ref(index, base_index);
+            }
+        }
+    }
+
+    if (!dc.fetch_ok)
+        return;
+    dc.n_source_refs = dc.n_refs;
+    if (packed_payload && dc.n_refs > 1) {
+        u32 unique_refs = dc.n_refs;
+        if (rsx_vertex_remap_build(
+                &dc.ref_remap, dc.refs, dc.n_refs, &unique_refs)) {
+            dc.refs_remapped = unique_refs < dc.n_refs;
+            dc.n_refs = unique_refs;
+        }
+    }
+    dc.layout = *layout;
+    rsx_vertex_fetch_plan_init(
+        &dc.fetch_plan, &g.rsx, layout,
+        (rsx_vertex_guest_ptr_fn)g.guest_ptr, g.guest_user);
+    rsx_vertex_fetch_plan_set_inline(&dc.fetch_plan, &g.rsx, dc.inl, dc.inl_bytes);
+    rsx_vertex_fetch_plan_prepare(&dc.fetch_plan, dc.refs, dc.n_refs);
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        const u32 attr = layout->attrs[slot];
+        if (dc.fetch_plan.attr[attr].desc.frequency >= 2)
+            g_ld_divider_fetches += dc.n_refs;
+    }
+    if (packed_payload) {
+        const u64 required = (u64)dc.n_refs * layout->stride;
+        if (!reserve_compact_vertices(required)) {
+            dc.fetch_ok = 0;
+            return;
+        }
+        /* Attribute-major loops (same bytes as rsx_vertex_fetch_one per
+         * vertex, see tests/test_vertex_fetch_plan.c). */
+        if (!rsx_vertex_fetch_many(&dc.fetch_plan, dc.refs, dc.n_refs,
+                                   dc.compact_verts)) {
+            dc.fetch_ok = 0;
+            return;
+        }
+    } else {
+        /*
+         * H and M deliberately retain the complete legacy payload.  With an
+         * all-attribute layout, slot order is register order, so the helper
+         * writes exactly the original attribute*16 byte offsets.
+         */
+        if (!reserve_legacy_vertices(dc.n_refs)) {
+            dc.fetch_ok = 0;
+            return;
+        }
+        /* Legacy treats an absent ATTR0 as a failed group, even though other
+         * absent attributes use their RSX current/default value. */
+        if (dc.n_refs &&
+            (!dc.fetch_plan.attr[0].desc.type ||
+             !dc.fetch_plan.attr[0].desc.size)) {
+            dc.fetch_ok = 0;
+            return;
+        }
+        for (u32 i = 0; i < dc.n_refs; i++) {
+            if (!rsx_vertex_fetch_one(
+                    &dc.fetch_plan, &dc.refs[i],
+                    (u8*)&dc.verts[i])) {
+                dc.fetch_ok = 0;
+                return;
+            }
+        }
+    }
+    dc.n_verts = dc.n_refs;
+}
+
+static const float* dc_vertex_attr(
+    u32 vertex, u32 attr, float fallback[4])
+{
+    if (!ld_vertex_compact_payload())
+        return dc.verts[vertex].a[attr];
+    const s8 slot = dc.layout.slot_by_attr[attr];
+    if (slot >= 0 && vertex < dc.n_verts)
+        return (const float*)(
+            dc.compact_verts + (u64)vertex * dc.layout.stride +
+            (u32)slot * 16u);
+    memcpy(fallback, dc.fetch_plan.attr[attr].default_value, 16);
+    return fallback;
+}
+
+/* Diagnostic-only counterpart to dc_vertex_attr().  Compact rendering omits
+ * attributes the active vertex program does not read, but the legacy replay
+ * fingerprint contains all sixteen RSX attributes.  Re-fetch an omitted,
+ * enabled attribute from the original guest reference so a CSV hash compares
+ * the producer bytes rather than the two renderers' different upload layouts. */
+static const float* dc_vertex_attr_canonical(
+    u32 vertex, u32 attr, float fallback[4])
+{
+    if (!ld_vertex_compact_payload())
+        return dc.verts[vertex].a[attr];
+    const s8 slot = dc.layout.slot_by_attr[attr];
+    if (slot >= 0 && vertex < dc.n_verts)
+        return (const float*)(
+            dc.compact_verts + (u64)vertex * dc.layout.stride +
+            (u32)slot * 16u);
+
+    const rsx_vertex_fetch_attr* fetch = &dc.fetch_plan.attr[attr];
+    if (vertex < dc.n_verts && fetch->desc.type && fetch->desc.size &&
+        fetch->elem_size) {
+        const rsx_vertex_ref* ref = &dc.refs[vertex];
+        const u32 element = rsx_vertex_element_index(
+            ref->vertex_id, ref->base_index, fetch->desc.frequency,
+            (dc.fetch_plan.divider_mask >> attr) & 1u);
+        const u64 offset =
+            (u64)rsx_dsp_resolve_vertex_offset(dc.fetch_plan.base_offset,
+                                               fetch->desc.offset) +
+            (u64)element * fetch->stride;
+        if (offset <= UINT32_MAX) {
+            const u8* source = guest_ptr(
+                fetch->desc.location, (u32)offset, fetch->elem_size);
+            if (source && rsx_vertex_decode_element(
+                    fetch->desc.type, fetch->desc.size,
+                    source, fallback))
+                return fallback;
+        }
+    }
+    memcpy(fallback, fetch->default_value, 16);
+    return fallback;
+}
+
+/* primitive ids = raw NV4097 VERTEX_BEGIN_END arg (rsx_dispatch stores it raw;
+ * matches the replay harness). These were off by one (4/5/6/7), which dropped
+ * EVERY quad/triangle draw through the switch's default: return -> black. */
+#define PRIM_TRIANGLES       5
+#define PRIM_TRIANGLE_STRIP  6
+#define PRIM_TRIANGLE_FAN    7
+#define PRIM_QUADS           8
+
+/* Live-draw activity counters (verification: is real geometry flowing, or only
+ * clears?). Reported per presented frame in rsx_live_draw_present. */
+/* DRAW_ARRAYS/DRAW_INDEX_ARRAY writes are packets. Multiple packets between a
+ * single BEGIN/END are deliberately coalesced into one D3D12 DrawInstanced,
+ * so comparing packet count directly with executed D3D draws was invalid.
+ * Keep two independently balanced ledgers instead:
+ *
+ *   packets_seen = packets_queued + packets_movie + packets_queue_full
+ *   groups_seen  = groups_executed + every group_drop_* outcome
+ *
+ * An END with no accepted packet is counted separately as groups_empty and is
+ * not a render attempt. This makes every early return explicit. */
+typedef struct ld_stats {
+    unsigned long long packets_seen;
+    unsigned long long packets_queued;
+    unsigned long long packets_movie;
+    unsigned long long packets_queue_full;
+    unsigned long long groups_seen;
+    unsigned long long groups_empty;
+    unsigned long long groups_executed;
+    unsigned long long group_drop_fetch;
+    unsigned long long group_drop_degenerate;
+    unsigned long long group_drop_primitive;
+    unsigned long long group_drop_alloc;
+    unsigned long long group_drop_pso;
+    unsigned long long group_drop_ring;
+    unsigned long long group_drop_surface;
+    unsigned long long clears;
+    unsigned long long clear_drop_surface;
+    unsigned long long implicit_depth_clears;
+} ld_stats;
+
+static ld_stats g_ld_stats;
+
+void rsx_live_draw_a010_probe_begin(void)
+{
+    if ((!getenv("RSX_A010_PROBE") &&
+         !getenv("RSX_A010_SURFACE_DUMP")) || !g.ready)
+        return;
+    /*
+     * Targeted surface readbacks submit and fence the open D3D12 list. When
+     * surface capture alone is requested, defer that cost until AUTH confirms
+     * that both the character palette and verified camera are synchronized.
+     * Explicit RSX_A010_PROBE retains its scene-open diagnostic behavior.
+     */
+    if (!getenv("RSX_A010_PROBE") &&
+        InterlockedCompareExchange(
+            &g_yz_a010_reference_camera_active, 0, 0) == 0)
+        return;
+    if (g_yz_runtime_config.a010_start_reference) {
+        /* Deterministic visual-verification camera derived from the shipped
+         * cam_Came_000_002.cmt frame 612. Install it on the RSX thread as soon
+         * as the a010 probe opens so a later blocked PPU scene update cannot
+         * prevent the reference matrix from reaching the first world draws. */
+        static const float reference_matrix_612[16] = {
+             3.18890834f,   -0.000270011135f,  0.08452246f,   5.81511511f,
+            -0.0102274104f,  5.65674844f,      0.403935942f, -18.5085361f,
+             0.0264371686f,  0.0712562195f,   -0.997207931f,  9.99292802f,
+             0.0264345249f,  0.0712490938f,   -0.99710821f,  10.0919287f,
+        };
+        static const float reference_matrix_874[16] = {
+             6.80647601f,   -0.00327668415f,  0.611324803f, -36.9135075f,
+             0.00523179535f, 12.1491076f,     0.00686819648f, -38.8146474f,
+             0.0894642733f,  0.000524588748f,-0.996090306f, -11.7467763f,
+             0.0894553268f,  0.000524536289f,-0.995990697f, -11.6456016f,
+        };
+        const float* reference_matrix =
+            g_yz_runtime_config.a010_reference_874
+                ? reference_matrix_874 : reference_matrix_612;
+        rsx_live_draw_set_a010_camera_matrix(reference_matrix);
+    }
+    CreateDirectoryA("scratch\\a010_probe", NULL);
+    g_ld_a010_probe_start_frame = g_ld_frames;
+    g_ld_a010_probe_sample = 0;
+    g_ld_a010_probe_touched = 0;
+    InterlockedExchange(&g_ld_a010_world_ready, 0);
+    InterlockedExchange(&g_ld_a010_probe_active, 1);
+    fprintf(stderr,
+            "[a010-probe] BEGIN live_frame=%u surfaces=%u packets=%llu groups=%llu\n",
+            g_ld_frames, g.n_surfaces, g_ld_stats.packets_seen,
+            g_ld_stats.groups_seen);
+    fflush(stderr);
+}
+
+int rsx_live_draw_a010_probe_active(void)
+{
+    return InterlockedCompareExchange(&g_ld_a010_probe_active, 0, 0) != 0;
+}
+
+int rsx_live_draw_a010_world_ready(void)
+{
+    return InterlockedCompareExchange(&g_ld_a010_world_ready, 0, 0) != 0;
+}
+
+static unsigned long long ld_groups_accounted(void)
+{
+    return g_ld_stats.groups_executed + g_ld_stats.group_drop_fetch +
+           g_ld_stats.group_drop_degenerate + g_ld_stats.group_drop_primitive +
+           g_ld_stats.group_drop_alloc + g_ld_stats.group_drop_pso +
+           g_ld_stats.group_drop_ring + g_ld_stats.group_drop_surface;
+}
+
+#if defined(YZ_PERF_PROFILE)
+static double ld_profile_ticks_ms(u64 ticks)
+{
+    return g_ld_profile.qpc_frequency
+        ? (double)ticks * 1000.0 / (double)g_ld_profile.qpc_frequency
+        : 0.0;
+}
+
+static void ld_profile_present(u32 frame)
+{
+    const LONGLONG now = ld_profile_qpc();
+    const double frame_ms = ld_profile_ticks_ms(
+        (u64)(now - g_ld_profile.previous_present_qpc));
+    const ld_profile_counts* total = &g_ld_profile.total;
+    const ld_profile_counts* previous = &g_ld_profile.previous;
+#define LD_PROFILE_DELTA(field) (total->field - previous->field)
+    const u64 packets =
+        g_ld_stats.packets_seen - g_ld_profile.previous_packets;
+    const u64 groups =
+        g_ld_stats.groups_seen - g_ld_profile.previous_groups;
+    const u64 executed =
+        g_ld_stats.groups_executed - g_ld_profile.previous_executed;
+    const u64 evictions =
+        g_ld_texture_cache_evictions - g_ld_profile.previous_evictions;
+    const u64 refreshes =
+        g_ld_vtex_refreshes - g_ld_profile.previous_refreshes;
+    const u64 used_attribute_draws =
+        LD_PROFILE_DELTA(used_attribute_draws);
+    const double used_attribute_average = used_attribute_draws
+        ? (double)LD_PROFILE_DELTA(used_attribute_sum) /
+              (double)used_attribute_draws
+        : 0.0;
+    const int compile_free =
+        LD_PROFILE_DELTA(vs_compile_calls) == 0 &&
+        LD_PROFILE_DELTA(ps_compile_calls) == 0;
+    g_ld_profile.measured_frames++;
+    g_ld_profile.total_frame_ms += frame_ms;
+    if (compile_free) {
+        g_ld_profile.compile_free_frames++;
+        g_ld_profile.compile_free_frame_ms += frame_ms;
+    }
+    /*
+     * The two matched visual-validation windows are deliberately small.
