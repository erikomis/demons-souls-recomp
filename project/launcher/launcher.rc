// The manifest turns on the modern control look (Common Controls 6) and system DPI awareness.
1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Demon's Souls PC port launcher"
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "DemonsSoulsLauncher"
      VALUE "OriginalFilename", "DemonsSoulsLauncher.exe"
      VALUE "ProductName", "Demon's Souls PC port (ps3recomp)"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
