{
  "name": "demons-souls-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "release": "tauri build && python3 scripts/check_bundle.py \"src-tauri/target/release/bundle/macos/Demon's Souls Launcher.app\" src-tauri/target/release/bundle/dmg/*.dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
