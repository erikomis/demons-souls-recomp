# Patches are applied byte for byte; never let git convert their line endings.
*.patch -text
# Batch files are stored with CRLF: cmd.exe mis-parses labels in LF batch files.
*.bat   -text
*.py    text eol=lf
*.md    text eol=lf
# Linux scripts (linux/): LF, or sh reads "\r" as part of every command
*.sh    text eol=lf
*.cmake text eol=lf
*.yml   text eol=lf
linux/appimage/AppRun text eol=lf
